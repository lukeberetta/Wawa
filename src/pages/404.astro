---
import Layout from '@/layouts/Layout.astro';

// Cloudflare serves this with a real 404 status. Without it, a missing URL
// fell back to the homepage with a 200 — a soft 404 that search engines index.
---

<Layout title="Page not found · Wawa Surfboards" description="That page has washed away.">
  <section class="nf">
    <div class="wrap">
      <p class="label">404</p>
      <h1>That page has washed away.</h1>
      <p class="nf-lead">The link may be old, or the page has moved. Try the shop, or get in touch.</p>
      <div class="nf-links">
        <a href="/products" class="link-arrow">Browse the range <span aria-hidden="true">→</span></a>
        <a href="/contact" class="link-arrow">Contact us <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: calc(var(--bar-h) + var(--space-2xl)) 0 var(--space-2xl);
  }
  .nf h1 {
    margin-top: var(--space-md);
  }
  .nf-lead {
    margin-top: var(--space-md);
    max-width: 32rem;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
</style>
