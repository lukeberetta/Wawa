---
import Layout from '@/layouts/Layout.astro';
import { site, whatsappLink } from '@/lib/site';
import { ORG_ID, breadcrumbs } from '@/lib/schema';

const wa = whatsappLink('Hi Wawa, I’d like to talk about a board.');

// One-line address, so the workshop's NAP details read the same on the page as
// they do in the LocalBusiness markup — Google cross-checks the two.
const { street, locality, region, postalCode } = site.address;
const addressLine = `${street}, ${locality}, ${region}, ${postalCode}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.name}, ${addressLine}`,
)}`;

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Contact Wawa Surfboards',
    mainEntity: { '@id': ORG_ID },
  },
  breadcrumbs([{ name: 'Contact' }]),
];
---

<Layout
  title="Contact · Wawa Surfboards"
  description="Talk to the Wawa workshop about a custom wooden board. 166-168 Main Rd, Muizenberg, Cape Town — WhatsApp, email or knock on the door."
  current="contact"
  schema={schema}
>
  <header class="page-header">
    <div class="wrap">
      <p class="label fade-in">Contact</p>
      <h1 class="fade-in">Let’s shape<br />something.</h1>
      <p class="page-header-sub fade-in">
        Every board starts with a conversation. Tell us your style, your break and your experience,
        and we’ll shape the rest.
      </p>

      <div class="actions fade-in">
        <a class="btn" href={wa} target="_blank" rel="noopener noreferrer">Message on WhatsApp <span class="arrow">→</span></a>
        <a class="btn ghost" href="mailto:surfboards@wawawave.com">Email us <span class="arrow">→</span></a>
      </div>

    </div>
  </header>

  <!-- OPENING TIMES — a photographic band rather than a panel: the door is the
       thing you're being told to walk through. Same scrim + cream type as the
       page heroes, at a shorter height since it carries a list, not a display
       line. -->
  <section id="hours" class="grain">
    <img
      class="hours-img"
      src="/img/contact/workshop-door.webp"
      alt=""
      width={2200}
      height={1650}
      loading="lazy"
      decoding="async"
    />
    <div class="wrap">
      <div class="hours-content fade-in">
        <p class="label">Visit</p>
        <h2>Come by the workshop.</h2>
        <p class="hours-lead">
          Coffee’s on and the boards are on the racks. Drop in for a closer look, or just a chat.
        </p>

        <dl class="hours-list">
          <div class="hours-row">
            <dt>Where</dt>
            <dd>{street}<br />{locality}, {region}, {postalCode}</dd>
          </div>
          {site.hoursConfirmed ? (
            site.hours.map((h) => (
              <div class="hours-row">
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          ) : (
            <div class="hours-row">
              <dt>When</dt>
              <dd>Hours vary — message us before you come.</dd>
            </div>
          )}
        </dl>

        <div class="hours-actions">
          <a class="hours-btn" href={mapLink} target="_blank" rel="noopener noreferrer">
            Get directions <span aria-hidden="true">→</span>
          </a>
          <a class="hours-btn ghost" href={wa} target="_blank" rel="noopener noreferrer">
            WhatsApp us <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: calc(var(--nav-h) + 6rem) 0 6rem;
  }
  .page-header h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin: 1rem 0;
  }
  .page-header-sub {
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  /* mobile-first: the two actions stack full-width, so each is a whole thumb
     target rather than a short pill floating on a wide row */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.6rem;
    background: var(--ink);
    color: var(--cream);
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--ink);
    transition: opacity 0.25s;
  }
  .btn:hover {
    opacity: 0.85;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule);
  }
  /* after the .btn rules, not before — a media query adds no specificity, so
     `width: auto` only wins if it comes later in the sheet */
  @media (min-width: 600px) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .btn {
      width: auto;
    }
  }
  /* ── Opening times ── full-bleed photographic band ── */
  #hours {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(600px, 90vh, 920px);
    min-height: clamp(600px, 90svh, 920px);
    padding: var(--space-3xl) 0;
    background: var(--ink);
    color: var(--cream);
  }
  .hours-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* mirrored so the door sits opposite the copy instead of behind it */
    transform: scaleX(-1);
  }
  /* same two-stop wash the heroes use, so cream type holds over any frame */
  #hours::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(26, 20, 16, 0.55), rgba(26, 20, 16, 0.66));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 45%, transparent),
      color-mix(in srgb, var(--ink) 62%, transparent)
    );
  }
  #hours .wrap {
    position: relative;
    z-index: 2;
  }
  #hours .label {
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }
  #hours h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0.75rem 0 1rem;
  }
  /* film grain over photo + wash, under the copy — matches the heroes */
  #hours.grain::after {
    z-index: 1;
    --grain-opacity: 0.2;
  }
  .hours-lead {
    max-width: 38ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: color-mix(in srgb, var(--cream) 85%, transparent);
  }
  /* Where / When (or the confirmed hours): label left, detail right, hairline
     rules between — the one block someone is scanning for */
  .hours-list {
    max-width: 30rem;
    margin-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-sm);
    padding: 0.9rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row dt {
    padding-top: 0.2em;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .hours-row dd {
    line-height: 1.4;
    /* tabular figures keep the times aligned down the column */
    font-variant-numeric: tabular-nums;
  }
  .hours-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  /* cream-on-photo versions of the page's .btn pair */
  .hours-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--cream);
    transition: gap 0.3s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .hours-btn:hover {
    gap: 0.85rem;
  }
  .hours-btn.ghost {
    color: var(--cream);
    background: transparent;
    border-color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .hours-btn.ghost:hover {
    border-color: var(--cream);
  }
  @media (max-width: 520px) {
    .hours-row {
      grid-template-columns: 7.5rem 1fr;
    }
    .hours-btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
