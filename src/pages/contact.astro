---
import Layout from '@/layouts/Layout.astro';
import { site, whatsappLink } from '@/lib/site';
import { ORG_ID, breadcrumbs } from '@/lib/schema';

const wa = whatsappLink('Hi Wawa, I’d like to talk about a board.');

// One-line address, so the workshop's NAP details read the same on the page as
// they do in the LocalBusiness markup — Google cross-checks the two.
const { street, locality, region, postalCode } = site.address;
const addressLine = `${street}, ${locality}, ${region}, ${postalCode}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.name}, ${addressLine}`,
)}`;

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Contact Wawa Surfboards',
    mainEntity: { '@id': ORG_ID },
  },
  breadcrumbs([{ name: 'Contact' }]),
];
---

<Layout
  title="Contact · Wawa Surfboards"
  description="Talk to the Wawa workshop about a custom wooden board. 166-168 Main Rd, Muizenberg, Cape Town — WhatsApp, email or knock on the door."
  current="contact"
  schema={schema}
>
  <header class="page-header">
    <div class="wrap">
      <p class="label fade-in">Contact</p>
      <h1 class="fade-in">Let’s shape<br />something.</h1>
      <p class="page-header-sub fade-in">
        Every board starts with a conversation. Tell us your style, your break and your experience,
        and we’ll shape the rest. Based in {site.location}.
      </p>

      <div class="actions fade-in">
        <a class="btn" href={wa} target="_blank" rel="noopener noreferrer">Message on WhatsApp <span class="arrow">→</span></a>
        <a class="btn ghost" href="mailto:surfboards@wawawave.com">Email us <span class="arrow">→</span></a>
      </div>

    </div>
  </header>

  <!-- OPENING TIMES — a photographic band rather than a panel: the door is the
       thing you're being told to walk through. Same scrim + cream type as the
       page heroes, at a shorter height since it carries a list, not a display
       line. -->
  <section id="hours">
    <img
      class="hours-img"
      src="/img/contact/workshop-door.webp"
      alt=""
      width={2200}
      height={1650}
      loading="lazy"
      decoding="async"
    />
    <div class="wrap">
      <div class="hours-content fade-in">
        <p class="label">Visit</p>
        <h2>Opening times.</h2>
        <dl class="hours-list">
          {
            site.hours.map((h) => (
              <div class="hours-row">
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="hours-note">
          <a class="hours-address" href={mapLink}>{addressLine}</a>. The workshop runs through the
          day — knock if the coffee is on.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: calc(var(--nav-h) + 6rem) 0 6rem;
  }
  .page-header h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin: 1rem 0;
  }
  .page-header-sub {
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  /* mobile-first: the two actions stack full-width, so each is a whole thumb
     target rather than a short pill floating on a wide row */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.6rem;
    background: var(--ink);
    color: var(--cream);
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--ink);
    transition: opacity 0.25s;
  }
  .btn:hover {
    opacity: 0.85;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule);
  }
  /* after the .btn rules, not before — a media query adds no specificity, so
     `width: auto` only wins if it comes later in the sheet */
  @media (min-width: 600px) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .btn {
      width: auto;
    }
  }
  /* ── Opening times ── full-bleed photographic band ── */
  #hours {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(420px, 60vh, 620px);
    padding: var(--space-2xl) 0;
    background: var(--ink);
    color: var(--cream);
  }
  .hours-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* mirrored so the door sits opposite the copy instead of behind it */
    transform: scaleX(-1);
  }
  /* same two-stop wash the heroes use, so cream type holds over any frame */
  #hours::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(26, 20, 16, 0.55), rgba(26, 20, 16, 0.66));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 45%, transparent),
      color-mix(in srgb, var(--ink) 62%, transparent)
    );
  }
  #hours .wrap {
    position: relative;
    z-index: 2;
  }
  #hours .label {
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }
  #hours h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0.75rem 0 2rem;
  }
  .hours-list {
    /* the measure is the list, not the column: days and times sit on the two
       edges of a narrow block so the times read as a column of their own */
    max-width: 26rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row dd {
    /* tabular figures keep the times aligned down the column */
    font-variant-numeric: tabular-nums;
  }
  .hours-note {
    margin-top: 1.5rem;
    max-width: 34ch;
    font-size: var(--fs-caption);
    color: color-mix(in srgb, var(--cream) 75%, transparent);
  }
  /* The address sits at full cream against the dimmed note around it — it's the
     one line on the page someone is hunting for. */
  .hours-address {
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--cream) 45%, transparent);
  }
  .hours-address:hover {
    text-decoration-color: var(--cream);
  }
</style>
