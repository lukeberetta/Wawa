---
import Layout from '@/layouts/Layout.astro';
import { site, whatsappLink } from '@/lib/site';
import { ORG_ID, breadcrumbs } from '@/lib/schema';

const wa = whatsappLink('Hi Wawa, I’d like to talk about a board.');

// One-line address, so the workshop's NAP details read the same on the page as
// they do in the LocalBusiness markup — Google cross-checks the two.
const { street, locality, region, postalCode } = site.address;
const addressLine = `${street}, ${locality}, ${region}, ${postalCode}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.name}, ${addressLine}`,
)}`;

// FAQ — one array feeds both the <details> list and the FAQPage schema.
// Answers are HTML (a few links); the schema gets them with tags stripped.
// Drafted from what's on record; TODO(Cobus) marks what he needs to confirm.
const policy = (handle: string) => `https://${site.shopDomain}/policies/${handle}`;
const faqs: { q: string; a: string }[] = [
  {
    q: 'How does ordering a custom board work?',
    a: `It starts with a conversation, on <a href="${wa}" target="_blank" rel="noopener noreferrer">WhatsApp</a>, by <a href="mailto:${site.email}">email</a> or at the workshop. Tell us your weight, the waves you ride and how long you’ve been surfing, and we’ll shape the rest. The Enquire button on any board page gets it going.`,
  },
  {
    // TODO(Cobus): lead time in weeks, and whether a deposit is taken.
    q: 'How long does a board take?',
    a: 'Every board is built to order by hand, so it depends on what’s on the racks. Ask us for the current lead time.',
  },
  {
    q: 'Can I buy something off the rack?',
    a: 'Accessories, skateboards, paipos, handslides, alaias and bodyboards sell <a href="/products">online</a>. Surfboards and foils are built to order, though a finished board at the workshop may be looking for a home.',
  },
  {
    q: 'What are the boards made of?',
    a: 'Paulownia and cork over an EPS core. Light, strong, and made to last years rather than a few seasons.',
  },
  {
    q: 'What size should I get?',
    a: 'Each board page lists the dimensions of one we’ve built. Yours is sized to your weight, your experience and your break, so talk to us before you settle on a number.',
  },
  {
    // TODO(Cobus): how boards ship and what it costs — Shopify rates stop at 10 kg.
    q: 'Do you ship?',
    a: `Yes. Within South Africa by Courier Guy and worldwide by DHL Express, or collect your online order from the workshop for free. See the <a href="${policy('shipping-policy')}" target="_blank" rel="noopener noreferrer">shipping policy</a>.`,
  },
  {
    q: 'Can I return something?',
    a: `Online orders can be returned within 30 days; see the <a href="${policy('refund-policy')}" target="_blank" rel="noopener noreferrer">returns policy</a>. Custom boards are made for you, so if something’s not right, talk to us. Gift cards aren’t refundable, but you can pass them on.`,
  },
  {
    // TODO(Cobus): care for the glassed paulownia boards — the oiling below is
    // from the 2012 notes and fits raw timber (alaia, paipo, handslide) only.
    q: 'How do I look after a wooden board?',
    a: 'Not much is needed. Smooth any rough spots with 400-grit sandpaper. Re-oil solid-timber craft (alaias, paipos, handslides) with two coats of linseed oil and mineral spirits mixed 1:1. Fill dings with wood glue mixed with sawdust, or resin. Or bring it in and we’ll help.',
  },
  {
    q: 'Can I visit the workshop?',
    a: `Yes. We’re at ${street}, ${locality}, and the coffee’s on. <a href="#hours">Opening hours</a> are below.`,
  },
];
const plain = (html: string) => html.replace(/<[^>]+>/g, '');

const schema = [
  {
    '@type': 'ContactPage',
    name: 'Contact Wawa Surfboards',
    mainEntity: { '@id': ORG_ID },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
    })),
  },
  breadcrumbs([{ name: 'Contact' }]),
];
---

<Layout
  title="Contact · Wawa Surfboards"
  description="Talk to the Wawa workshop about a custom wooden board: lead times, sizing, shipping and care. 166-168 Main Rd, Muizenberg, Cape Town — WhatsApp, email or knock on the door."
  current="contact"
  schema={schema}
>
  <header class="page-header">
    <div class="wrap">
      <p class="label">Contact</p>
      <h1>Let’s shape<br />something.</h1>
      <p class="page-header-sub">
        Every board starts with a conversation. Tell us your style, your break and your experience,
        and we’ll shape the rest.
      </p>

      <div class="actions">
        <a class="btn" href={wa} target="_blank" rel="noopener noreferrer">Message on WhatsApp <span class="arrow">→</span></a>
        <a class="btn ghost" href="mailto:surfboards@wawawave.com">Email us <span class="arrow">→</span></a>
      </div>

    </div>
  </header>

  <!-- FAQ — native <details>, no script. Same hairline-row pattern as the
       order modal's optional sections. -->
  <section id="faq" class="grain">
    <div class="wrap faq-grid">
      <div class="faq-head">
        <p class="label">Questions</p>
        <h2>Before you ask.</h2>
      </div>
      <div class="faq-body">
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p class="faq-a" set:html={f.a} />
          </details>
        ))}
      </div>
      <p class="faq-more">
        Still wondering? <a href={wa} target="_blank" rel="noopener noreferrer">Message us <span aria-hidden="true">→</span></a>
      </p>
      </div>
    </div>
  </section>

  <!-- OPENING TIMES — a photographic band rather than a panel: the door is the
       thing you're being told to walk through. Same scrim + cream type as the
       page heroes, at a shorter height since it carries a list, not a display
       line. -->
  <section id="hours" class="grain">
    <img
      class="hours-img"
      src="/img/contact/workshop-door.webp"
      alt=""
      width={2200}
      height={1650}
      loading="lazy"
      decoding="async"
    />
    <div class="wrap">
      <div class="hours-content">
        <p class="label">Visit</p>
        <h2>Come by the workshop.</h2>
        <p class="hours-lead">
          Coffee’s on and the boards are on the racks. Drop in for a closer look, or just a chat.
        </p>

        <dl class="hours-list">
          <div class="hours-row">
            <dt>Where</dt>
            <dd>{street}<br />{locality}, {region}, {postalCode}</dd>
          </div>
          {site.hoursConfirmed ? (
            site.hours.map((h) => (
              <div class="hours-row">
                <dt>{h.days}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          ) : (
            <div class="hours-row">
              <dt>When</dt>
              <dd>Hours vary — message us before you come.</dd>
            </div>
          )}
        </dl>

        <div class="hours-actions">
          <a class="hours-btn" href={mapLink} target="_blank" rel="noopener noreferrer">
            Get directions <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: calc(var(--nav-h) + 6rem) 0 6rem;
  }
  .page-header h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin: 1rem 0;
  }
  .page-header-sub {
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  /* mobile-first: the two actions stack full-width, so each is a whole thumb
     target rather than a short pill floating on a wide row */
  .actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.6rem;
    background: var(--ink);
    color: var(--cream);
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--ink);
    transition: opacity 0.25s;
  }
  .btn:hover {
    opacity: 0.85;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule);
  }
  /* after the .btn rules, not before — a media query adds no specificity, so
     `width: auto` only wins if it comes later in the sheet */
  @media (min-width: 600px) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .btn {
      width: auto;
    }
  }
  /* ── FAQ ── */
  /* its own grained sand band (same sand as the footer base bar and shop
     filter strip), so it reads as a separate block from the cream hero */
  #faq {
    position: relative;
    padding: var(--space-section) 0;
    background: color-mix(in srgb, var(--warm) 18%, var(--cream));
    --grain-opacity: 0.3;
    border-top: 1px solid var(--rule);
    scroll-margin-top: var(--nav-h);
    /* .grain sets overflow:hidden, which makes this the sticky heading's
       scroll container; clip still contains the grain without that */
    overflow: clip;
  }
  #faq .wrap {
    position: relative;
    z-index: 2;
  }
  #faq h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0.75rem 0 2rem;
  }
  /* desktop: heading left, questions right — a different shape from the
     stacked hero above */
  @media (min-width: 900px) {
    .faq-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--grid-gap);
      max-width: var(--grid-max);
    }
    .faq-head {
      position: sticky;
      top: calc(var(--nav-h) + var(--space-lg));
      align-self: start;
    }
    #faq h2 {
      margin-bottom: 0;
    }
  }
  .faq-list {
    max-width: 46rem;
    border-top: 1px solid var(--rule);
  }
  .faq {
    border-bottom: 1px solid var(--rule);
  }
  .faq summary {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0;
    font-size: 1.05rem;
    line-height: 1.35;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    margin-left: auto;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--muted);
  }
  .faq[open] summary::after {
    content: '−';
  }
  .faq-a {
    max-width: 60ch;
    padding: 0 2rem 1.4rem 0;
    color: var(--muted);
    line-height: 1.55;
  }
  .faq-a :global(a),
  .faq-more a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .faq-more {
    margin-top: 1.75rem;
    color: var(--muted);
  }
  /* ── Opening times ── full-bleed photographic band ── */
  #hours {
    scroll-margin-top: var(--nav-h);
  }
  #hours {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(600px, 90vh, 920px);
    min-height: clamp(600px, 90svh, 920px);
    padding: var(--space-3xl) 0;
    background: var(--ink);
    color: var(--cream);
  }
  .hours-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* mirrored so the door sits opposite the copy instead of behind it */
    transform: scaleX(-1);
  }
  /* same two-stop wash the heroes use, so cream type holds over any frame */
  #hours::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(26, 20, 16, 0.55), rgba(26, 20, 16, 0.66));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 45%, transparent),
      color-mix(in srgb, var(--ink) 62%, transparent)
    );
  }
  #hours .wrap {
    position: relative;
    z-index: 2;
  }
  #hours .label {
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }
  #hours h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0.75rem 0 1rem;
  }
  /* film grain over photo + wash, under the copy — matches the heroes */
  #hours.grain::after {
    z-index: 1;
    --grain-opacity: 0.2;
  }
  .hours-lead {
    max-width: 38ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: color-mix(in srgb, var(--cream) 85%, transparent);
  }
  /* Where / When (or the confirmed hours): label left, detail right, hairline
     rules between — the one block someone is scanning for */
  .hours-list {
    max-width: 30rem;
    margin-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-sm);
    padding: 0.9rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 30%, transparent);
  }
  .hours-row dt {
    padding-top: 0.2em;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 60%, transparent);
  }
  .hours-row dd {
    line-height: 1.4;
    /* tabular figures keep the times aligned down the column */
    font-variant-numeric: tabular-nums;
  }
  .hours-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  /* cream-on-photo versions of the page's .btn pair */
  .hours-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--cream);
    transition: gap 0.3s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .hours-btn:hover {
    gap: 0.85rem;
  }
  .hours-btn.ghost {
    color: var(--cream);
    background: transparent;
    border-color: color-mix(in srgb, var(--cream) 50%, transparent);
  }
  .hours-btn.ghost:hover {
    border-color: var(--cream);
  }
  @media (max-width: 520px) {
    .hours-row {
      grid-template-columns: 7.5rem 1fr;
    }
    .hours-btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
