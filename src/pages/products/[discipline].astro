---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { disciplines, getProducts, slug } from '@/lib/catalog';
import type { Product } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getProducts();
  return disciplines.map((d) => ({
    params: { discipline: d.handle },
    props: {
      discipline: d,
      products: all.filter((p: Product) => slug(p.productType) === d.handle),
    },
  }));
}

const { discipline, products } = Astro.props;

// Only offer filters for categories that actually have products in this
// discipline — e.g. Surf lists "Custom" but has no custom-tagged board yet.
const present = new Set(products.flatMap((p: Product) => p.tags));
const cats = discipline.categories.filter((c: string) => present.has(c));
---

<Layout title={`${discipline.title} · Wawa Surfboards`} current="products">
  <nav class="disc-switch" aria-label="Product types">
    <div class="disc-band">
      <div class="disc-switch-inner wrap">
      {
        disciplines.map((d) => (
          <a
            href={`/products/${d.handle}`}
            class:list={['disc-tab', { active: d.handle === discipline.handle }]}
            aria-current={d.handle === discipline.handle ? 'page' : undefined}
          >
            {d.title}
          </a>
        ))
      }
      </div>
    </div>
  </nav>

  <header class="page-header">
    <div class="wrap">
      <p class="label fade-in">Products</p>
      <h1 class="fade-in">{discipline.title}</h1>
      <p class="page-header-sub fade-in">{discipline.intro ?? discipline.blurb}</p>
    </div>
  </header>

  {
    discipline.hero && products.length === 0 && (
      <div class="wrap">
        <div class="hero-img wf-ph fade-in" role="presentation"></div>
      </div>
    )
  }

  <section id="range">
    <div class="wrap">
      {
        cats.length > 1 && (
          <ul class="cats fade-in" role="group" aria-label={`Filter ${discipline.title} by category`}>
            <li>
              <button class="cat is-active" data-filter="all" aria-pressed="true">
                All
              </button>
            </li>
            {cats.map((c: string) => (
              <li>
                <button class="cat" data-filter={c} aria-pressed="false">
                  {c}
                </button>
              </li>
            ))}
          </ul>
        )
      }

      {
        products.length > 0 ? (
          <div class="product-grid">
            {products.map((p: Product) => (
              <div class="grid-item" data-tags={p.tags.join('|')}>
                <ProductCard product={p} />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty fade-in">
            Boards coming soon. Get in touch to commission a custom {discipline.title.toLowerCase()}{' '}
            build.
          </p>
        )
      }
    </div>
  </section>
</Layout>

<style>
  /* secondary nav: switch between product disciplines.
     Transparent spacer clears the fixed site nav; the band scrolls normally,
     sliding up behind the nav (which is opaque once scrolled). */
  .disc-switch {
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top));
  }
  /* full-bleed band, its own tone to read distinct from the cream page/nav */
  .disc-band {
    background: color-mix(in srgb, var(--warm) 12%, var(--cream));
    border-bottom: 1px solid var(--rule);
  }
  .disc-switch-inner {
    display: flex;
    align-items: stretch;
    gap: 2rem;
    height: 2.4rem; /* slim band beneath the nav */
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .disc-switch-inner::-webkit-scrollbar {
    display: none;
  }
  /* clear active/inactive by colour + weight: muted/light → ink/regular */
  .disc-tab {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .disc-tab:hover {
    color: var(--ink);
  }
  .disc-tab.active {
    color: var(--ink);
    font-weight: var(--fw-regular);
  }

  .page-header {
    padding: 3rem 0;
  }
  .page-header h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin: 1rem 0;
  }
  .page-header-sub {
    max-width: 44ch;
    color: var(--muted);
    font-size: 1.05rem;
  }
  #range {
    padding-bottom: 5rem;
  }
  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    margin-bottom: 3rem;
  }
  .cats {
    list-style: none;
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
    /* one row; scroll sideways on overflow rather than wrapping */
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .cats::-webkit-scrollbar {
    display: none;
  }
  .cats li {
    flex: 0 0 auto;
  }
  .cat {
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: color 0.2s var(--ease), background 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .cat:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .cat.is-active {
    color: var(--cream);
    background: var(--ink);
    border-color: var(--ink);
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  /* keep the `1fr` columns strictly equal — the aspect-ratio media inside each
     card would otherwise hand its grid cell an automatic minimum width */
  .grid-item {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .empty {
    color: var(--muted);
    max-width: 40ch;
    font-size: 1.05rem;
  }
</style>

<script>
  // Category pills filter the grid client-side. A card stays visible when its
  // tag list includes the active filter (or the filter is "all").
  const bar = document.querySelector<HTMLElement>('.cats');
  if (bar) {
    const items = [...document.querySelectorAll<HTMLElement>('.grid-item')];
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const filter = btn.dataset.filter ?? 'all';
      bar.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      items.forEach((it) => {
        const tags = (it.dataset.tags ?? '').split('|');
        it.hidden = filter !== 'all' && !tags.includes(filter);
      });
    });
  }
</script>
