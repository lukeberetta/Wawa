---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { disciplines, getProducts, slug, formatPrice } from '@/lib/catalog';
import { site } from '@/lib/site';
import type { Product, Discipline } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => {
    const disciplineHandle = slug(p.productType);
    return {
      params: { discipline: disciplineHandle, handle: p.handle },
      props: {
        product: p,
        discipline: disciplines.find((d) => d.handle === disciplineHandle),
        related: all
          .filter((r) => slug(r.productType) === disciplineHandle && r.handle !== p.handle)
          .slice(0, 4),
      },
    };
  });
}

interface Props {
  product: Product;
  discipline?: Discipline;
  related: Product[];
}
const { product, discipline, related } = Astro.props;

const price = formatPrice(product);
const hasPrice = price !== 'Enquire';
// Mirror ProductCard: buyable only with stock + variant id + a configured shop.
const buyable = product.availableForSale && !!product.variantId && !!site.shopDomain;

const images = product.images;
const lead = images[0];
// Carousel slide count — one per image; show at least 3 placeholder slides
// while in the wireframe phase so the gallery reads as a real carousel.
const slideCount = Math.max(images.length, 3);
const category = product.tags[0];
const disciplineHref = `/products?discipline=${slug(product.productType)}`;

// SEO: Product structured data (offer only when buyable, else nothing to price).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  image: images.map((i) => new URL(i.url, site.url).href),
  brand: { '@type': 'Brand', name: site.name },
  ...(buyable && {
    offers: {
      '@type': 'Offer',
      price: product.priceRange.minVariantPrice.amount,
      priceCurrency: product.priceRange.minVariantPrice.currencyCode,
      availability: 'https://schema.org/InStock',
    },
  }),
};
---

<Layout
  title={`${product.title} · Wawa Surfboards`}
  description={product.description}
  current="products"
>
  <article class="pdp">
    <!-- Full-bleed image carousel — swipe + dots. Wireframe placeholders until
         real deck/hull shots land (one slide per product image). -->
    <section class="gallery fade-in" aria-label={`${product.title} images`}>
      <div class="carousel" data-carousel>
        {/* No data-lenis-prevent: it prevents Lenis on both axes, so a vertical
            scroll over the carousel dropped to native while the rest of the page
            stayed smoothed, and the page jerked as the cursor crossed in and out.
            Horizontal gestures are handed to the browser in Motion.astro. */}
        <ul class="car-track" data-car-track>
          {Array.from({ length: slideCount }).map((_, i) => (
            <li class="car-slide">
              {images[i] ? (
                <img
                  class="slide-media slide-img"
                  src={images[i].url}
                  alt={images[i].altText ?? product.title}
                  width="1086"
                  height="1448"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="slide-media wf-ph" role="presentation" />
              )}
            </li>
          ))}
        </ul>
        {slideCount > 1 && (
          <div class="car-dots" data-car-dots role="tablist" aria-label="Choose image">
            {Array.from({ length: slideCount }).map((_, i) => (
              <button
                class:list={['car-dot', { 'is-active': i === 0 }]}
                data-i={i}
                aria-label={`Show image ${i + 1}`}
              />
            ))}
          </div>
        )}
      </div>
    </section>

    <div class="wrap">
      <section class="info">
        <div class="info-inner fade-in">
            {category && <p class="label info-cat">{category}</p>}
            <h1>{product.title}</h1>
            <p class="info-desc">{product.description}</p>

            <div class="info-actions">
              {
                buyable ? (
                  <button
                    class="pdp-action"
                    data-add-to-cart
                    data-variant-id={product.variantId}
                    data-handle={product.handle}
                    data-title={product.title}
                    data-price={product.priceRange.minVariantPrice.amount}
                    data-image={lead.url}
                  >
                    Add to cart
                  </button>
                ) : (
                  <button
                    class="pdp-action"
                    data-order
                    data-order-discipline={slug(product.productType)}
                    data-order-category={category}
                    data-order-title={product.title}
                  >
                    Enquire on WhatsApp
                  </button>
                )
              }
              {
                !buyable && (
                  <p class="info-note">
                    {hasPrice
                      ? 'Made to order — get in touch to start a build.'
                      : 'Price on application. Made to order — get in touch for pricing and lead time.'}
                  </p>
                )
              }
            </div>

            {
              product.specs ? (
                <dl class="specs">
                  {product.specs.flat().map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <dl class="specs">
                  <div>
                    <dt>Discipline</dt>
                    <dd><a href={disciplineHref}>{product.productType}</a></dd>
                  </div>
                  {product.tags.length > 0 && (
                    <div>
                      <dt>Type</dt>
                      <dd>{product.tags.join(', ')}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Made</dt>
                    <dd>By hand in {site.location}</dd>
                  </div>
                </dl>
              )
            }
        </div>
      </section>
    </div>

    <!-- Sticky buy bar — reveals once the inline action scrolls out of view,
         keeping the price + CTA in the thumb zone (Apple PDP pattern). -->
    <div class="pdp-bar">
      <div class="wrap pdp-bar-inner">
        <div class="pdp-bar-meta">
          <span class="pdp-bar-title">{product.title}</span>
          <span class="pdp-bar-price">{price}</span>
        </div>
        {
          buyable ? (
            <button
              class="pdp-bar-action"
              data-add-to-cart
              data-variant-id={product.variantId}
              data-handle={product.handle}
              data-title={product.title}
              data-price={product.priceRange.minVariantPrice.amount}
              data-image={lead.url}
            >
              Add to cart
            </button>
          ) : (
            <button
              class="pdp-bar-action"
              data-order
              data-order-discipline={slug(product.productType)}
              data-order-category={category}
              data-order-title={product.title}
            >
              Enquire
            </button>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <div class="wrap">
            <h2 class="related-head fade-in">
              More from <a href={disciplineHref}>{discipline?.title ?? product.productType}</a>
            </h2>
            <div class="product-grid">
              {related.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Layout>

<style>
  .pdp {
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top));
  }

  /* ── Carousel ── full-bleed swipe gallery with dots ── */
  .gallery {
    /* overlap the nav's bottom hairline instead of stacking a doubled line */
    margin-top: -1px;
    margin-bottom: var(--space-xl);
  }
  .carousel {
    position: relative;
  }
  .car-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .car-track::-webkit-scrollbar {
    display: none;
  }
  /* slides sit shy of full width so the neighbouring image peeks in */
  .car-slide {
    flex: 0 0 92%;
    min-width: 0;
    scroll-snap-align: center;
  }
  /* overlap adjacent borders so the seam stays a single hairline, not 2px */
  .car-slide + .car-slide {
    margin-left: -1px;
  }
  .slide-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }
  .slide-img {
    display: block;
    height: auto;
    object-fit: cover;
  }
  /* dots float over the foot of the image, centred */
  .car-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .car-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .car-dot.is-active {
    background: var(--ink);
    transform: scale(1.15);
  }
  /* desktop: full-bleed scroll gallery — square slides sized by height, laid
     flush across the full viewport width so neighbouring images peek in with no
     side or middle gaps; the rail reads as scrollable. */
  @media (min-width: 900px) {
    .car-slide {
      flex: 0 0 auto;
      scroll-snap-align: center;
    }
    .slide-media {
      /* 1:1, height-driven so the section never exceeds 70vh */
      width: auto;
      height: 70vh;
      aspect-ratio: 1 / 1;
    }
    /* peeking neighbours signal the rail is scrollable — dots are redundant */
    .car-dots {
      display: none;
    }
  }

  /* ── Info ── single centred column under the carousel ── */
  .info {
    max-width: 880px;
    margin-inline: auto;
  }
  .info-cat {
    margin-bottom: 1rem;
  }
  .info h1 {
    font-size: var(--fs-h2);
    line-height: 1.02;
  }
  .info-desc {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 56ch;
    margin-top: 1.5rem;
  }
  .info-actions {
    margin-top: 2rem;
  }
  .pdp-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 360px;
    padding: 1rem 1.5rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-action:hover {
    opacity: 0.85;
  }
  .info-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.85rem;
    max-width: 44ch;
  }

  /* ── Sticky buy bar ── persistent, but slides away as the footer reveals ── */
  .pdp-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100; /* under the cart drawer/overlay (125/126) */
    background: var(--cream);
    border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom);
    transition: transform 0.35s var(--ease);
  }
  /* dropped out of view once the curtain footer starts to show */
  .pdp-bar.is-hidden {
    transform: translateY(100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-bar {
      transition: none;
    }
  }
  .pdp-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
    padding-block: 0.6rem;
  }
  .pdp-bar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .pdp-bar-title {
    font-size: var(--fs-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdp-bar-price {
    font-size: 0.78rem;
    color: var(--warm);
  }
  .pdp-bar-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-bar-action:hover {
    opacity: 0.85;
  }
  /* centre the bar's content on wide screens to match the info column */
  .pdp-bar-inner {
    max-width: 880px;
    margin-inline: auto;
  }

  /* spec table — label/value rows divided by hairlines, blocks separated by gap */
  .specs {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--rule);
  }
  .specs > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
  }
  /* no rule on a block's last row — keeps the break a single line (the next
     block's top rule), and the gap sits as clean whitespace, not below a line */
  .specs > div:last-child {
    border-bottom: none;
  }
  .specs dt {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .specs dd {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .specs dd a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .specs dd a:hover {
    border-color: var(--ink);
  }
  @media (min-width: 600px) {
    .specs > div {
      grid-template-columns: 9rem 1fr;
    }
  }

  /* ── Related ── */
  .related {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }
  .related-head {
    font-size: 1.4rem;
    margin-bottom: 2.5rem;
  }
  .related-head a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .related-head a:hover {
    border-color: var(--ink);
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>

<script>
  // ── Carousel ── native scroll-snap track + dot indicators.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-car-track]');
  const dots = carousel
    ? Array.from(carousel.querySelectorAll<HTMLButtonElement>('.car-dot'))
    : [];

  if (track && dots.length) {
    const slides = Array.from(track.children) as HTMLElement[];
    const setActive = (i: number) =>
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));

    // centre slide i in the track (slides are < full width, so don't assume
    // clientWidth steps)
    const centreOn = (i: number) => {
      const s = slides[i];
      if (!s) return;
      track.scrollTo({
        left: s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2,
        behavior: 'smooth',
      });
    };

    // dot → snap to that slide
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        centreOn(i);
        setActive(i);
      }),
    );

    // reflect the active dot as the track is swiped — pick the slide whose
    // centre is nearest the track's centre
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const centre = track.scrollLeft + track.clientWidth / 2;
          let best = 0;
          let bestDist = Infinity;
          slides.forEach((s, i) => {
            const dist = Math.abs(s.offsetLeft + s.offsetWidth / 2 - centre);
            if (dist < bestDist) {
              bestDist = dist;
              best = i;
            }
          });
          setActive(best);
        });
      },
      { passive: true },
    );
  }

  // ── Buy bar ── persistent, but tuck it away once the "More from" related
  // section comes into view (no longer relevant to the product being viewed).
  const buyBar = document.querySelector<HTMLElement>('.pdp-bar');
  const related = document.querySelector<HTMLElement>('.related');
  if (buyBar && related && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        // hide once the related section's top reaches the fold and keep it
        // hidden past that — don't let it pop back when related exits the top
        const reached = entry.boundingClientRect.top <= window.innerHeight;
        buyBar.classList.toggle('is-hidden', reached);
      },
      { threshold: 0 },
    );
    io.observe(related);
  }
</script>
