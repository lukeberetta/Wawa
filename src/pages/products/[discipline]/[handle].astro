---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { disciplines, getProducts, slug, formatPrice, makeYourOwnPrice } from '@/lib/catalog';
import { site } from '@/lib/site';
import { ORG_ID, abs, breadcrumbs } from '@/lib/schema';
import type { Product, Discipline } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => {
    const disciplineHandle = slug(p.productType);
    return {
      params: { discipline: disciplineHandle, handle: p.handle },
      props: {
        product: p,
        discipline: disciplines.find((d) => d.handle === disciplineHandle),
        related: all
          .filter((r) => slug(r.productType) === disciplineHandle && r.handle !== p.handle)
          .slice(0, 4),
      },
    };
  });
}

interface Props {
  product: Product;
  discipline?: Discipline;
  related: Product[];
}
const { product, discipline, related } = Astro.props;

const price = formatPrice(product);
const hasPrice = price !== 'Enquire';
// Sized products carry one variant id per size; the picker below hands the
// chosen one to the add-to-cart buttons, so they start without an id.
const variants = product.variants ?? [];
const sized = variants.length > 0;
// Gift card: the variants are amounts, picked by an amount field (snapped to the
// nearest denomination) rather than a chip each. Starts on R1,000 so the
// add-to-cart buttons carry an id from the outset.
const amounts = product.customAmount ? variants.map((v) => Number(v.price)) : [];
const amountStep = amounts.length > 1 ? amounts[1] - amounts[0] : 1;
const defaultAmount = amounts.includes(1000) ? 1000 : amounts[0];
const defaultVariant = variants.find((v) => Number(v.price) === defaultAmount);
const zarText = (n: number) => `R${n.toLocaleString('en-US')}`;
// Buyable only with stock + variant id(s) + a configured shop.
const buyable =
  site.salesOpen &&
  product.availableForSale &&
  !!site.shopDomain &&
  (sized ? variants.every((v) => v.id) : !!product.variantId);
// An accessory without its Shopify ids yet is waiting, not made to order.
const comingSoon = !buyable && product.productType === 'Accessories';
const cartVariantId = product.customAmount ? defaultVariant?.id : sized ? '' : product.variantId;
const cartTitle = product.customAmount ? `${product.title} — ${zarText(defaultAmount)}` : product.title;
const cartPrice = product.customAmount ? String(defaultAmount) : product.priceRange.minVariantPrice.amount;
const barPrice = product.customAmount ? zarText(defaultAmount) : price;
// Boards (enquire-only) offer a "make it yourself" build — shaped by the
// customer in our workshop at the board price + 20%. The choice re-prices the
// buy bar and rides along into the enquiry.
const isBoard = product.productType !== 'Accessories';
const boardAmount = Number(product.priceRange.minVariantPrice.amount);
const fromPrice = (n: number) => `From R${n.toLocaleString('en-US')}`;
const builds = [
  { value: 'We build it', price: hasPrice ? fromPrice(boardAmount) : price },
  {
    value: 'Make it yourself',
    price: hasPrice ? fromPrice(makeYourOwnPrice(boardAmount)) : price,
  },
];

const images = product.images;
const lead = images[0];
// Carousel slide count — one per image; show at least 3 placeholder slides
// while in the wireframe phase so the gallery reads as a real carousel.
const slideCount = Math.max(images.length, 3);
const category = product.tags[0];
const disciplineHref = `/products?discipline=${slug(product.productType)}`;

// SEO: Product structured data.
//
// `offers` only for buyable items — they carry real prices. A product still on
// the R999 import placeholder has no variant id, so it never gets one; an offer
// node would put that number straight into the search result.
const emitOffer = buyable;

const productSchema = {
  '@type': 'Product',
  '@id': `${abs(Astro.url.pathname)}#product`,
  name: product.title,
  description: product.description,
  image: images.map((i) => abs(i.url)),
  category: product.productType,
  brand: { '@type': 'Brand', name: site.name },
  manufacturer: { '@id': ORG_ID },
  ...(emitOffer && {
    offers: {
      '@type': 'Offer',
      url: abs(Astro.url.pathname),
      price: product.priceRange.minVariantPrice.amount,
      priceCurrency: product.priceRange.minVariantPrice.currencyCode,
      availability: 'https://schema.org/InStock',
      seller: { '@id': ORG_ID },
    },
  }),
};

const crumbs = breadcrumbs([
  { name: 'Shop', path: '/products' },
  { name: discipline?.title ?? product.productType, path: disciplineHref },
  { name: product.title },
]);
---

<Layout
  title={`${product.title} · Wawa Surfboards`}
  description={product.description}
  current="products"
  schema={[productSchema, crumbs]}
>
  <article class="pdp">
    <!-- Full-bleed image carousel — swipe + dots. Wireframe placeholders until
         real deck/hull shots land (one slide per product image). -->
    <section class="gallery fade-in" aria-label={`${product.title} images`}>
      <div class="carousel" data-carousel>
        {/* No data-lenis-prevent: it prevents Lenis on both axes, so a vertical
            scroll over the carousel dropped to native while the rest of the page
            stayed smoothed, and the page jerked as the cursor crossed in and out.
            Horizontal gestures are handed to the browser in Motion.astro. */}
        <ul class:list={['car-track', { 'has-more': slideCount > 3 }]} data-car-track>
          {Array.from({ length: slideCount }).map((_, i) => (
            <li class="car-slide">
              {images[i]?.placeholder ? (
                <div class="slide-media slide-soon">
                  <img
                    class="slide-img"
                    src={images[i].url}
                    alt={images[i].altText ?? product.title}
                    width="1600"
                    height="2000"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                  <span class="soon-label" aria-hidden="true">Coming soon</span>
                </div>
              ) : images[i] ? (
                <div class="slide-media grain">
                  <img
                    class="slide-img"
                    src={images[i].url}
                    alt={images[i].altText ?? product.title}
                    width="1600"
                    height="2000"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ) : (
                <div class="slide-media wf-ph" role="presentation" />
              )}
            </li>
          ))}
        </ul>
        {slideCount > 1 && (
          <div class="car-dots" data-car-dots role="tablist" aria-label="Choose image">
            {Array.from({ length: slideCount }).map((_, i) => (
              <button
                class:list={['car-dot', { 'is-active': i === 0 }]}
                data-i={i}
                aria-label={`Show image ${i + 1}`}
              />
            ))}
          </div>
        )}
      </div>
    </section>

    <div class="wrap">
      <section class="info">
        <div class="info-inner fade-in">
            {category && <p class="label info-cat">{category}</p>}
            <h1>{product.title}</h1>
            <p class="info-desc">{product.description}</p>

            <div class="info-actions">
              {
                product.customAmount && (
                  <fieldset
                    class="sizes"
                    data-amount
                    data-step={amountStep}
                    data-variants={JSON.stringify(Object.fromEntries(variants.map((v) => [Number(v.price), v.id])))}
                  >
                    <legend class="sizes-legend">{product.optionName ?? 'Amount'}</legend>
                    <label class="amount-field">
                      <span class="amount-prefix" aria-hidden="true">R</span>
                      <input
                        type="number"
                        inputmode="numeric"
                        min={amounts[0]}
                        max={amounts[amounts.length - 1]}
                        step={amountStep}
                        value={defaultAmount}
                        aria-label="Gift card amount in rand"
                      />
                    </label>
                    <p class="amount-hint">
                      {`${zarText(amounts[0])} to ${zarText(amounts[amounts.length - 1])}`}
                    </p>
                  </fieldset>
                )
              }
              {
                sized && !product.customAmount && (
                  <fieldset class="sizes" data-sizes>
                    <legend class="sizes-legend">{product.optionName ?? 'Size'}</legend>
                    <div class="sizes-row">
                      {variants.map((v) => (
                        <label class="size">
                          <input
                            type="radio"
                            name="size"
                            value={v.id}
                            data-size={v.title}
                            data-price={v.price ?? product.priceRange.minVariantPrice.amount}
                            disabled={!buyable}
                          />
                          <span>{v.title}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )
              }
              {
                isBoard && (
                  <fieldset class="sizes" data-build>
                    <legend class="sizes-legend">Build</legend>
                    <div class="sizes-row">
                      {builds.map((b, i) => (
                        <label class="size">
                          <input type="radio" name="build" value={b.value} data-price={b.price} checked={i === 0} />
                          <span>{b.value}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )
              }
              {
                buyable ? (
                  <button
                    class="pdp-action"
                    data-add-to-cart
                    data-variant-id={cartVariantId}
                    data-handle={product.handle}
                    data-title={cartTitle}
                    data-price={cartPrice}
                    data-image={lead.url}
                  >
                    Add to cart
                  </button>
                ) : comingSoon ? (
                  <button class="pdp-action" disabled>
                    Coming soon
                  </button>
                ) : (
                  <button
                    class="pdp-action"
                    data-order
                    data-order-discipline={slug(product.productType)}
                    data-order-category={category}
                    data-order-title={product.title}
                    data-order-build={isBoard ? builds[0].value : undefined}
                  >
                    Enquire about this board
                  </button>
                )
              }
              {
                !buyable && !comingSoon && (
                  <p class="info-note">
                    {hasPrice
                      ? 'Made to order — ask us about your build and lead time.'
                      : 'Made to order — ask us about pricing and lead time.'}
                    {isBoard && ' Make it yourself: shape it with us over seven 3-hour workshop sessions, for 20% more.'}
                  </p>
                )
              }
            </div>

            {
              product.specs ? (
                <dl class="specs">
                  {product.specs.flat().map((s) => (
                    <div>
                      <dt>{s.label}</dt>
                      <dd>{s.value}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <dl class="specs">
                  <div>
                    <dt>Discipline</dt>
                    <dd><a href={disciplineHref}>{product.productType}</a></dd>
                  </div>
                  {product.tags.length > 0 && (
                    <div>
                      <dt>Type</dt>
                      <dd>{product.tags.join(', ')}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Made</dt>
                    <dd>By hand in {site.location}</dd>
                  </div>
                </dl>
              )
            }
        </div>
      </section>
    </div>

    <!-- Sticky buy bar — reveals once the inline action scrolls out of view,
         keeping the price + CTA in the thumb zone (Apple PDP pattern). -->
    <div class="pdp-bar">
      <div class="wrap pdp-bar-inner">
        <div class="pdp-bar-meta">
          <span class="pdp-bar-title">{product.title}</span>
          {/* coming-soon items: the button says it, so no price line */}
          {!comingSoon && <span class="pdp-bar-price">{barPrice}</span>}
        </div>
        {
          buyable ? (
            <button
              class="pdp-bar-action"
              data-add-to-cart
              data-variant-id={cartVariantId}
              data-handle={product.handle}
              data-title={cartTitle}
              data-price={cartPrice}
              data-image={lead.url}
            >
              Add to cart
            </button>
          ) : comingSoon ? (
            <button class="pdp-bar-action" disabled>
              Coming soon
            </button>
          ) : (
            <button
              class="pdp-bar-action"
              data-order
              data-order-discipline={slug(product.productType)}
              data-order-category={category}
              data-order-title={product.title}
              data-order-build={isBoard ? builds[0].value : undefined}
            >
              Enquire
            </button>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <div class="wrap">
            <h2 class="related-head fade-in">
              More from <a href={disciplineHref}>{discipline?.title ?? product.productType}</a>
            </h2>
            <div class="product-grid">
              {related.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .pdp {
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top));
  }

  /* ── Carousel ── full-bleed swipe gallery with dots ── */
  .gallery {
    /* overlap the nav's bottom hairline instead of stacking a doubled line */
    margin-top: -1px;
    margin-bottom: var(--space-xl);
  }
  .carousel {
    position: relative;
  }
  .car-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .car-track::-webkit-scrollbar {
    display: none;
  }
  /* slides sit shy of full width so the neighbouring image peeks in */
  .car-slide {
    flex: 0 0 92%;
    min-width: 0;
    scroll-snap-align: center;
  }
  /* overlap adjacent borders so the seam stays a single hairline, not 2px */
  .car-slide + .car-slide {
    margin-left: -1px;
  }
  .slide-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }
  .slide-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* empty-room plate, blurred under a "Coming soon" label — the frame keeps the
     slide's border + aspect, the image fills it and is clipped at the edge */
  .slide-soon {
    position: relative;
    overflow: hidden;
  }
  .slide-soon .slide-img {
    width: 100%;
    height: 100%;
    filter: blur(8px) brightness(0.6);
    transform: scale(1.04);
  }
  .soon-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream);
    pointer-events: none;
  }
  /* dots float over the foot of the image, centred */
  .car-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .car-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    cursor: pointer;
    transition: background 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .car-dot.is-active {
    background: var(--ink);
    transform: scale(1.15);
  }
  /* desktop: full-bleed 4:5 frames sized by width, never fewer than three
     (slideCount pads with placeholders). Three split the viewport exactly — the
     +2px offsets the -1px border overlaps so the row lands flush. A fourth or
     more narrows the frames so the next one peeks in and the rail reads as
     scrollable. */
  @media (min-width: 900px) {
    .car-slide {
      flex: 0 0 calc((100% + 2px) / 3);
      scroll-snap-align: start;
    }
    .car-track.has-more .car-slide {
      flex-basis: calc(100% / 3.25);
    }
    /* peeking neighbours signal the rail is scrollable — dots are redundant */
    .car-dots {
      display: none;
    }
  }

  /* ── Info ── single centred column under the carousel ── */
  .info {
    max-width: 880px;
    margin-inline: auto;
  }
  .info-cat {
    margin-bottom: 1rem;
  }
  .info h1 {
    font-size: var(--fs-h2);
    line-height: 1.02;
  }
  .info-desc {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 56ch;
    margin-top: 1.5rem;
  }
  .info-actions {
    margin-top: 2rem;
  }
  .pdp-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 360px;
    padding: 1rem 1.5rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-action:hover {
    opacity: 0.85;
  }
  .pdp-action:disabled,
  .pdp-bar-action:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* size picker — a row of square hairline chips; the chosen one fills ink */
  .sizes {
    border: 0;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .sizes-legend {
    padding: 0;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .sizes-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .size {
    position: relative;
  }
  .size input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .size span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    height: 3.25rem;
    padding-inline: 0.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    border: 1px solid var(--rule);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .size input:hover:not(:disabled) + span {
    border-color: var(--ink);
  }
  .size input:checked + span {
    color: var(--cream);
    background: var(--ink);
    border-color: var(--ink);
  }
  .size input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .size input:disabled + span {
    color: var(--muted);
    cursor: default;
  }
  /* add-to-cart pressed before a size was chosen */
  .sizes.is-invalid .sizes-legend {
    color: var(--ink);
  }
  .sizes.is-invalid .size span {
    border-color: var(--ink);
  }
  /* gift-card amount — a single hairline field, chip height */
  .amount-field {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 360px;
    height: 3.25rem;
    border: 1px solid var(--rule);
    transition: border-color 0.2s var(--ease);
  }
  .amount-field:hover,
  .amount-field:focus-within {
    border-color: var(--ink);
  }
  .amount-prefix {
    padding-left: 0.9rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .amount-field input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 0.9rem 0 0.35rem;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: transparent;
    border: 0;
    outline: none;
  }
  .amount-field input:disabled {
    color: var(--muted);
  }
  .amount-hint {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .info-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.85rem;
    max-width: 44ch;
  }

  /* ── Sticky buy bar ── persistent, but slides away as the footer reveals ── */
  .pdp-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100; /* under the cart drawer/overlay (125/126) */
    background: var(--cream);
    border-top: 1px solid var(--rule);
    padding-bottom: env(safe-area-inset-bottom);
    transition: transform 0.35s var(--ease);
  }
  /* dropped out of view once the curtain footer starts to show */
  .pdp-bar.is-hidden {
    transform: translateY(100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-bar {
      transition: none;
    }
  }
  .pdp-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
    padding-block: 0.6rem;
  }
  .pdp-bar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .pdp-bar-title {
    font-size: var(--fs-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdp-bar-price {
    font-size: 0.78rem;
    color: var(--warm);
  }
  .pdp-bar-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-bar-action:hover {
    opacity: 0.85;
  }
  /* centre the bar's content on wide screens to match the info column */
  .pdp-bar-inner {
    max-width: 880px;
    margin-inline: auto;
  }

  /* spec table — label/value rows divided by hairlines, blocks separated by gap */
  .specs {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--rule);
  }
  .specs > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
  }
  /* no rule on a block's last row — keeps the break a single line (the next
     block's top rule), and the gap sits as clean whitespace, not below a line */
  .specs > div:last-child {
    border-bottom: none;
  }
  .specs dt {
    font-size: 0.9rem;
    color: var(--muted);
  }
  .specs dd {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .specs dd a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .specs dd a:hover {
    border-color: var(--ink);
  }
  @media (min-width: 600px) {
    .specs > div {
      grid-template-columns: 9rem 1fr;
    }
  }

  /* ── Related ── */
  .related {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }
  .related-head {
    font-size: 1.4rem;
    margin-bottom: 2.5rem;
  }
  .related-head a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .related-head a:hover {
    border-color: var(--ink);
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

</style>

<script>
  // ── Carousel ── native scroll-snap track + dot indicators.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-car-track]');
  const dots = carousel
    ? Array.from(carousel.querySelectorAll<HTMLButtonElement>('.car-dot'))
    : [];

  if (track && dots.length) {
    const slides = Array.from(track.children) as HTMLElement[];
    const setActive = (i: number) =>
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));

    // centre slide i in the track (slides are < full width, so don't assume
    // clientWidth steps)
    const centreOn = (i: number) => {
      const s = slides[i];
      if (!s) return;
      track.scrollTo({
        left: s.offsetLeft - (track.clientWidth - s.offsetWidth) / 2,
        behavior: 'smooth',
      });
    };

    // dot → snap to that slide
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        centreOn(i);
        setActive(i);
      }),
    );

    // reflect the active dot as the track is swiped — pick the slide whose
    // centre is nearest the track's centre
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const centre = track.scrollLeft + track.clientWidth / 2;
          let best = 0;
          let bestDist = Infinity;
          slides.forEach((s, i) => {
            const dist = Math.abs(s.offsetLeft + s.offsetWidth / 2 - centre);
            if (dist < bestDist) {
              bestDist = dist;
              best = i;
            }
          });
          setActive(best);
        });
      },
      { passive: true },
    );
  }

  // ── Sizes ── the chosen size's variant id, price (sizes can cost different
  // amounts) and a size-suffixed title for the cart line are written onto every
  // add-to-cart button; the buy bar's "From" price becomes the size's price. Pressed with no size
  // picked, the button has no id — Cart.astro ignores it and we point at the
  // picker instead.
  const sizes = document.querySelector<HTMLFieldSetElement>('[data-sizes]');
  if (sizes) {
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-add-to-cart]'));
    const baseTitle = buttons[0]?.dataset.title ?? '';
    const barPrice = document.querySelector<HTMLElement>('.pdp-bar-price');
    sizes.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      sizes.classList.remove('is-invalid');
      buttons.forEach((b) => {
        b.dataset.variantId = input.value;
        b.dataset.title = `${baseTitle} — ${input.dataset.size}`;
        b.dataset.price = input.dataset.price;
      });
      if (barPrice) barPrice.textContent = `R${Number(input.dataset.price).toLocaleString('en-US')}`;
    });
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.variantId) return;
        sizes.classList.add('is-invalid');
        sizes.scrollIntoView({ behavior: 'smooth', block: 'center' });
        sizes.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
      }),
    );
  }

  // ── Amount ── gift card: the typed amount is clamped and snapped to
  // the nearest denomination, whose variant id, price and title go onto every
  // add-to-cart button. The field shows the snapped value once it loses focus.
  const amount = document.querySelector<HTMLFieldSetElement>('[data-amount]');
  if (amount) {
    const ids: Record<string, string> = JSON.parse(amount.dataset.variants ?? '{}');
    const step = Number(amount.dataset.step) || 1;
    const field = amount.querySelector<HTMLInputElement>('input[type="number"]')!;
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('[data-add-to-cart]'));
    const baseTitle = (buttons[0]?.dataset.title ?? '').split(' — ')[0];
    const barPrice = document.querySelector<HTMLElement>('.pdp-bar-price');
    const min = Number(field.min);
    const max = Number(field.max);
    const snap = (v: number) => Math.min(max, Math.max(min, Math.round(v / step) * step));
    const apply = (raw: number) => {
      const value = snap(Number.isFinite(raw) ? raw : min);
      const label = `R${value.toLocaleString('en-US')}`;
      buttons.forEach((b) => {
        b.dataset.variantId = ids[value] ?? '';
        b.dataset.title = `${baseTitle} — ${label}`;
        b.dataset.price = String(value);
      });
      if (barPrice) barPrice.textContent = label;
      return value;
    };
    // mid-typing (an emptied field) leaves the last amount in place
    field.addEventListener('input', () => {
      if (Number.isFinite(field.valueAsNumber)) apply(field.valueAsNumber);
    });
    field.addEventListener('change', () => {
      field.value = String(apply(field.valueAsNumber));
    });
  }

  // ── Build ── "We build it" / "Make it yourself": re-price the buy bar and
  // hand the choice to the enquiry buttons (OrderModal reads data-order-build).
  const build = document.querySelector<HTMLFieldSetElement>('[data-build]');
  if (build) {
    const barPrice = document.querySelector<HTMLElement>('.pdp-bar-price');
    const enquire = Array.from(document.querySelectorAll<HTMLElement>('[data-order][data-order-build]'));
    build.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (barPrice && input.dataset.price) barPrice.textContent = input.dataset.price;
      enquire.forEach((b) => (b.dataset.orderBuild = input.value));
    });
  }

  // ── Buy bar ── persistent, but tuck it away once the "More from" related
  // section comes into view (no longer relevant to the product being viewed).
  const buyBar = document.querySelector<HTMLElement>('.pdp-bar');
  const related = document.querySelector<HTMLElement>('.related');
  if (buyBar && related && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        // hide once the related section's top reaches the fold and keep it
        // hidden past that — don't let it pop back when related exits the top
        const reached = entry.boundingClientRect.top <= window.innerHeight;
        buyBar.classList.toggle('is-hidden', reached);
      },
      { threshold: 0 },
    );
    io.observe(related);
  }
</script>
