---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { disciplines, getProducts, slug, formatPrice } from '@/lib/catalog';
import { site, whatsappLink } from '@/lib/site';
import type { Product, Discipline } from '@/lib/types';

export async function getStaticPaths() {
  const all = await getProducts();
  return all.map((p) => {
    const disciplineHandle = slug(p.productType);
    return {
      params: { discipline: disciplineHandle, handle: p.handle },
      props: {
        product: p,
        discipline: disciplines.find((d) => d.handle === disciplineHandle),
        related: all
          .filter((r) => slug(r.productType) === disciplineHandle && r.handle !== p.handle)
          .slice(0, 4),
      },
    };
  });
}

interface Props {
  product: Product;
  discipline?: Discipline;
  related: Product[];
}
const { product, discipline, related } = Astro.props;

const price = formatPrice(product);
const hasPrice = price !== 'Enquire';
// Mirror ProductCard: buyable only with stock + variant id + a configured shop.
const buyable = product.availableForSale && !!product.variantId && !!site.shopDomain;
const enquire = whatsappLink(`Hi Wawa, I'm interested in the ${product.title}.`);

const images = product.images;
const lead = images[0];
const category = product.tags[0];
const disciplineHref = `/products/${slug(product.productType)}`;

// SEO: Product structured data (offer only when buyable, else nothing to price).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  image: images.map((i) => new URL(i.url, site.url).href),
  brand: { '@type': 'Brand', name: site.name },
  ...(buyable && {
    offers: {
      '@type': 'Offer',
      price: product.priceRange.minVariantPrice.amount,
      priceCurrency: product.priceRange.minVariantPrice.currencyCode,
      availability: 'https://schema.org/InStock',
    },
  }),
};
---

<Layout
  title={`${product.title} · Wawa Surfboards`}
  description={product.description}
  current="products"
>
  <article class="pdp">
    <div class="wrap">
      <nav class="crumbs fade-in" aria-label="Breadcrumb">
        <a href="/products">Shop</a>
        <span aria-hidden="true">/</span>
        <a href={disciplineHref}>{product.productType}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.title}</span>
      </nav>

      <div class="pdp-grid">
        <!-- Gallery (wireframe placeholder while imagery is pending) -->
        <section class="gallery fade-in" aria-label={`${product.title} images`}>
          <div class="gallery-main wf-ph" role="presentation"></div>
        </section>

        <!-- Info -->
        <section class="info">
          <div class="info-inner fade-in">
            {category && <p class="label info-cat">{category}</p>}
            <h1>{product.title}</h1>
            <p class="info-price">{price}</p>
            <p class="info-desc">{product.description}</p>

            <div class="info-actions" data-buy-anchor>
              {
                buyable ? (
                  <button
                    class="pdp-action"
                    data-add-to-cart
                    data-variant-id={product.variantId}
                    data-handle={product.handle}
                    data-title={product.title}
                    data-price={product.priceRange.minVariantPrice.amount}
                    data-image={lead.url}
                  >
                    Add to cart
                  </button>
                ) : (
                  <a
                    class="pdp-action"
                    href={enquire}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Enquire on WhatsApp
                  </a>
                )
              }
              {
                !buyable && (
                  <p class="info-note">
                    {hasPrice
                      ? 'Made to order — get in touch to start a build.'
                      : 'Price on application. Made to order — get in touch for pricing and lead time.'}
                  </p>
                )
              }
            </div>

            <dl class="specs">
              <div>
                <dt>Discipline</dt>
                <dd><a href={disciplineHref}>{product.productType}</a></dd>
              </div>
              {
                product.tags.length > 0 && (
                  <div>
                    <dt>Type</dt>
                    <dd>{product.tags.join(', ')}</dd>
                  </div>
                )
              }
              <div>
                <dt>Made</dt>
                <dd>By hand in {site.location}</dd>
              </div>
            </dl>
          </div>
        </section>
      </div>
    </div>

    <!-- Lightbox: opens on image click; carries the gallery images as JSON. -->
    <div
      class="lightbox"
      data-lightbox
      data-images={JSON.stringify(images.map((i) => ({ src: i.url, alt: i.altText })))}
      role="dialog"
      aria-modal="true"
      aria-label={`${product.title} images`}
      hidden
    >
      <button type="button" class="lb-close" aria-label="Close">&times;</button>
      {
        images.length > 1 && (
          <>
            <button type="button" class="lb-nav lb-prev" aria-label="Previous image">
              &#8249;
            </button>
            <button type="button" class="lb-nav lb-next" aria-label="Next image">
              &#8250;
            </button>
          </>
        )
      }
      <img class="lb-img" alt="" />
    </div>

    <!-- Sticky buy bar — reveals once the inline action scrolls out of view,
         keeping the price + CTA in the thumb zone (Apple PDP pattern). -->
    <div class="pdp-bar" data-buy-bar aria-hidden="true">
      <div class="wrap pdp-bar-inner">
        <div class="pdp-bar-meta">
          <span class="pdp-bar-title">{product.title}</span>
          <span class="pdp-bar-price">{price}</span>
        </div>
        {
          buyable ? (
            <button
              class="pdp-bar-action"
              data-add-to-cart
              data-variant-id={product.variantId}
              data-handle={product.handle}
              data-title={product.title}
              data-price={product.priceRange.minVariantPrice.amount}
              data-image={lead.url}
            >
              Add to cart
            </button>
          ) : (
            <a class="pdp-bar-action" href={enquire} target="_blank" rel="noopener noreferrer">
              Enquire
            </a>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <div class="wrap">
            <h2 class="related-head fade-in">
              More from <a href={disciplineHref}>{discipline?.title ?? product.productType}</a>
            </h2>
            <div class="product-grid">
              {related.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Layout>

<style>
  .pdp {
    padding-top: calc(var(--nav-h) + 2.5rem);
    padding-bottom: 5rem;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 2.5rem;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .crumbs span[aria-current] {
    color: var(--ink);
  }

  .pdp-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* ── Gallery ── */
  .gallery-main {
    display: block;
    width: 100%;
    padding: 0;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-thumbs {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .thumb {
    width: 72px;
    height: 90px;
    padding: 0;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    border: 1px solid var(--rule);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb:hover {
    opacity: 0.85;
  }
  .thumb[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--ink);
  }

  /* ── Info ── */
  .info-inner {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }
  .info-cat {
    margin-bottom: 1rem;
  }
  .info h1 {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.02;
  }
  .info-price {
    font-size: 1.25rem;
    color: var(--warm);
    margin-top: 1.1rem;
  }
  .info-desc {
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 46ch;
    margin-top: 1.5rem;
  }
  .info-actions {
    margin-top: 2rem;
  }
  .pdp-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 360px;
    padding: 1rem 1.5rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-action:hover {
    opacity: 0.85;
  }
  .info-note {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.85rem;
    max-width: 44ch;
  }

  /* ── Sticky buy bar ── */
  .pdp-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100; /* under the cart drawer/overlay (125/126) */
    background: var(--cream);
    border-top: 1px solid var(--rule);
    transform: translateY(100%);
    transition: transform 0.35s var(--ease);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .pdp-bar.show {
    transform: translateY(0);
  }
  .pdp-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
    padding-block: 0.6rem;
  }
  .pdp-bar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .pdp-bar-title {
    font-size: var(--fs-caption);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdp-bar-price {
    font-size: 0.78rem;
    color: var(--warm);
  }
  .pdp-bar-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    cursor: pointer;
    transition: opacity 0.2s var(--ease);
  }
  .pdp-bar-action:hover {
    opacity: 0.85;
  }
  /* desktop keeps the inline action in view via the sticky info column —
     the bar is a mobile thumb-zone affordance only */
  @media (min-width: 900px) {
    .pdp-bar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pdp-bar {
      transition: none;
    }
  }

  .specs {
    margin-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .specs > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .specs dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .specs dd {
    font-size: 0.95rem;
  }
  .specs dd a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
  }
  .specs dd a:hover {
    border-color: var(--ink);
  }

  /* ── Related ── */
  .related {
    margin-top: 5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }
  .related-head {
    font-size: 1.4rem;
    margin-bottom: 2.5rem;
  }
  .related-head a {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
  }
  .related-head a:hover {
    border-color: var(--ink);
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 130;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: color-mix(in srgb, var(--ink) 92%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    cursor: zoom-out;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.open {
    opacity: 1;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    cursor: default;
  }
  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: var(--cream);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s var(--ease);
    line-height: 1;
  }
  .lightbox button:hover {
    opacity: 1;
  }
  .lb-close {
    top: 1.25rem;
    right: 1.5rem;
    font-size: 2.4rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    padding: 0 1rem;
  }
  .lb-prev {
    left: 0.5rem;
  }
  .lb-next {
    right: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .pdp-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .info-inner {
      position: static;
    }
    .info-desc {
      max-width: none;
    }
  }
</style>

<script>
  // Gallery + lightbox. Framework-free, scoped to the PDP.
  import { lockScroll } from '@/lib/scrollLock';

  const main = document.getElementById('pdp-main') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.thumb'));
  const zoomBtn = document.querySelector<HTMLButtonElement>('[data-zoom]');
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  const lbImg = lb?.querySelector<HTMLImageElement>('.lb-img');

  type Img = { src: string; alt: string };
  const images: Img[] = lb ? JSON.parse(lb.dataset.images || '[]') : [];
  let current = 0;

  function syncMain() {
    const img = images[current];
    if (main && img) {
      main.src = img.src;
      main.alt = img.alt;
    }
    thumbs.forEach((b, i) => b.setAttribute('aria-pressed', String(i === current)));
  }

  // Thumbnail → swap the main gallery image.
  thumbs.forEach((btn, i) => btn.addEventListener('click', () => { current = i; syncMain(); }));

  // ── Lightbox ──
  function show(i: number) {
    if (!lbImg || !images.length) return;
    current = (i + images.length) % images.length;
    const img = images[current];
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    syncMain();
  }
  function open() {
    if (!lb) return;
    show(current);
    lb.hidden = false;
    requestAnimationFrame(() => lb.classList.add('open'));
    lockScroll(true);
  }
  function close() {
    if (!lb) return;
    lb.classList.remove('open');
    lockScroll(false);
    setTimeout(() => { if (!lb.classList.contains('open')) lb.hidden = true; }, 300);
  }

  // ── Sticky buy bar ──
  // Reveal the bar once the inline action has scrolled out of view above the
  // fold; hide it again when the inline action is back on screen.
  const buyBar = document.querySelector<HTMLElement>('[data-buy-bar]');
  const buyAnchor = document.querySelector<HTMLElement>('[data-buy-anchor]');
  if (buyBar && buyAnchor && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => {
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        buyBar.classList.toggle('show', show);
        buyBar.setAttribute('aria-hidden', String(!show));
      },
      { threshold: 0 },
    );
    io.observe(buyAnchor);
  }

  zoomBtn?.addEventListener('click', open);
  lb?.querySelector('.lb-close')?.addEventListener('click', close);
  lb?.querySelector('.lb-prev')?.addEventListener('click', (e) => { e.stopPropagation(); show(current - 1); });
  lb?.querySelector('.lb-next')?.addEventListener('click', (e) => { e.stopPropagation(); show(current + 1); });
  // Click the backdrop (not the image) to close.
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(current - 1);
    else if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
