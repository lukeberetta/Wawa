---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import { getFeatured, disciplines } from '@/lib/catalog';
import { site } from '@/lib/site';
import { srcset } from '@/lib/img';
import { exhibition } from '@/lib/schema';

const featured = await getFeatured();
const event = site.event;

// Event band: the twelve monoprints scattered around a clear centre, like
// prints laid out on a table. Desktop x/y are the print's top-left as % of the
// band, w its width %; `r` is tilt in deg. Sizes and tilts vary on purpose, and
// two drift into the top/bottom of the centre (cropped by the band edge) so it
// reads as a scatter, not two columns. Phones (`m`) show six, three above the
// copy and three below: x is the print's centre %, t/b rem from that edge, r
// its own tilt. Several hang off the band's edges on purpose (negative t/b, x
// near 0 or 100) so the row never looks set out with a ruler. Prints without
// `m` are desktop-only. Crops: scripts/event-collage.mjs.
type Print = {
  n: number;
  x: number; y: number; w: number; r: number;
  m?: { x: number; w: number; r: number; t?: number; b?: number };
};
const PRINTS: Print[] = [
  // left
  { n: 1, x: 4, y: 7, w: 14, r: -5, m: { x: 11, w: 36, r: -9, t: -1.25 } },
  { n: 4, x: 21, y: 2, w: 8, r: 6, m: { x: 48, w: 24, r: 5, t: 2.4 } },
  { n: 3, x: 13, y: 38, w: 10, r: 3 },
  { n: 6, x: 25, y: 60, w: 8, r: -7 },
  { n: 8, x: 3, y: 62, w: 12, r: 4, m: { x: 15, w: 30, r: 7, b: 0.75 } },
  { n: 10, x: 33, y: 84, w: 9, r: -3 },
  // right
  { n: 5, x: 82, y: 4, w: 13, r: 4, m: { x: 89, w: 32, r: 10, t: 0.25 } },
  { n: 12, x: 66, y: 3, w: 9, r: -4 },
  { n: 2, x: 74, y: 32, w: 9, r: 5 },
  { n: 7, x: 88, y: 38, w: 10, r: -3 },
  { n: 11, x: 79, y: 62, w: 13, r: -4, m: { x: 53, w: 27, r: -6, b: -1.75 } },
  { n: 9, x: 60, y: 85, w: 9, r: 3, m: { x: 91, w: 36, r: -4, b: 2.25 } },
];
const printStyle = ({ x, y, w, r, m }: Print) =>
  [
    `--x:${x}`, `--y:${y}`, `--w:${w}`, `--r:${r}`,
    m && `--mx:${m.x}`, m && `--mw:${m.w}`, m && `--mr:${m.r}`,
    m?.t !== undefined && `--mt:${m.t}rem`,
    m?.b !== undefined && `--mb:${m.b}rem`,
  ].filter(Boolean).join(';');

// Home grid runs in its own order: Surf leads (it's the craft), then
// accessories and art & prints, pulled up because they sell online. Nav,
// footer and the products pills keep the plain `disciplines` order, so this
// stays local. Any handle left out of the list falls to the end.
const HOME_ORDER = ['surf', 'accessories', 'art-prints', 'foil', 'skate', 'kite', 'body-belly'];
const homeDisciplines = [...disciplines].sort(
  (a, b) =>
    (HOME_ORDER.indexOf(a.handle) + 1 || Infinity) - (HOME_ORDER.indexOf(b.handle) + 1 || Infinity),
);

// Instagram mosaic. `area` maps each tile to a named cell in the desktop grid
// (see #instagram CSS); `feat` is the large 2×2 centre. Stand-in imagery from
// /img/insta until a real IG feed is wired; alt is empty (decorative — the link
// already announces itself, and the caption carries the same words visually).
// Images are matched to their cell shape: `a` and `d` are the tall 2×1 columns,
// so they take the shots with a standing subject that survives a portrait crop.
// DOM order is tuned for the mobile flow (feat is full-width, so it must land on
// an even boundary to avoid leaving a hole). Desktop ignores order — it places
// by named grid-area.
const igTiles = [
  { area: 'a', feat: false, img: 'board-to-water', caption: 'Dawn patrol on a wooden log.' },
  { area: 'b', feat: false, img: 'shaping-hands', caption: 'Marking a rail in the workshop.' },
  { area: 'feat', feat: true, img: 'barrel', caption: 'Paulownia, by hand, in Muizenberg.' },
  { area: 'c', feat: false, img: 'barista', caption: 'Coffee and shavings.' },
  { area: 'd', feat: false, img: 'fin-fit', caption: 'Fin in, board down, first light.' },
  { area: 'e', feat: false, img: 'cruiser-catwalk', caption: 'Flat day. Catwalk cruise.' },
  { area: 'f', feat: false, img: 'paipo-kid', caption: 'Starting them early.' },
];
---

<Layout
  current="home"
  overlay={true}
  preloadImage="/hero-poster.jpg"
  schema={event ? [exhibition(event)] : []}
>
  <!-- HERO -->
  <section id="hero" class="grain">
    <!-- The poster is the LCP image and paints on its own. Sources are attached
         by script after `load`, so 2.6MB of video never competes with first
         paint — see the hero-video script below for the size + opt-out rules.
         No source elements here: with them present the browser starts
         fetching regardless of `preload`. -->
    <video
      class="hero-video"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      poster="/hero-poster.jpg"
      aria-hidden="true"
      data-hero-video
    ></video>
    <div class="wrap hero-grid">
      <div class="hero-content">
        <h1><span>Wooden surfboards.</span> <span>Made by hand, shaped by nature.</span></h1>
        <a href="/products" class="link-arrow">
          Find your board <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- EVENT (site.event — null removes it). One job: announce the show and
       sell a print. Full-bleed artwork, the hand lettering as the headline,
       facts kept to three short lines. Full schedule lives on the poster. -->
  {event && (
    <section id="event-home" class="grain" aria-labelledby="event-title">
      <!-- decorative: the prints are for sale on the product page, where each
           is described; here they're texture around the announcement -->
      {PRINTS.map((p) => {
        const src = `/img/event/print-${String(p.n).padStart(2, '0')}.webp`;
        return (
          <img
            class:list={['event-print', { 'event-print--desk': !p.m }]}
            style={printStyle(p)}
            src={src}
            srcset={srcset(src)}
            sizes="(min-width: 1100px) 13vw, 8.5rem"
            alt=""
            width={640}
            height={599}
            loading="lazy"
            decoding="async"
          />
        );
      })}
      <div class="event-inner">
        <!-- Cobus's hand lettering, painted cream through a mask (like the
             signature). The real title stays in the h2 for readers + search. -->
        <h2 id="event-title" class="event-lettering">
          <span>{event.title}</span>
        </h2>
        <p class="event-facts">
          <span>{event.dates}</span>
          <a href={event.mapHref} target="_blank" rel="noopener noreferrer">{event.venue}, {event.locality}</a>
        </p>
        <a href={event.href} class="event-btn">
          {event.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  <!-- RANGE -->
  <section id="range-home">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Our range</p>
        <h2><a href="/products" class="title-link">Find your craft.</a></h2>
      </div>
      <div class="product-grid">
        {homeDisciplines.map((d) => <CategoryCard discipline={d} />)}
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section id="featured-home">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Featured</p>
        <h2><a href="/products" class="title-link">Featured products.</a></h2>
      </div>
      <div class="product-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section id="instagram">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Instagram</p>
        <h2><a href={site.instagram} target="_blank" rel="noopener noreferrer" class="title-link">Around the workshop.</a></h2>
      </div>
    </div>
    <div class="ig-grid">
      {igTiles.map((t) => (
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['ig-tile', 'grain', `ig-tile--${t.area}`, { 'ig-tile--feat': t.feat }]}
          aria-label="View on Instagram"
        >
          <img
            class="ig-img"
            src={`/img/insta/${t.img}.webp`}
            srcset={srcset(`/img/insta/${t.img}.webp`)}
            sizes={t.feat ? '50vw' : '(min-width: 768px) 25vw, 50vw'}
            alt=""
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          />
          {t.caption && (
            <div class="ig-caption">
              <p class="ig-caption-text">{t.caption}</p>
            </div>
          )}
          <svg class="ig-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
        </a>
      ))}
    </div>
  </section>

  <!-- BRAND STATEMENT -->
  <section id="pullquote">
    <div class="wrap">
      <p class="label">Honouring the source</p>
      <p class="quote-text">
        &ldquo;Way out on surfing&rsquo;s fringe sits an
        anachronistic wooden surfboard company, <span class="hl">built on quality, respect for our roots
        and the sanctity of nature.</span> We shape surf craft inspired by the
        hydrodynamic genius of ancient Hawaiian board builders.&rdquo;
      </p>
      <div class="quote-sign">
        <span class="signature" role="img" aria-label="Cobus's signature"></span>
        <p class="quote-attr">Cobus Joubert, Founder</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Same treatment as the footer: surfers photo under a dark ink gradient,
     cream text. The nav switches to cream-on-transparent over this (see Nav). */
  #hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--nav-h);
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    /* poster doubles as the load + reduced-motion fallback behind the video */
    background: var(--ink) url('/hero-poster.jpg') center / cover no-repeat;
    color: #fff;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The brightness/contrast/saturation grade is baked into the video files
       themselves (and the poster). A CSS filter here forces Safari onto a slow
       repaint-per-frame path — full-viewport filtered video stutters even with
       the footage fully buffered. Don't reintroduce one. */
  }
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2): keep the dark
       wash so cream text stays readable over the footage */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.55),
      rgba(26, 20, 16, 0.66)
    );
    background:
      /* top scrim so the nav reads against the footage */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 55%, transparent),
        transparent 22%
      ),
      /* base wash for overall text contrast */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 38%, transparent),
        color-mix(in srgb, var(--ink) 56%, transparent)
      );
  }
  /* film grain over video + gradient, under the text (see .grain) */
  #hero.grain::after {
    z-index: 1;
    --grain-opacity: 0.2;
  }
  #hero .wrap {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  /* one phrase per line; the second wraps at its own measure on phones */
  #hero h1 {
    font-size: clamp(2rem, 1.3rem + 2.85vw, 3.9rem);
    line-height: 1.08;
    margin-bottom: 2.25rem;
  }
  #hero h1 span {
    display: block;
  }
  #hero h1 span:first-child {
    color: var(--accent-bright);
  }
  #hero h1 span + span {
    max-width: 16ch;
  }
  .hero-sub {
    font-size: var(--fs-lead);
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    max-width: 32ch;
    margin-bottom: 2rem;
  }
  #hero .link-arrow {
    color: #fff;
  }

  /* brand statement: no band of its own — it sits in the cream run after
     instagram, on the same rhythm. it closes the page, so it pads its bottom too. */
  #pullquote {
    padding: var(--space-section) 0;
  }
  #pullquote .label {
    margin-bottom: 1.5rem;
  }
  .quote-text {
    font-size: var(--fs-quote);
    max-width: 30ch;
    line-height: 1.15;
  }
  .quote-text .hl {
    color: var(--accent);
  }
  .quote-sign {
    margin-top: 2rem;
  }
  .signature {
    display: block;
    width: clamp(120px, 9rem + 4vw, 190px);
    aspect-ratio: 875 / 260;
    background: var(--ink);
    -webkit-mask: url('/img/signature-cobus.png') no-repeat center / contain;
    mask: url('/img/signature-cobus.png') no-repeat center / contain;
    transform: rotate(-3deg);
    transform-origin: left center;
  }
  .quote-attr {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* featured event: the twelve prints scattered on the nav's grained sand
     (ink type, lettering and button so it reads on the light ground), with one
     centred column in the clearing. built for the phone first: prints sit in
     bands above and below the copy, which the vertical padding reserves. */
  #event-home {
    --event-bg: color-mix(in srgb, var(--warm) 18%, var(--cream));
    --event-muted: color-mix(in srgb, var(--ink) 40%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 11rem var(--wrap-pad);
    background: var(--event-bg);
    color: var(--ink);
  }
  #event-home.grain::after {
    z-index: 1;
    --grain-opacity: 0.3;
  }
  /* each print on a thin paper mat, tilted, with a soft shadow on the sand */
  .event-print {
    position: absolute;
    z-index: 0;
    /* phones anchor by centre, so the row stays balanced once the width cap
       kicks in on tablets */
    left: calc(var(--mx) * 1%);
    translate: -50% 0;
    top: var(--mt, auto);
    bottom: var(--mb, auto);
    width: min(calc(var(--mw) * 1%), 10rem);
    height: auto;
    padding: 0.3rem;
    background: var(--cream);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.3);
    rotate: calc(var(--mr, var(--r)) * 1deg);
  }
  .event-print--desk {
    display: none;
  }
  /* scroll-linked blur-in, same as the footer text: each print sharpens as it
     rises into view and blurs back out on scroll up. `--reveal` (0–1) is set
     per print by the script below; no-JS keeps them sharp. */
  .event-print {
    opacity: calc(0.35 + var(--reveal, 1) * 0.65);
    filter: blur(calc((1 - var(--reveal, 1)) * 12px));
    will-change: opacity, filter;
  }
  /* tablets: prints hit their width cap, so the bands above and below the
     copy need to grow with them */
  @media (min-width: 600px) {
    #event-home {
      padding-block: 14rem;
    }
  }
  /* one centred column; everything hangs off the lettering's centre line */
  .event-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 30rem;
    text-align: center;
  }
  /* the h2 is the shape, filled ink through the mask. text stays in the
     DOM but clipped off, so it's read but never painted. */
  .event-lettering {
    margin: var(--space-lg) auto 0;
    /* inset on phones so the nudged "1st" keeps clear of the gutter */
    width: 88%;
    aspect-ratio: 1400 / 410;
    background: var(--ink);
    -webkit-mask: url('/img/event/monoprint-lettering.png') no-repeat center / contain;
    mask: url('/img/event/monoprint-lettering.png') no-repeat center / contain;
    /* the "1st" hangs off the left of the artwork, so the box centre sits left
       of the word. nudge so "monoprint" + "exhibition" own the centre line. */
    translate: -4% 0;
  }
  .event-lettering span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* two short lines — date, place — so nothing wraps mid-phrase on a phone */
  .event-facts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: var(--space-lg);
    font-size: var(--fs-lead);
    line-height: 1.4;
  }
  .event-facts a {
    border-bottom: 1px solid var(--event-muted);
    transition: border-color 0.25s var(--ease);
  }
  .event-facts a:hover {
    border-color: var(--ink);
  }
  .event-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-lg);
    padding: 0.95rem 1.6rem;
    background: var(--ink);
    color: var(--cream);
    transition: gap 0.3s var(--ease), background 0.25s var(--ease);
  }
  .event-btn:hover {
    gap: 0.9rem;
    background: var(--wood);
  }
  @media (min-width: 900px) {
    .event-inner {
      max-width: 34rem;
    }
    .event-lettering,
    .event-facts,
    .event-btn {
      margin-top: var(--space-xl);
    }
    .event-lettering {
      width: 100%;
    }
  }
  /* wide enough for the side clearings: all twelve ring the copy */
  @media (min-width: 1100px) {
    #event-home {
      min-height: clamp(38rem, 88vh, 54rem);
      padding-block: var(--space-section);
    }
    .event-print,
    .event-print--desk {
      display: block;
      left: calc(var(--x) * 1%);
      translate: none;
      top: calc(var(--y) * 1%);
      bottom: auto;
      width: calc(var(--w) * 1%);
      rotate: calc(var(--r) * 1deg);
    }
  }
  /* hover: the print you point at lifts off the table — straightens a little,
     grows a touch, shadow deepens. pointer devices only; still under
     reduced motion. */
  @media (min-width: 1100px) and (hover: hover) {
    .event-print {
      transition:
        rotate 0.5s var(--ease),
        scale 0.5s var(--ease),
        box-shadow 0.5s var(--ease);
    }
    .event-print:hover {
      z-index: 3;
      rotate: calc(var(--r) * 0.3deg);
      scale: 1.06;
      box-shadow: 0 24px 44px -14px rgba(0, 0, 0, 0.6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-print {
      transition: none;
      opacity: 1;
      filter: none;
    }
  }

  /* one rhythm down the cream run (range → featured → instagram): each
     section pads its top only, so every gap is exactly one --space-section
     instead of stacking two paddings. the quote closes the run. */
  #range-home {
    padding: var(--space-section) 0 0;
  }

  #featured-home {
    padding: var(--space-section) 0 0;
  }
  .section-head {
    margin-bottom: var(--space-xl);
  }
  .section-head h2 {
    font-size: var(--fs-h2);
    margin-top: 0.75rem;
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  /* on the home page the catalog rows scroll horizontally — a full-bleed,
     snap-scrolling rail. cards keep their own hairlines; the container draws
     the top + left frame. card width is set with :global() because the cards
     live in their own component scope, out of reach of a plain child selector. */
  .product-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* lock gestures on the rail to horizontal — a diagonal swipe won't drag the
       page vertically while scrolling cards */
    touch-action: pan-x;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    /* overflow-x scroll forces the y-axis to clip too; 1px of bottom padding
       keeps the cards' own bottom hairline inside the scrollport */
    padding-bottom: 1px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .product-grid::-webkit-scrollbar {
    display: none;
  }
  .product-grid > :global(*) {
    flex: 0 0 66%;
    scroll-snap-align: start;
  }
  @media (min-width: 560px) {
    .product-grid > :global(*) {
      flex-basis: 40%;
    }
  }
  @media (min-width: 900px) {
    .product-grid > :global(*) {
      /* not a clean divisor of 100% — leaves a sliver of the next card so the
         rail always reads as scrollable */
      flex-basis: 22%;
    }
  }
  /* the whole title is the link — no separate "Shop all" / "Follow" */
  .title-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
    transition: text-decoration-color 0.2s var(--ease);
  }
  .title-link:hover {
    text-decoration-color: currentColor;
  }
  /* instagram mosaic: editorial tile wall. mobile is a plain 2-up grid; desktop
     becomes a named-area mosaic with one large 2×2 feature tile. */
  #instagram {
    padding: var(--space-section) 0 0;
  }
  /* tight hairline grid, same frame treatment as .product-grid: the container
     draws the top + left rule, each tile draws its own right + bottom rule, so
     internal lines never double up. */
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .ig-tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--cream);
    /* tone behind the photo, so a slow-loading tile isn't a white hole */
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    border: 0;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  /* cells are fixed tracks of varying shape, so every photo crops to fill —
     tile assignment in the frontmatter picks images that survive their crop. */
  .ig-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the wall reads as one grey mosaic and colour arrives on the tile you point
     at. gated on `hover: hover` — on touch there's no way to bring the colour
     back, so those tiles stay full-colour rather than permanently drained. */
  @media (hover: hover) {
    .ig-img {
      filter: grayscale(1);
      transition: filter 0.5s var(--ease);
    }
    .ig-tile:hover .ig-img,
    .ig-tile:focus-visible .ig-img {
      filter: grayscale(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ig-img {
      transition: none;
    }
  }
  /* mobile: feature spans the full width on its own row so the 2-up flow never
     leaves a hole. */
  .ig-tile--feat {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }
  .ig-glyph {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    width: 22px;
    height: 22px;
    /* cream over photography — the tiles are images now, not a light placeholder,
       so an ink glyph would vanish on the darker ones. shadow keeps it legible
       against a bright sky just as well. */
    color: var(--cream);
    opacity: 0.8;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45));
    pointer-events: none;
    /* above the tile's grain (.grain::after), like the caption */
    z-index: 1;
    transition: color 0.35s var(--ease), opacity 0.35s var(--ease);
  }
  /* caption + gradient are hidden until hover, then fade up over the tile */
  .ig-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 1.25rem 1.25rem 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(26, 20, 16, 0.78));
    color: var(--cream);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }
  @media (hover: hover) {
    .ig-tile:hover .ig-caption,
    .ig-tile:focus-visible .ig-caption {
      opacity: 1;
    }
    /* glyph brightens against the dark gradient while the caption is up */
    .ig-tile:hover .ig-glyph,
    .ig-tile:focus-visible .ig-glyph {
      opacity: 0.92;
    }
  }
  .ig-caption-text {
    font-size: 1.05rem;
    line-height: 1.25;
    max-width: 22ch;
  }
  .ig-caption-src {
    margin-top: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  @media (min-width: 768px) {
    .ig-grid {
      grid-template-columns: repeat(4, 1fr);
      /* fixed, viewport-scaled row tracks. cells fill their track (object-fit
         cover) instead of carrying their own aspect-ratio, so heights line up
         and there are no gaps. feature spans two rows → naturally 2× tall. */
      grid-template-rows: repeat(3, clamp(160px, 17vw, 300px));
      grid-template-areas:
        'a b c d'
        'a feat feat d'
        'e feat feat f';
    }
    /* tiles flow into named cells only at desktop; on mobile the grid-area names
       are absent and tiles fall back to plain 2-up flow order. clearing
       aspect-ratio lets each tile stretch to its grid track. */
    .ig-tile { aspect-ratio: auto; }
    .ig-tile--a { grid-area: a; }
    .ig-tile--b { grid-area: b; }
    .ig-tile--c { grid-area: c; }
    .ig-tile--d { grid-area: d; }
    .ig-tile--e { grid-area: e; }
    .ig-tile--f { grid-area: f; }
    .ig-tile--feat { grid-area: feat; }
  }
</style>

<script>
  import { ambientVideo } from '@/lib/ambientVideo';

  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  // Hero is above the fold, so it attaches as soon as the page settles.
  if (v) ambientVideo(v, { name: 'hero', rootMargin: '0px' });
</script>

<script>
  // Exhibition prints blur into focus on scroll (like the footer text). Each
  // print's page offset is measured on load/resize only; scrolling just reads
  // scrollY, so nothing forces layout per frame.
  const prints = [...document.querySelectorAll<HTMLElement>('.event-print')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prints.length && !reduce) {
    let tops: number[] = [];
    let shown: boolean[] = [];
    let winH = window.innerHeight;
    let ticking = false;

    const compute = () => {
      ticking = false;
      const bottom = window.scrollY + winH;
      // sharp once the print's top is a third of the screen above the fold
      const span = winH * 0.35;
      prints.forEach((el, i) => {
        if (!shown[i]) return;
        const p = Math.min(Math.max((bottom - tops[i]) / span, 0), 1);
        el.style.setProperty('--reveal', p.toFixed(3));
      });
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(compute);
      }
    };
    const remeasure = () => {
      winH = window.innerHeight;
      tops = prints.map((el) => el.getBoundingClientRect().top + window.scrollY);
      // desk-only prints are display:none on phones
      shown = prints.map((el) => el.offsetParent !== null);
      compute();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    if ('ResizeObserver' in window) {
      new ResizeObserver(remeasure).observe(document.body);
    }
    remeasure();
  }
</script>
