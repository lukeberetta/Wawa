---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getFeatured, disciplines } from '@/lib/catalog';

const featured = await getFeatured();
---

<Layout current="home">
  <!-- HERO -->
  <section id="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      poster="/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/hero.mp4" type="video/mp4" />
      <source src="/hero.webm" type="video/webm" />
    </video>
    <div class="wrap hero-grid">
      <div class="hero-content">
        <p class="hero-label fade-in">Wawa Surfboards</p>
        <h1 class="fade-in">Honouring<br />surfing's<br />heritage.</h1>
        <p class="hero-sub fade-in">
          Traditional wooden surfboards. Made by hand, shaped by nature.
        </p>
        <a href="/products" class="link-arrow fade-in">
          Explore the range <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PULL QUOTE -->
  <section id="pullquote">
    <div class="wrap">
      <p class="quote-text fade-in">
        “Centuries ago, the first Polynesian surfers carved their boards from native timber, guided
        by instinct, respect and a connection to the ocean. At Wawa, that spirit lives on.”
      </p>
      <p class="quote-attr fade-in">Cobus Joubert, Founder</p>
    </div>
  </section>

  <!-- RANGE -->
  <section id="range-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">The range</p>
        <h2>Every craft.</h2>
      </div>
      <ul class="discipline-list">
        {
          disciplines.map((d) => (
            <li>
              <a href={`/products/${d.handle}`}>
                <span class="arrow fade-in">→</span>
                <div class="disc-inner fade-in">
                  <h3>{d.title}</h3>
                  <p>{d.blurb}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FEATURED -->
  <section id="featured-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Favourites</p>
        <h2>Most ridden.</h2>
      </div>
      <div class="product-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="section-foot fade-in">
        <a href="/products" class="link-arrow">View all products <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Same treatment as the footer: surfers photo under a dark ink gradient,
     cream text. The nav switches to cream-on-transparent over this (see Nav). */
  #hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
    /* poster doubles as the load + reduced-motion fallback behind the video */
    background: var(--ink) url('/hero-poster.jpg') center / cover no-repeat;
    color: var(--cream);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.72) contrast(1.32) saturate(1.1);
  }
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2): keep the dark
       wash so cream text stays readable over the footage */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.55),
      rgba(26, 20, 16, 0.66)
    );
    background:
      /* top scrim so the nav reads against the footage */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 55%, transparent),
        transparent 22%
      ),
      /* base wash for overall text contrast */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 45%, transparent),
        color-mix(in srgb, var(--ink) 62%, transparent)
      );
  }
  #hero .wrap {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  .hero-label {
    margin-bottom: 1.5rem;
  }
  #hero h1 {
    font-size: clamp(3rem, 9vw, 7rem);
    margin-bottom: 1.5rem;
  }
  .hero-sub {
    font-size: 1.15rem;
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    max-width: 32ch;
    margin-bottom: 2rem;
  }
  #hero .link-arrow {
    color: var(--cream);
  }

  #pullquote {
    padding: clamp(6rem, 16vw, 11rem) 0;
    border-bottom: 1px solid var(--rule);
  }
  .quote-text {
    font-size: clamp(1.4rem, 3.2vw, 2.3rem);
    max-width: 30ch;
    line-height: 1.3;
  }
  .quote-attr {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  #range-home {
    padding: 5rem 0 1rem;
  }
  .discipline-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 900px) {
    .discipline-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .discipline-list {
      grid-template-columns: 1fr;
    }
  }
  .discipline-list a {
    display: block;
    background: var(--cream);
    padding: 1.75rem;
    height: 100%;
    position: relative;
    transition: background 0.3s var(--ease);
  }
  .discipline-list a:hover {
    background: color-mix(in srgb, var(--warm) 7%, var(--cream));
  }
  .discipline-list h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .discipline-list p {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 34ch;
  }
  .discipline-list .arrow {
    position: absolute;
    top: 1.75rem;
    right: 1.75rem;
    color: var(--warm);
  }

  #featured-home {
    padding: 5rem 0;
  }
  .section-head {
    margin-bottom: 3rem;
  }
  .section-head h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-top: 0.75rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 2.5rem 1.75rem;
  }
  .section-foot {
    margin-top: 3rem;
  }
</style>

<script>
  // Some browsers (Safari, low-power modes) ignore the autoplay attribute.
  // Force muted playback and retry on the first ready/interaction signal.
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  if (v) {
    v.muted = true;
    const play = () => v.play().catch(() => {});
    play();
    v.addEventListener('canplay', play, { once: true });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) play();
    });
    ['touchstart', 'pointerdown', 'scroll'].forEach((e) =>
      window.addEventListener(e, play, { once: true, passive: true }),
    );
  }
</script>
