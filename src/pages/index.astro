---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import { getFeatured, disciplines } from '@/lib/catalog';

const featured = await getFeatured();
---

<Layout current="home">
  <!-- HERO -->
  <section id="hero">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      poster="/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/hero.mp4" type="video/mp4" />
      <source src="/hero.webm" type="video/webm" />
    </video>
    <div class="wrap hero-grid">
      <div class="hero-content">
        <h1 class="fade-in">Honouring<br />surfing's<br />heritage.</h1>
        <p class="hero-sub fade-in">
          Traditional wooden surfboards.<br />Made by hand, shaped by nature.
        </p>
        <a href="/products" class="link-arrow fade-in">
          Explore the range <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BRAND STATEMENT -->
  <section id="pullquote">
    <div class="wrap">
      <p class="label fade-in">Honouring the source</p>
      <p class="quote-text fade-in">
        &ldquo;Way out on the split ends of surfing&rsquo;s fringe sits an anachronistic little
        wooden surfboard company, built on quality, respect for our roots and a belief in the
        sanctity of nature. We shape boards and surf craft inspired by the intuited
        hydrodynamic genius of the ancient Hawaiian board builders.&rdquo;
      </p>
      <p class="quote-attr fade-in">Cobus Joubert, Founder</p>
    </div>
  </section>

  <!-- RANGE -->
  <section id="range-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Our range</p>
        <h2>Categories.</h2>
      </div>
      <div class="product-grid">
        {disciplines.map((d) => <CategoryCard discipline={d} />)}
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section id="featured-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Featured</p>
        <h2>Best sellers.</h2>
      </div>
      <div class="product-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="section-foot fade-in">
        <a href="/products" class="link-arrow">View all products <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- PERKS -->
  <section id="perks">
    <ul class="perks">
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 4 13C4 7 10 4 17 4c0 7-3 13-9 13Z" />
          <path d="M4 20c2-4 5-6.5 8-7.5" />
        </svg>
        <p>Shaped by hand from timber</p>
      </li>
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
        </svg>
        <p>Shipped worldwide</p>
      </li>
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20h4L18.5 9.5a2.12 2.12 0 0 0-3-3L5 17v3Z" />
          <path d="M13.5 8 16 10.5" />
        </svg>
        <p>Custom builds welcome</p>
      </li>
    </ul>
  </section>
</Layout>

<style>
  /* Same treatment as the footer: surfers photo under a dark ink gradient,
     cream text. The nav switches to cream-on-transparent over this (see Nav). */
  #hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-h);
    /* poster doubles as the load + reduced-motion fallback behind the video */
    background: var(--ink) url('/hero-poster.jpg') center / cover no-repeat;
    color: var(--cream);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.74) contrast(1.55) saturate(1.25);
    /* Force a compositor layer. iOS Safari can render a CSS-filtered <video> as
       a frozen first frame (decodes but never repaints); promoting it to the
       GPU path keeps the footage live. No visual change. */
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2): keep the dark
       wash so cream text stays readable over the footage */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.55),
      rgba(26, 20, 16, 0.66)
    );
    background:
      /* top scrim so the nav reads against the footage */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 55%, transparent),
        transparent 22%
      ),
      /* base wash for overall text contrast */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 38%, transparent),
        color-mix(in srgb, var(--ink) 56%, transparent)
      );
  }
  #hero .wrap {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  #hero h1 {
    font-size: var(--fs-display);
    margin-bottom: 2.25rem;
  }
  .hero-sub {
    font-size: var(--fs-lead);
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    max-width: 32ch;
    margin-bottom: 2rem;
  }
  #hero .link-arrow {
    color: var(--cream);
  }

  #pullquote {
    padding: var(--space-section) 0;
    border-bottom: 1px solid var(--rule);
  }
  #pullquote .label {
    margin-bottom: 1.5rem;
  }
  .quote-text {
    font-size: var(--fs-quote);
    max-width: 30ch;
    line-height: 1.15;
  }
  .quote-attr {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  #range-home {
    padding: var(--space-section) 0 var(--space-sm);
  }

  #featured-home {
    padding: var(--space-section) 0;
  }
  .section-head {
    margin-bottom: var(--space-xl);
  }
  .section-head h2 {
    font-size: var(--fs-h2);
    margin-top: 0.75rem;
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  /* on the home page the catalog rows scroll horizontally — a full-bleed,
     snap-scrolling rail. cards keep their own hairlines; the container draws
     the top + left frame. card width is set with :global() because the cards
     live in their own component scope, out of reach of a plain child selector. */
  .product-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    /* overflow-x scroll forces the y-axis to clip too; 1px of bottom padding
       keeps the cards' own bottom hairline inside the scrollport */
    padding-bottom: 1px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .product-grid::-webkit-scrollbar {
    display: none;
  }
  .product-grid > :global(*) {
    flex: 0 0 66%;
    scroll-snap-align: start;
  }
  @media (min-width: 560px) {
    .product-grid > :global(*) {
      flex-basis: 40%;
    }
  }
  @media (min-width: 900px) {
    .product-grid > :global(*) {
      /* not a clean divisor of 100% — leaves a sliver of the next card so the
         rail always reads as scrollable */
      flex-basis: 22%;
    }
  }
  .section-foot {
    margin-top: 3rem;
    text-align: center;
  }

  /* perks strip: full-bleed hairline band. mobile-first — stacked with
     horizontal dividers, becoming a 3-up row with vertical dividers. */
  .perks {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    margin-inline: calc(50% - 50vw);
    border-block: 1px solid var(--rule);
  }
  .perk {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 2rem var(--wrap-pad);
  }
  .perk:not(:last-child) {
    border-bottom: 1px solid var(--rule);
  }
  .perk-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--ink);
  }
  .perk p {
    font-size: 1rem;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    .perks {
      grid-template-columns: repeat(3, 1fr);
    }
    .perk:not(:last-child) {
      border-bottom: none;
      border-right: 1px solid var(--rule);
    }
  }
</style>

<script>
  // Some browsers (iOS Safari, low-power modes) ignore the autoplay attribute.
  // Be relentless about muted inline playback without ever throwing.
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  if (v) {
    // iOS honours muted inline autoplay only when these are unambiguous — pin
    // them as properties *and* attributes before the first play() attempt.
    v.muted = true;
    v.defaultMuted = true;
    v.playsInline = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');

    let playing = false;
    const play = () => {
      if (playing) return;
      const p = v.play();
      if (p && typeof p.then === 'function') {
        p.then(() => { playing = true; }).catch(() => {});
      }
    };

    // Try now, then again every time the element gains data — iOS routinely
    // rejects the first call before anything is buffered.
    play();
    ['loadedmetadata', 'loadeddata', 'canplay', 'canplaythrough'].forEach((e) =>
      v.addEventListener(e, play),
    );
    // Timed nudges cover a buffer finishing without firing a fresh event.
    [200, 600, 1200, 2500].forEach((t) => setTimeout(play, t));

    // Resume after the tab/app returns to the foreground.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) play();
    });

    // Last resort where autoplay is gated (Low Power Mode): the first real
    // gesture unlocks it.
    ['touchstart', 'pointerdown', 'scroll', 'click'].forEach((e) =>
      window.addEventListener(e, play, { once: true, passive: true }),
    );

    // Scrolled back into view but paused? Kick it again.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((ents) =>
        ents.forEach((en) => {
          if (en.isIntersecting && v.paused) { playing = false; play(); }
        }),
      ).observe(v);
    }
  }
</script>
