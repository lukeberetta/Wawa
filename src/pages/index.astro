---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import { getFeatured, disciplines } from '@/lib/catalog';
import { site } from '@/lib/site';

const featured = await getFeatured();

// Instagram mosaic. `area` maps each tile to a named cell in the desktop grid
// (see #instagram CSS); `feat` is the large 2×2 centre. Stand-in imagery from
// /img/insta until a real IG feed is wired; alt is empty (decorative — the link
// already announces itself, and the caption carries the same words visually).
// Images are matched to their cell shape: `a` and `d` are the tall 2×1 columns,
// so they take the shots with a standing subject that survives a portrait crop.
// DOM order is tuned for the mobile flow (feat is full-width, so it must land on
// an even boundary to avoid leaving a hole). Desktop ignores order — it places
// by named grid-area.
const igTiles = [
  { area: 'a', feat: false, img: 'board-to-water', caption: 'Dawn patrol on a wooden log.' },
  { area: 'b', feat: false, img: 'shaping-hands', caption: 'Marking a rail in the workshop.' },
  { area: 'feat', feat: true, img: 'barrel', caption: 'Paulownia, by hand, in Muizenberg.' },
  { area: 'c', feat: false, img: 'barista', caption: 'Coffee and shavings.' },
  { area: 'd', feat: false, img: 'fin-fit', caption: 'Fin in, board down, first light.' },
  { area: 'e', feat: false, img: 'skate-pan', caption: 'Flat day. Catwalk cruise.' },
  { area: 'f', feat: false, img: 'paipo-kid', caption: 'Starting them early.' },
];
---

<Layout current="home" overlay={true}>
  <!-- HERO -->
  <section id="hero">
    <!-- The poster is the LCP image and paints on its own. Sources are attached
         by script after `load`, so 2.6MB of video never competes with first
         paint — see the hero-video script below for the size + opt-out rules.
         No source elements here: with them present the browser starts
         fetching regardless of `preload`. -->
    <video
      class="hero-video"
      muted
      loop
      playsinline
      webkit-playsinline
      preload="none"
      poster="/hero-poster.jpg"
      aria-hidden="true"
      data-hero-video
    ></video>
    <div class="wrap hero-grid">
      <div class="hero-content">
        <h1 class="fade-in">A return to how surfboards were meant to be built, <span class="accent">and felt.</span></h1>
        <a href="/products" class="link-arrow fade-in">
          Find your board <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BRAND STATEMENT -->
  <section id="pullquote">
    <div class="wrap">
      <p class="label fade-in">Honouring the source</p>
      <p class="quote-text fade-in">
        &ldquo;Way out on the split ends of surfing&rsquo;s fringe sits an anachronistic little
        wooden surfboard company, built on quality, respect for our roots and a belief in the
        sanctity of nature. We shape boards and surf craft inspired by the intuited
        hydrodynamic genius of the ancient Hawaiian board builders.&rdquo;
      </p>
      <p class="quote-attr fade-in">Cobus Joubert, Founder</p>
    </div>
  </section>

  <!-- RANGE -->
  <section id="range-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Our range</p>
        <h2>Categories.</h2>
      </div>
      <div class="product-grid">
        {disciplines.map((d) => <CategoryCard discipline={d} />)}
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  <section id="featured-home">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Featured</p>
        <h2>Best sellers.</h2>
      </div>
      <div class="product-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="section-foot fade-in">
        <a href="/products" class="link-arrow">View all products <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section id="instagram">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Instagram</p>
        <h2>From the feed.</h2>
      </div>
    </div>
    <div class="ig-grid fade-in">
      {igTiles.map((t) => (
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['ig-tile', `ig-tile--${t.area}`, { 'ig-tile--feat': t.feat }]}
          aria-label="View on Instagram"
        >
          <img class="ig-img" src={`/img/insta/${t.img}.webp`} alt="" loading="lazy" decoding="async" />
          {t.caption && (
            <div class="ig-caption">
              <p class="ig-caption-text">{t.caption}</p>
              <p class="ig-caption-src">From Instagram</p>
            </div>
          )}
          <svg class="ig-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
        </a>
      ))}
    </div>
    <div class="wrap">
      <div class="section-foot fade-in">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="link-arrow">
          Follow along <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PERKS -->
  <section id="perks">
    <ul class="perks">
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 20A7 7 0 0 1 4 13C4 7 10 4 17 4c0 7-3 13-9 13Z" />
          <path d="M4 20c2-4 5-6.5 8-7.5" />
        </svg>
        <p>Shaped by hand from timber</p>
      </li>
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" />
        </svg>
        <p>Shipped worldwide</p>
      </li>
      <li class="perk fade-in">
        <svg class="perk-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20h4L18.5 9.5a2.12 2.12 0 0 0-3-3L5 17v3Z" />
          <path d="M13.5 8 16 10.5" />
        </svg>
        <p>Custom builds welcome</p>
      </li>
    </ul>
  </section>
</Layout>

<style>
  /* Same treatment as the footer: surfers photo under a dark ink gradient,
     cream text. The nav switches to cream-on-transparent over this (see Nav). */
  #hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--nav-h);
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    /* poster doubles as the load + reduced-motion fallback behind the video */
    background: var(--ink) url('/hero-poster.jpg') center / cover no-repeat;
    color: var(--cream);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The brightness/contrast/saturation grade is baked into the video files
       themselves (and the poster). A CSS filter here forces Safari onto a slow
       repaint-per-frame path — full-viewport filtered video stutters even with
       the footage fully buffered. Don't reintroduce one. */
  }
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2): keep the dark
       wash so cream text stays readable over the footage */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.55),
      rgba(26, 20, 16, 0.66)
    );
    background:
      /* top scrim so the nav reads against the footage */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 55%, transparent),
        transparent 22%
      ),
      /* base wash for overall text contrast */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 38%, transparent),
        color-mix(in srgb, var(--ink) 56%, transparent)
      );
  }
  #hero .wrap {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
  #hero h1 {
    font-size: var(--fs-display);
    line-height: 1.04;
    max-width: 15ch;
    margin-bottom: 2.25rem;
  }
  .hero-sub {
    font-size: var(--fs-lead);
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    max-width: 32ch;
    margin-bottom: 2rem;
  }
  #hero h1 .accent {
    color: var(--accent);
  }
  #hero .link-arrow {
    color: var(--cream);
  }

  #pullquote {
    padding: var(--space-section) 0;
    border-bottom: 1px solid var(--rule);
  }
  #pullquote .label {
    margin-bottom: 1.5rem;
  }
  .quote-text {
    font-size: var(--fs-quote);
    max-width: 30ch;
    line-height: 1.15;
  }
  .quote-attr {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  #range-home {
    padding: var(--space-section) 0 var(--space-sm);
  }

  #featured-home {
    padding: var(--space-section) 0;
  }
  .section-head {
    margin-bottom: var(--space-xl);
  }
  .section-head h2 {
    font-size: var(--fs-h2);
    margin-top: 0.75rem;
  }
  /* full-bleed catalog grid: breaks out of the wrap to span the viewport edge
     to edge. cells draw their own right + bottom rules (see ProductCard); the
     container supplies only the top + left frame. */
  /* on the home page the catalog rows scroll horizontally — a full-bleed,
     snap-scrolling rail. cards keep their own hairlines; the container draws
     the top + left frame. card width is set with :global() because the cards
     live in their own component scope, out of reach of a plain child selector. */
  .product-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* lock gestures on the rail to horizontal — a diagonal swipe won't drag the
       page vertically while scrolling cards */
    touch-action: pan-x;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    /* overflow-x scroll forces the y-axis to clip too; 1px of bottom padding
       keeps the cards' own bottom hairline inside the scrollport */
    padding-bottom: 1px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .product-grid::-webkit-scrollbar {
    display: none;
  }
  .product-grid > :global(*) {
    flex: 0 0 66%;
    scroll-snap-align: start;
  }
  @media (min-width: 560px) {
    .product-grid > :global(*) {
      flex-basis: 40%;
    }
  }
  @media (min-width: 900px) {
    .product-grid > :global(*) {
      /* not a clean divisor of 100% — leaves a sliver of the next card so the
         rail always reads as scrollable */
      flex-basis: 22%;
    }
  }
  .section-foot {
    margin-top: 3rem;
    text-align: center;
  }
  /* no fade-up entrance on the home carousels — heads, foot and cards sit
     in place. (ProductCard's .fade-in is global, hence :global) */
  html.js #range-home :global(.fade-in),
  html.js #featured-home :global(.fade-in) {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* instagram mosaic: editorial tile wall. mobile is a plain 2-up grid; desktop
     becomes a named-area mosaic with one large 2×2 feature tile. */
  #instagram {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--rule);
  }
  /* tight hairline grid, same frame treatment as .product-grid: the container
     draws the top + left rule, each tile draws its own right + bottom rule, so
     internal lines never double up. */
  .ig-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .ig-tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    color: var(--cream);
    /* tone behind the photo, so a slow-loading tile isn't a white hole */
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    border: 0;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  /* cells are fixed tracks of varying shape, so every photo crops to fill —
     tile assignment in the frontmatter picks images that survive their crop. */
  .ig-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the wall reads as one grey mosaic and colour arrives on the tile you point
     at. gated on `hover: hover` — on touch there's no way to bring the colour
     back, so those tiles stay full-colour rather than permanently drained. */
  @media (hover: hover) {
    .ig-img {
      filter: grayscale(1);
      transition: filter 0.5s var(--ease);
    }
    .ig-tile:hover .ig-img,
    .ig-tile:focus-visible .ig-img {
      filter: grayscale(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ig-img {
      transition: none;
    }
  }
  /* mobile: feature spans the full width on its own row so the 2-up flow never
     leaves a hole. */
  .ig-tile--feat {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }
  .ig-glyph {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    width: 22px;
    height: 22px;
    /* cream over photography — the tiles are images now, not a light placeholder,
       so an ink glyph would vanish on the darker ones. shadow keeps it legible
       against a bright sky just as well. */
    color: var(--cream);
    opacity: 0.8;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45));
    pointer-events: none;
    transition: color 0.35s var(--ease), opacity 0.35s var(--ease);
  }
  /* caption + gradient are hidden until hover, then fade up over the tile */
  .ig-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    padding: 1.25rem 1.25rem 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(26, 20, 16, 0.78));
    color: var(--cream);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }
  @media (hover: hover) {
    .ig-tile:hover .ig-caption,
    .ig-tile:focus-visible .ig-caption {
      opacity: 1;
    }
    /* glyph brightens against the dark gradient while the caption is up */
    .ig-tile:hover .ig-glyph,
    .ig-tile:focus-visible .ig-glyph {
      opacity: 0.92;
    }
  }
  .ig-caption-text {
    font-size: 1.05rem;
    line-height: 1.25;
    max-width: 22ch;
  }
  .ig-caption-src {
    margin-top: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  @media (min-width: 768px) {
    .ig-grid {
      grid-template-columns: repeat(4, 1fr);
      /* fixed, viewport-scaled row tracks. cells fill their track (object-fit
         cover) instead of carrying their own aspect-ratio, so heights line up
         and there are no gaps. feature spans two rows → naturally 2× tall. */
      grid-template-rows: repeat(3, clamp(160px, 17vw, 300px));
      grid-template-areas:
        'a b c d'
        'a feat feat d'
        'e feat feat f';
    }
    /* tiles flow into named cells only at desktop; on mobile the grid-area names
       are absent and tiles fall back to plain 2-up flow order. clearing
       aspect-ratio lets each tile stretch to its grid track. */
    .ig-tile { aspect-ratio: auto; }
    .ig-tile--a { grid-area: a; }
    .ig-tile--b { grid-area: b; }
    .ig-tile--c { grid-area: c; }
    .ig-tile--d { grid-area: d; }
    .ig-tile--e { grid-area: e; }
    .ig-tile--f { grid-area: f; }
    .ig-tile--feat { grid-area: feat; }
  }

  /* perks strip: full-bleed hairline band. mobile-first — stacked with
     horizontal dividers, becoming a 3-up row with vertical dividers. */
  .perks {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    margin-inline: calc(50% - 50vw);
    border-block: 1px solid var(--rule);
  }
  .perk {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 2rem var(--wrap-pad);
  }
  .perk:not(:last-child) {
    border-bottom: 1px solid var(--rule);
  }
  .perk-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--ink);
  }
  .perk p {
    font-size: 1rem;
    line-height: 1.3;
  }
  @media (min-width: 768px) {
    .perks {
      grid-template-columns: repeat(3, 1fr);
    }
    .perk:not(:last-child) {
      border-bottom: none;
      border-right: 1px solid var(--rule);
    }
  }
</style>

<script>
  import { ambientVideo } from '@/lib/ambientVideo';

  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  // Hero is above the fold, so it attaches as soon as the page settles.
  if (v) ambientVideo(v, { name: 'hero', rootMargin: '0px' });
</script>
