---
import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import VideoCard from '@/components/VideoCard.astro';
import { videos } from '@/data/videos';
import { getCollection } from 'astro:content';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long' });
// External coverage shows its masthead; Wawa's own writing shares one label.
const source = (p: (typeof posts)[number]) => p.data.publication ?? 'Wawa Journal';
---

<Layout
  title="Press · Wawa Surfboards"
  description="Letters, essays and stories from the Wawa workshop: surfing history, sustainable craft and the people behind the boards."
  current="press"
  overlay={true}
>
  <PageHero
    src="/img/press/barrel-ride.webp"
    alt="A surfer crouched inside a teal barrel on a wooden board, shot from the water"
    width={2200}
    height={1470}
  >
    Words about the wood, <span class="accent">film from the water.</span>
  </PageHero>

  <!-- FILMS -->
  <section id="films">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Watch</p>
        <h2>On film.</h2>
        <p class="section-lead">
          Documentary crews and surf channels who came to Muizenberg, filmed the workshop, and
          followed the boards into the water.
        </p>
      </div>
      <div class="video-grid">
        {videos.map((video) => <VideoCard video={video} />)}
      </div>
    </div>
  </section>

  <section id="posts">
    <div class="wrap">
      <div class="section-head fade-in">
        <p class="label">Read</p>
        <h2>In words.</h2>
        <p class="section-lead">
          Features and interviews from the surf press, alongside letters and essays written in the
          workshop.
        </p>
      </div>
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="fade-in" id={`post-${post.id}`}>
              <a href={`/press/${post.id}`}>
                <p class="post-pub">
                  {source(post)}
                  <span class="post-date"> · {fmtDate(post.data.date)}</span>
                </p>
                <h2>{post.data.title}</h2>
                <p class="post-excerpt">{post.data.excerpt}</p>
                <p class="post-author">Words by {post.data.author}</p>
              </a>
            </li>
          ))
        }
      </ul>

      {posts.length === 0 && <p class="empty fade-in">Press coverage coming soon.</p>}
    </div>
  </section>
</Layout>

<style>
  /* label, title, body — the same three beats the story and cafe pages run on */
  .section-head {
    margin-bottom: 2.5rem;
  }
  .section-head h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 0.75rem;
  }
  .section-lead {
    margin-top: 1.5rem;
    max-width: 44ch;
  }
  /* the hero runs to the viewport edge, so the first section opens on its own
     section pad */
  #films {
    padding: var(--space-section) 0 4rem;
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem 1.75rem;
  }
  #posts {
    padding: 4rem 0 5rem;
    border-top: 1px solid var(--rule);
  }
  .post-list {
    list-style: none;
  }
  .post-list li {
    border-top: 1px solid var(--rule);
    /* the back link lands on a row by id — clear the fixed header, and leave a
       little air so the row doesn't sit jammed under it */
    scroll-margin-top: calc(var(--nav-h) + 2rem);
  }
  .post-list li:first-child {
    border-top: none;
  }
  .post-list a {
    display: block;
    padding: 2.25rem 0;
    transition: padding-left 0.3s var(--ease);
  }
  .post-list a:hover {
    padding-left: 1rem;
  }
  .post-pub {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 0.5rem;
  }
  .post-date {
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    padding: 2rem 0;
  }
  .post-list h2 {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    margin-bottom: 0.75rem;
  }
  .post-excerpt {
    color: var(--muted);
    max-width: 60ch;
  }
  .post-author {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
