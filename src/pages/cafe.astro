---
import Layout from '@/layouts/Layout.astro';
import Gallery from '@/components/Gallery.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/lib/site';
import { breadcrumbs } from '@/lib/schema';

// The room, opening on the counter and the window seat, with the machine and
// the board wall further in.
const room = [
  {
    src: '/img/cafe/counter.webp',
    alt: 'Behind the counter at the Wawa cafe, boards and wetsuits either side',
    width: 1100,
    height: 1650,
    caption: 'Lenny pulls the best coffee in Muizenberg. Ask anyone.',
  },
  {
    src: '/img/cafe/window-seat.webp',
    alt: 'A customer on a stool at the window counter with a coffee, Muizenberg outside',
    width: 1000,
    height: 1500,
    caption: 'The window seat, and the whole of Main Road going past it.',
  },
  {
    src: '/img/cafe/wetsuits.webp',
    alt: 'Wawa Geoprene wetsuit jackets hanging on a rail in the workshop',
    width: 1100,
    height: 1650,
    caption: 'Geoprene jackets, on the rail and ready for the 14°C mornings.',
  },
  {
    src: '/img/cafe/barista.webp',
    alt: 'Barista pulling a shot on the red espresso machine, boards on the wall behind',
    width: 1800,
    height: 1350,
    caption: 'Come for the coffee, stay for Lenny’s chat.',
  },
  {
    src: '/img/cafe/board-wall.webp',
    alt: 'A wall of finished paulownia surfboards standing in the Wawa shop',
    width: 1800,
    height: 1200,
    caption: 'Everything on the wall is for sale, and everything on the wall gets surfed.',
  },
];
---

<Layout
  title="Cafe · Wawa Surfboards"
  description="Coffee, cake and wooden boards in Muizenberg. The Wawa cafe, where the workshop meets the water."
  current="cafe"
  overlay={true}
  schema={[breadcrumbs([{ name: 'Cafe' }])]}
>
  <PageHero
    src="/img/cafe/storefront.webp"
    alt="The Wawa Workshop shopfront in Muizenberg, a surfer walking past with a wooden board"
    width={2200}
    height={1467}
  >
    Where the workshop <span class="accent">meets the water.</span>
  </PageHero>

  <section id="cafe-body">
    <div class="wrap">
      <div class="sec-head fade-in">
        <p class="label">Cafe</p>
        <h2>Coffee, cake<br />and craft.</h2>
      </div>

      <div class="cols grid-2 fade-in">
        <div>
          <p>
            Start the day the Muizenberg way: slow and salty. A working surfboard workshop and a café
            under one roof, with locally roasted coffee, cake made in-house, and the smell of sawdust
            and salt. No rush. Surf time runs slow.
          </p>
        </div>
        <div>
          <p>
            Find us at {site.location}. Open from early, every surfable day. Order a coffee and watch
            the boards take shape.
          </p>
        </div>
      </div>
    </div>

    <div class="wrap">
      <Gallery shots={room} label="Photographs from inside the Wawa cafe" />
    </div>
  </section>
</Layout>

<style>
  /* the hero runs to the viewport edge, so the body opens on its own section
     pad; it closes on the rail, which needs no space under it */
  #cafe-body {
    padding: var(--space-section) 0 0;
  }
  /* label, title, body — the same three beats the story page runs on */
  .sec-head {
    margin-bottom: 2.5rem;
  }
  .sec-head h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 0.75rem;
  }
  /* tracks come from .grid-2 */
  .cols {
    margin-bottom: 3rem;
  }
  .cols p {
    color: var(--ink);
  }
</style>
