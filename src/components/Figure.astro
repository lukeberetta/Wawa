---
/**
 * One photograph, edge to edge — the full stop between blocks of copy on the
 * editorial pages. Deliberately the only image on its row: after a rail of
 * small frames, a single wide one is what resets the eye.
 */
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  /** page's opening image carries the LCP */
  eager?: boolean;
}
const { src, alt, width, height, caption, eager = false } = Astro.props;
---

<figure class="bleed fade-in">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
  {
    caption && (
      <figcaption>
        <span class="wrap-inner">{caption}</span>
      </figcaption>
    )
  }
</figure>

<style>
  .bleed {
    margin-inline: calc(50% - 50vw);
  }
  /* a fixed band rather than the photo's own ratio: full-bleed at 3:2 is a
     wall of image on a laptop, and the crop is always the sky or the floor */
  .bleed img {
    width: 100%;
    height: clamp(320px, 62vh, 640px);
    object-fit: cover;
    border-block: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 7%, var(--cream));
  }
  figcaption {
    padding-inline: var(--wrap-pad);
    margin-top: 0.85rem;
    font-size: var(--fs-caption);
    color: var(--muted);
  }
  .wrap-inner {
    display: block;
    max-width: 44ch;
  }
</style>
