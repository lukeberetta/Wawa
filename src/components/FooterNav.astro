---
/**
 * In-flow sitemap band — the last block of <main>, so it scrolls normally and
 * then the fixed curtain Footer reveals beneath it. Gives the site the real
 * wayfinding it was missing (footer had zero links) without diluting the
 * "Made slowly. Ridden forever." brand moment.
 */
import { site } from '@/lib/site';
import { disciplines } from '@/lib/catalog';
import Signup from '@/components/Signup.astro';
import PaymentIcons from '@/components/PaymentIcons.astro';

const year = new Date().getFullYear();

// Store policies live on Shopify (they're also linked from checkout); the site
// must surface them too — ECTA wants returns/privacy reachable before purchase.
const policy = (handle: string) => `https://${site.shopDomain}/policies/${handle}`;
const policies = [
  { handle: 'shipping-policy', label: 'Shipping' },
  { handle: 'refund-policy', label: 'Returns' },
  { handle: 'privacy-policy', label: 'Privacy' },
  { handle: 'terms-of-service', label: 'Terms' },
];
---

<section class="footer-nav" aria-label="Site links">
  <div class="wrap footer-nav-inner">
    <div class="fn-cols">
      <nav class="fn-links" aria-label="Footer">
        <div class="fn-col">
          <p class="label fn-head">Shop</p>
          <ul>
            <li><a href="/products">All products</a></li>
            {disciplines.map((d) => (
              <li><a href={`/products?discipline=${d.handle}`}>{d.title}</a></li>
            ))}
          </ul>
        </div>
        <div class="fn-col">
          <p class="label fn-head">Visit</p>
          <ul>
            <li><a href="/story">Story</a></li>
            <li><a href="/cafe">Cafe</a></li>
            <li><a href="/press">Press</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        {site.shopDomain && (
          <div class="fn-col">
            <p class="label fn-head">Help</p>
            <ul>
              {policies.map((p) => (
                <li><a href={policy(p.handle)} target="_blank" rel="noopener noreferrer">{p.label}</a></li>
              ))}
            </ul>
          </div>
        )}
        <div class="fn-col fn-col-reach">
          <p class="label fn-head">Reach us</p>
          <ul>
            <li><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
            <li><a href="https://maps.app.goo.gl/Jwke2sXBTwRAiVhn6" target="_blank" rel="noopener noreferrer">Google Maps</a></li>
          </ul>
        </div>
      </nav>
      <div class="fn-col fn-col-signup">
        <p class="label fn-head">In the loop</p>
        <Signup source="footer" />
      </div>
    </div>
  </div>
  <!-- base bar: full-bleed hairline, copyright left, checkout trust right -->
  <div class="fn-base grain">
    <div class="wrap fn-base-inner">
      <p class="fn-meta">© {year} {site.name}</p>
      {site.salesOpen && (
        <div class="fn-secure">
          <p class="fn-meta">
            <svg class="fn-lock" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
              <rect x="3" y="7" width="10" height="7.5" rx="1.25" fill="currentColor" />
              <path d="M5.25 7V5a2.75 2.75 0 0 1 5.5 0v2" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            Secure checkout by Shopify.<span class="fn-secure-more"> Your card details are encrypted and never stored by us.</span>
          </p>
          <PaymentIcons shopify />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* sits at the very bottom of main, on the cream surface, framed by a top
     hairline; the curtain footer reveals below it on scroll */
  .footer-nav {
    /* pull up 1px so this top hairline overlaps the preceding block's bottom
       rule instead of stacking into a doubled 2px line */
    margin-top: -1px;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2xl);
  }
  .fn-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl) var(--space-lg);
  }
  /* two by two on phones, then all four sit in a row ≥600 */
  @media (min-width: 600px) {
    .fn-cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  /* the link columns join the grid directly; <nav> only adds semantics */
  .fn-links {
    display: contents;
  }
  /* signup: a full row under the links until there's room for it to sit
     beside them as a double-width column */
  .fn-col-signup {
    grid-column: 1 / -1;
    max-width: 28rem;
  }
  @media (min-width: 1000px) {
    .fn-cols {
      grid-template-columns: repeat(4, 1fr) 2fr;
    }
    .fn-col-signup {
      grid-column: auto;
    }
  }
  .fn-head {
    margin-bottom: var(--space-md);
  }
  .fn-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .fn-col a {
    font-size: var(--fs-lead);
    font-weight: var(--fw-light);
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }
  .fn-col a:hover {
    color: var(--warm);
  }
  /* base bar — outside .wrap so it runs edge to edge; same grained sand as
     the signup field (Signup.astro) */
  .fn-base {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--rule);
    padding: var(--space-md) 0;
    background: color-mix(in srgb, var(--warm) 18%, var(--cream));
    --grain-opacity: 0.3;
  }
  /* stacked (phones/tablets): centred — short trust line, logos, then
     copyright; the long sentence only shows on the one-row desktop bar */
  .fn-base-inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
  }
  .fn-secure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }
  .fn-secure :global(.pay-icons) {
    justify-content: center;
  }
  .fn-secure-more {
    display: none;
  }
  .fn-meta {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .fn-lock {
    display: inline-block;
    vertical-align: -1px;
  }
  @media (min-width: 900px) {
    .fn-base-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
    .fn-secure {
      flex-direction: row;
      gap: var(--space-md);
    }
    .fn-secure-more {
      display: inline;
    }
  }
</style>

