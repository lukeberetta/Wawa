---
/**
 * The interior pages' hero — the home page's `#hero` with a photograph where
 * the video is. Same geometry on purpose: full viewport, content pinned to the
 * bottom-left of the wrap, display type over a two-stop scrim, so arriving on
 * Story or Cafe feels like the same site as the home page.
 *
 * The image is the page's LCP: a plain <img> under the content rather than a
 * CSS background, so it carries width/height, fetchpriority and a real alt.
 */
export interface Props {
  src: string;
  /** empty when the photo is decorative and the heading already says it */
  alt: string;
  width: number;
  height: number;
}
import { srcset } from '@/lib/img';
const { src, alt, width, height } = Astro.props;
---

<section class="page-hero grain">
  <img
    class="page-hero-img"
    src={src}
    srcset={srcset(src)}
    sizes="100vw"
    alt={alt}
    width={width}
    height={height}
    fetchpriority="high"
    decoding="async"
  />
  <div class="wrap">
    <div class="page-hero-content">
      <h1><slot /></h1>
    </div>
  </div>
</section>

<style>
  /* mirrors #hero on the home page — keep the two in step */
  .page-hero {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--nav-h);
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    background: var(--ink);
    color: #fff;
  }
  .page-hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2) */
    background: linear-gradient(180deg, rgba(26, 20, 16, 0.55), rgba(26, 20, 16, 0.66));
    background:
      /* top scrim so the nav reads against the photograph */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 55%, transparent),
        transparent 22%
      ),
      /* base wash for overall text contrast */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 38%, transparent),
        color-mix(in srgb, var(--ink) 56%, transparent)
      );
  }
  /* film grain over photo + scrim, under the text — matches #hero */
  .page-hero.grain::after {
    z-index: 1;
    --grain-opacity: 0.2;
  }
  .page-hero .wrap {
    position: relative;
    z-index: 2;
  }
  /* one sentence in two spans, one per line, the first in the bright accent —
     same as the home page hero */
  .page-hero h1 {
    font-size: clamp(2rem, 1.3rem + 2.85vw, 3.9rem);
    line-height: 1.08;
  }
  .page-hero h1 :global(span) {
    display: block;
  }
  .page-hero h1 :global(span:first-child) {
    color: var(--accent-bright);
  }
  .page-hero h1 :global(span + span) {
    max-width: 16ch;
  }
</style>
