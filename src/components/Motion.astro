---
// Lenis smooth scroll. Honors prefers-reduced-motion (Lenis skipped).
---

<script>
  import Lenis from 'lenis';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Smooth scroll ──────────────────────────────
  if (!reduce) {
    const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
    // Exposed so the shared scroll lock (drawers) can stop/start Lenis instead
    // of fighting it — see src/lib/scrollLock.ts.
    window.lenis = lenis;
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  // ── Scroll reveal ──────────────────────────────
  // Reveal `.fade-in` elements as they enter the viewport (CSS holds the start
  // state under html.js; see global.css). Under reduced motion the CSS already
  // shows them, so we do nothing. Reveal is one-way — unobserve once shown.
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      // fire a little before the element's top edge reaches the fold
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    document.querySelectorAll<HTMLElement>('.fade-in').forEach((el) => {
      // Above-the-fold elements (e.g. the hero CTA) can land inside the
      // observer's -8% bottom margin and never fire on load, leaving them stuck
      // hidden. Reveal anything already in the real viewport up front.
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) {
        el.classList.add('in');
      } else {
        io.observe(el);
      }
    });
  }
</script>
