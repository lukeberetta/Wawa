---
// Lenis smooth scroll (skipped under prefers-reduced-motion and on touch),
// plus hover-only loading of ProductCard back images. No scroll reveals —
// content is simply there; entrance fades were tried and dropped.
---

<script>
  import Lenis from 'lenis';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Smooth scroll ──────────────────────────────
  // Touch-only devices scroll natively anyway (Lenis leaves touch alone), so
  // skip it there — its per-frame loop and resize handling only add work while
  // iOS Safari collapses/expands its toolbar at the top and bottom of the page.
  const touchOnly = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  if (!reduce && !touchOnly) {
    const lenis = new Lenis({
      duration: 1.1,
      smoothWheel: true,
      // Hand every horizontal gesture straight back to the browser. Lenis only
      // treats a wheel burst as horizontal when deltaY is exactly 0, and a
      // trackpad swipe never is — so a sideways flick over a rail was being
      // preventDefault()ed and turned into page scroll, which cuts the rail's
      // native inertia and reads as catching. Returning false here skips
      // Lenis entirely for those events; vertical scroll is untouched.
      virtualScroll: ({ deltaX, deltaY }) => Math.abs(deltaX) < Math.abs(deltaY),
    });
    // Exposed so the shared scroll lock (drawers) can stop/start Lenis instead
    // of fighting it — see src/lib/scrollLock.ts.
    window.lenis = lenis;
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  // ── Card back images ───────────────────────────
  // ProductCard ships the hover (hull) shot with data-src only — on touch it
  // can never be seen, so it never downloads there. Where hover exists, arm it
  // once the page has loaded; the img keeps loading="lazy", so the browser
  // still only fetches the ones near the viewport.
  if (window.matchMedia('(hover: hover)').matches) {
    const arm = () =>
      document.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
        img.removeAttribute('data-srcset');
      });
    if (document.readyState === 'complete') arm();
    else window.addEventListener('load', arm, { once: true });
  }
</script>
