---
// Lenis smooth scroll. Honors prefers-reduced-motion (Lenis skipped).
---

<script>
  import Lenis from 'lenis';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Smooth scroll ──────────────────────────────
  if (!reduce) {
    const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
    // Exposed so the shared scroll lock (drawers) can stop/start Lenis instead
    // of fighting it — see src/lib/scrollLock.ts.
    window.lenis = lenis;
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }
</script>
