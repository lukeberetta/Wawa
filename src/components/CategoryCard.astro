---
import type { Discipline } from '@/lib/types';

export interface Props {
  discipline: Discipline;
}
const { discipline } = Astro.props;
const href = `/products?discipline=${discipline.handle}`;
// Only treat hero as an image when it's a real asset path (leading slash).
// Placeholder ids like "foil-hero" stay as the wireframe box, no broken icon.
const heroSrc = discipline.hero?.startsWith('/') ? discipline.hero : null;
---

<article class="card fade-in">
  <a class="card-media" href={href} aria-label={`View ${discipline.title}`}>
    {heroSrc && <img class="face" src={heroSrc} alt="" loading="lazy" />}
  </a>
  <div class="card-meta">
    <h3><a href={href}>{discipline.title}</a></h3>
    <p class="card-desc">{discipline.blurb}</p>
  </div>
</article>

<style>
  /* mirrors ProductCard so categories read as the same catalog card. borders
     live on `.card` (not the page's `.product-grid > *`) because Astro scopes
     styles per file — a parent selector can't reach this child. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    background: var(--cream);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* meta sits inside the cell, divided from the image by a single hairline */
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.2rem;
    border-top: 1px solid var(--rule);
  }
  /* title to one line — keeps every cell's meta the same height so the row
     hairlines line up */
  .card-meta h3 {
    font-size: 1.1rem;
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-meta h3 a {
    transition: color 0.2s var(--ease);
  }
  .card-meta h3 a:hover {
    color: var(--warm);
  }
  /* blurb clamped to two lines so a longer description can't make one card
     taller than the rest of the row */
  .card-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* always reserve two lines so a one-line blurb doesn't make its card
       shorter than the rest of the rail */
    min-height: calc(0.9rem * 1.35 * 2);
  }
  @media (max-width: 520px) {
    .card-meta {
      padding: 0.85rem 0.9rem 1rem;
    }
  }
</style>
