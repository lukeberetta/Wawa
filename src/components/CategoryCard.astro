---
import type { Discipline } from '@/lib/types';
import { srcset } from '@/lib/img';

export interface Props {
  discipline: Discipline;
}
const { discipline } = Astro.props;
const href = `/products?discipline=${discipline.handle}`;
// Only treat hero as an image when it's a real asset path (leading slash).
// Placeholder ids like "foil-hero" stay as the wireframe box, no broken icon.
const heroSrc = discipline.hero?.startsWith('/') ? discipline.hero : null;
---

<article class="card">
  <a class:list={['card-media', { grain: heroSrc }]} href={href}>
    {heroSrc && (
      <img
        class="face"
        src={heroSrc}
        srcset={srcset(heroSrc)}
        sizes="(min-width: 900px) 25vw, (min-width: 560px) 40vw, 66vw"
        alt=""
        width="1080"
        height="1080"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="card-meta">
      <h3>{discipline.title}</h3>
    </div>
  </a>
</article>

<style>
  /* same 4:5 cell as ProductCard's media, but the whole cell is image — title
     sits over it on a bottom scrim. borders live on `.card` (not the
     page's `.product-grid > *`) because Astro scopes styles per file. */
  .card {
    min-width: 0;
    background: var(--cream);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card-media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
    color: var(--cream);
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  /* scrim: soft radial wash behind the centred title, photo edges stay clean */
  .card-media::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      ellipse 70% 40% at center,
      color-mix(in srgb, var(--ink) 45%, transparent) 0%,
      transparent 100%
    );
    pointer-events: none;
  }
  .card-meta {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.1rem;
  }
  /* only one PolySans weight ships (Neutral), so "bold" comes from size, tight
     tracking and a hairline stroke rather than a synthesised faux-bold */
  .card-meta h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cream);
    -webkit-text-stroke: 0.4px var(--cream);
  }
  @media (hover: hover) {
    .card-media:hover .face {
      transform: scale(1.03);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .face {
      transition: none;
    }
  }
  @media (max-width: 520px) {
    .card-meta {
      padding: 0.9rem;
    }
  </style>
