---
import { site } from '@/lib/site';
import { disciplines } from '@/lib/catalog';
export interface Props {
  current?: string;
  overlay?: boolean;
}
const { current, overlay = false } = Astro.props;

// Pages flag their section via `current` (e.g. "products"); the Shop row/link
// is the entry point for that whole section, so treat either name as active.
const isActive = (label: string) => {
  const key = label.toLowerCase();
  return current === key || (key === 'shop' && current === 'products');
};
---

<nav id="nav" class:list={{ overlay }}>
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo" aria-label="Wawa Surfboards home">
      <img src="/logotype.svg" alt="Wawa" width="92" height="24" />
    </a>

    <div class="nav-actions">
      <!-- Persistent commerce entry: Shop always visible; Story/Press fold in
           on wider screens. Mobile keeps just Shop · Cart · menu. -->
      <a
        class:list={['nav-link', 'nav-link-shop', { active: isActive('Shop') }]}
        href="/products"
      >
        Shop
      </a>
      <a class:list={['nav-link', 'nav-link-wide', { active: isActive('Story') }]} href="/story">
        Story
      </a>
      <a class:list={['nav-link', 'nav-link-wide', { active: isActive('Press') }]} href="/press">
        Press
      </a>
      {site.shopDomain && (
        <button class="nav-cart" data-cart-toggle aria-label="Open cart">
          Cart (<span data-cart-count>0</span>)
        </button>
      )}
      <button
        class="nav-burger"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-burger-bar"></span>
        <span class="nav-burger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Dim the page behind the menu drawer; click to dismiss -->
  <div class="m-overlay" data-menu-close></div>

  <!-- Menu — right-side drawer with a Products drill-down -->
  <div id="mobile-menu" class="m-menu" tabindex="-1" aria-hidden="true">
      <!-- Root level -->
      <section class="m-panel m-panel-root" data-panel="root">
        <nav class="m-list" aria-label="Menu">
          {
            site.nav.map((item) =>
              item.dropdown ? (
                <button
                  class:list={['m-row', { active: isActive(item.label) }]}
                  data-drill
                  aria-label={`${item.label} — view categories`}
                >
                  <span>{item.label}</span>
                  <span class="m-row-arrow" aria-hidden="true"></span>
                </button>
              ) : (
                <a
                  class:list={['m-row', { active: isActive(item.label) }]}
                  href={item.href}
                >
                  <span>{item.label}</span>
                </a>
              ),
            )
          }
        </nav>
        <div class="m-foot">
          <a href={site.instagram} target="_blank" rel="noopener noreferrer">
          <svg class="m-foot-ig" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
          </svg>
          Instagram
        </a>
        </div>
      </section>

      <!-- Products level -->
      <section class="m-panel m-panel-sub" data-panel="products" aria-hidden="true">
        <button class="m-back" data-back>
          <span class="m-back-arrow" aria-hidden="true"></span> Back
        </button>
        <nav class="m-list" aria-label="Shop categories">
          <a class="m-row" href="/products">
            <span>All products</span>
          </a>
          {disciplines.map((d) => (
            <a class="m-row" href={`/products?discipline=${d.handle}`}>
              <span>{d.title}</span>
            </a>
          ))}
        </nav>
      </section>
  </div>
</nav>

<style>
  /* scope to the id — a bare `nav` selector would also hit the nested
     <nav class="m-list"> menus and pin them position:fixed, full-bleed */
  #nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    /* grow under the status bar in standalone (env is 0 in normal browsing) */
    height: calc(var(--nav-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
      height 0.3s var(--ease);
  }
  /* Over the hero (homepage) the bar floats transparent with cream marks until
     the page scrolls past the fold, then settles into the solid cream header. */
  #nav.overlay:not(.scrolled):not(.menu-open) {
    background: transparent;
    border-bottom-color: transparent;
  }
  #nav.overlay:not(.scrolled):not(.menu-open) .nav-link,
  #nav.overlay:not(.scrolled):not(.menu-open) .nav-cart {
    color: var(--cream);
  }
  #nav.overlay:not(.scrolled):not(.menu-open) .nav-link.active {
    color: var(--cream);
  }
  #nav.overlay:not(.scrolled):not(.menu-open) .nav-burger {
    color: var(--cream);
  }
  #nav.overlay:not(.scrolled):not(.menu-open) .nav-logo img {
    filter: brightness(0) invert(1);
  }
  .nav-inner {
    position: relative;
    height: var(--bar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* with the menu open the bar must sit above the dim overlay (a child of #nav)
     and carry its own surface, so it reads as a solid header the drawer hangs
     from instead of a greyed-out strip */
  #nav.menu-open .nav-inner {
    z-index: 95;
    background: var(--cream);
  }
  .nav-logo img {
    height: 22px;
    width: auto;
    display: block;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-cart {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-cart:hover {
    opacity: 1;
  }
  /* persistent text links in the bar — same quiet weight as the cart label */
  .nav-link {
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s var(--ease), color 0.25s var(--ease);
  }
  .nav-link:hover {
    opacity: 1;
  }
  .nav-link.active {
    opacity: 1;
    color: var(--warm);
  }
  /* Story / Press only earn bar space on wider screens; phones keep Shop only */
  .nav-link-wide {
    display: none;
  }
  @media (min-width: 900px) {
    .nav-link-wide {
      display: inline-flex;
    }
  }
  /* single hamburger menu at every breakpoint */
  .nav-burger {
    display: block;
    position: relative;
    width: 24px;
    height: 16px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
  }
  .nav-burger-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-burger-bar:nth-child(1) {
    top: 3px;
  }
  .nav-burger-bar:nth-child(2) {
    bottom: 3px;
  }
  /* burger → X while the menu is open */
  #nav.menu-open .nav-burger-bar:nth-child(1) {
    transform: translateY(4.25px) rotate(45deg);
  }
  #nav.menu-open .nav-burger-bar:nth-child(2) {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* ── drill-down menu: right-side drawer, like the cart ── */
  .m-overlay {
    position: fixed;
    inset: 0;
    z-index: 88;
    background: color-mix(in srgb, var(--ink) 48%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease);
  }
  #nav.menu-open .m-overlay {
    opacity: 1;
    pointer-events: auto;
  }
  .m-menu {
    display: block;
    position: fixed;
    /* -1px so the drawer's top edge tucks under the bar's bottom rule
       instead of leaving a doubled hairline */
    top: calc(var(--bar-h) + env(safe-area-inset-top) - 1px);
    right: 0;
    bottom: 0;
    width: min(90vw, 408px);
    z-index: 90;
    background: var(--cream);
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    overflow: hidden; /* the track slides horizontally */
    transform: translateX(100%);
    pointer-events: none;
    transition: transform 0.4s var(--ease);
  }
  #nav.menu-open .m-menu {
    transform: translateX(0);
    pointer-events: auto;
  }
  /* the drawer takes initial focus (for the trap) but is a container, not a
     control — never ring it */
  .m-menu:focus,
  .m-menu:focus-visible {
    outline: none;
  }
  /* Two stacked panels that slide horizontally — classic drill-down. The root
     sits at rest; the sub waits off the right edge until Products is tapped. */
  .m-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    /* match the page/bar gutter exactly so rows line up with the logo */
    padding-block: 0.25rem calc(2rem + env(safe-area-inset-bottom));
    padding-inline: max(
      var(--wrap-pad),
      env(safe-area-inset-left),
      env(safe-area-inset-right)
    );
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .m-panel-root {
    transform: translateX(0);
  }
  .m-panel-sub {
    transform: translateX(100%);
  }
  /* drilled into Products: root steps back and out, sub slides to rest */
  #nav.menu-sub .m-panel-root {
    transform: translateX(-25%);
    opacity: 0;
    pointer-events: none;
  }
  #nav.menu-sub .m-panel-sub {
    transform: translateX(0);
  }
  /* orchestrated open — root rows rise and settle in sequence */
  .m-panel-root .m-row {
    opacity: 0;
    transform: translateY(9px);
  }
  #nav.menu-open .m-panel-root .m-row {
    opacity: 1;
    transform: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }
  #nav.menu-open .m-panel-root .m-row:nth-child(1) { transition-delay: 0.06s; }
  #nav.menu-open .m-panel-root .m-row:nth-child(2) { transition-delay: 0.1s; }
  #nav.menu-open .m-panel-root .m-row:nth-child(3) { transition-delay: 0.14s; }
  #nav.menu-open .m-panel-root .m-row:nth-child(4) { transition-delay: 0.18s; }
  #nav.menu-open .m-panel-root .m-row:nth-child(5) { transition-delay: 0.22s; }
  .m-list {
    display: flex;
    flex-direction: column;
  }
  .m-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    /* fixed line-height so <button> and <a> rows share one rhythm
       (buttons otherwise reset to line-height:normal and render shorter) */
    min-height: 4.25rem;
    padding: 0;
    font-family: inherit;
    font-size: 1.4rem;
    line-height: 1.1;
    font-weight: var(--fw-light);
    letter-spacing: 0.01em;
    color: var(--ink);
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
    transition: opacity 0.2s var(--ease);
  }
  .m-row:active {
    opacity: 0.55;
  }
  .m-row.active {
    color: var(--warm);
  }
  /* chevrons drawn as 1.5px strokes to match the burger / X bars */
  .m-row-arrow {
    width: 9px;
    height: 9px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    transform: rotate(45deg);
    color: var(--muted);
  }
  .m-back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 0 1.1rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.2s var(--ease);
  }
  .m-back:hover {
    color: var(--ink);
  }
  .m-back-arrow {
    width: 8px;
    height: 8px;
    border-bottom: 1.5px solid currentColor;
    border-left: 1.5px solid currentColor;
    transform: rotate(45deg);
  }
  .m-foot {
    margin-top: auto;
    padding-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .m-foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.4rem;
    font-weight: var(--fw-light);
    letter-spacing: 0.01em;
    line-height: 1.1;
    color: var(--ink);
  }
  .m-foot-ig {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 768px) {
    .nav-actions {
      gap: 1.25rem;
    }
    .nav-logo img {
      height: 18px;
    }
    .nav-cart,
    .nav-link {
      font-size: 0.8rem;
      letter-spacing: 0.03em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .m-menu,
    .m-panel,
    .nav-burger-bar {
      transition: none;
    }
    .m-panel-root .m-row {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { lockScroll } from '@/lib/scrollLock';
  import { trapFocus } from '@/lib/focusTrap';

  const nav = document.getElementById('nav');
  const menu = document.getElementById('mobile-menu');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  let releaseTrap: (() => void) | null = null;

  // ── hamburger menu ──
  function setMenu(open: boolean) {
    if (!nav || !menu || !toggle) return;
    nav.classList.toggle('menu-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    lockScroll(open);
    if (open) {
      // focus the drawer itself, not the first row, so no row shows a
      // highlight on open; Tab still cycles within the trap
      releaseTrap = trapFocus(nav, menu);
    } else {
      releaseTrap?.();
      releaseTrap = null;
      // reset to the root level once it has slid out of view
      setTimeout(() => nav.classList.remove('menu-sub'), 400);
    }
  }

  toggle?.addEventListener('click', () =>
    setMenu(!nav?.classList.contains('menu-open')),
  );
  // click the dimmed backdrop to dismiss
  nav?.querySelector('[data-menu-close]')?.addEventListener('click', () =>
    setMenu(false),
  );
  menu?.querySelector('[data-drill]')?.addEventListener('click', () =>
    nav?.classList.add('menu-sub'),
  );
  menu?.querySelector('[data-back]')?.addEventListener('click', () =>
    nav?.classList.remove('menu-sub'),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  // If the cart opens while the menu is up, fold the menu away but leave the
  // scroll lock to the cart (it claims it via the shared lockScroll).
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-cart-toggle]') && nav?.classList.contains('menu-open')) {
      nav.classList.remove('menu-open');
      menu?.setAttribute('aria-hidden', 'true');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
      // hand off cleanly — drop the menu's focus trap so the cart can claim it
      releaseTrap?.();
      releaseTrap = null;
      setTimeout(() => nav?.classList.remove('menu-sub'), 400);
    }
  });

  // ── scrolled state for the top bar ──
  const onScroll = () => {
    // While a drawer holds the scroll lock the document is pinned to 0; ignore
    // the spurious scroll events so the nav keeps its state.
    if (document.documentElement.classList.contains('is-locked')) return;
    nav?.classList.toggle('scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
