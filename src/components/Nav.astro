---
import { site } from '@/lib/site';
import { disciplines } from '@/lib/catalog';
export interface Props {
  current?: string;
}
const { current } = Astro.props;

const igSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
  <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
</svg>`;

---

<nav id="nav" class:list={{ 'over-hero': current === 'home' }}>
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo" aria-label="Wawa Surfboards home">
      <img src="/logotype.svg" alt="Wawa" width="92" height="24" />
    </a>

    <div class="nav-right">
    <ul class="nav-links">
      {
        site.nav.map((item) =>
          item.dropdown ? (
            <li class="has-dropdown">
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
                aria-haspopup="true"
              >
                {item.label} ({disciplines.length})
              </a>
              <ul class="dropdown">
                {disciplines.map((d) => (
                  <li>
                    <a href={`/products/${d.handle}`}>{d.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="nav-actions">
      {site.shopDomain && (
        <button class="nav-cart" data-cart-toggle aria-label="Open cart">
          Cart (<span data-cart-count>0</span>)
        </button>
      )}
      <a
        class="nav-link nav-ig"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Wawa on Instagram"
        set:html={igSvg}
      />
      <button
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span></span><span></span>
      </button>
    </div>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="nav-overlay" hidden></div>
<aside id="nav-drawer" class="nav-drawer" aria-label="Menu" aria-hidden="true">
  <ul class="drawer-links">
    {
      site.nav.map((item) => (
        <li>
          <a href={item.href} class:list={{ active: current === item.label.toLowerCase() }}>
            {item.label}{item.dropdown && ` (${disciplines.length})`}
          </a>
        </li>
      ))
    }
    {site.shopDomain && (
      <li>
        <button class="drawer-cart" data-cart-toggle type="button">
          Cart (<span data-cart-count>0</span>)
        </button>
      </li>
    )}
    <li>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer">
        Instagram
      </a>
    </li>
  </ul>
</aside>

<style>
  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    /* grow under the status bar in standalone (env is 0 in normal browsing) */
    height: calc(var(--nav-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  nav.scrolled {
    background: var(--cream);
    border-color: var(--rule);
  }
  /* On the home hero the nav sits over a dark photo — flip text/logo to
     cream while at the top, then fall back to ink once scrolled. */
  nav.over-hero:not(.scrolled) .nav-link,
  nav.over-hero:not(.scrolled) .nav-cart {
    color: var(--cream);
  }
  nav.over-hero:not(.scrolled) .nav-logo img {
    filter: brightness(0) invert(1);
  }
  nav.over-hero:not(.scrolled) .nav-toggle span {
    background: var(--cream);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo img {
    height: 22px;
    width: auto;
    display: block;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-cart {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-cart:hover {
    opacity: 1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  .nav-links li {
    display: flex;
  }
  .nav-link {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-link:hover,
  .nav-link.active {
    opacity: 1;
  }
  .nav-ig svg {
    display: block;
  }

  /* desktop dropdown */
  .has-dropdown {
    position: relative;
  }
  /* transparent bridge over the button→menu gap so the hover isn't lost
     while the cursor travels down to the menu */
  .has-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
  }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 168px;
    list-style: none;
    background: var(--cream);
    border: 1px solid var(--rule);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(2px);
  }
  .dropdown li {
    display: block;
  }
  .dropdown a {
    display: block;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.75;
    white-space: nowrap;
    transition: opacity 0.2s, background 0.2s;
  }
  .dropdown a:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }

  /* hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 30px;
    height: 30px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
    z-index: 120;
  }
  .nav-toggle span {
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .nav-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* drawer + overlay */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 105;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .nav-overlay.open {
    opacity: 1;
  }
  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 110;
    width: min(78vw, 320px);
    height: 100vh;
    height: 100dvh;
    background: var(--cream);
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease);
    padding: calc(var(--nav-h) + env(safe-area-inset-top) + 1.5rem)
      calc(2rem + env(safe-area-inset-right)) calc(2rem + env(safe-area-inset-bottom)) 2rem;
    overflow-y: auto;
  }
  .nav-drawer.open {
    transform: translateX(0);
  }
  .drawer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  /* every drawer row shares one type/colour/rule — link, cart and Instagram */
  .drawer-links a,
  .drawer-cart {
    width: 100%;
    padding: 0.85rem 0;
    font-family: inherit;
    font-size: 1.4rem;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
  }
  .drawer-links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .drawer-cart {
    display: block;
    text-align: left;
  }
  .drawer-links a.active {
    color: var(--warm);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .nav-ig {
      display: none;
    }
    .nav-logo img {
      height: 18px;
    }
    .nav-toggle {
      display: flex;
    }
  }
  @media (min-width: 769px) {
    .nav-overlay,
    .nav-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .nav-overlay,
    .nav-toggle span {
      transition: none;
    }
  }
</style>

<script>
  import { lockScroll } from '@/lib/scrollLock';

  const nav = document.getElementById('nav');
  const onScroll = () => {
    // While a drawer holds the scroll lock the document is pinned to 0; ignore
    // the spurious scroll events so the nav keeps its background (see scrollLock).
    if (document.documentElement.classList.contains('is-locked')) return;
    nav?.classList.toggle('scrolled', window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ── Mobile drawer ──────────────────────────────
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const overlay = document.querySelector<HTMLDivElement>('.nav-overlay');

  function setOpen(open: boolean) {
    if (!toggle || !drawer || !overlay) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.setAttribute('aria-hidden', String(!open));
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    lockScroll(open);
    if (open) {
      overlay.hidden = false;
    } else {
      // wait for the fade before removing from the a11y tree
      setTimeout(() => {
        if (toggle.getAttribute('aria-expanded') === 'false') overlay.hidden = true;
      }, 300);
    }
  }

  toggle?.addEventListener('click', () =>
    setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
  );
  overlay?.addEventListener('click', () => setOpen(false));

  // Drawer links close the drawer on click. The cart button isn't an <a>; it
  // opens the cart, which closes this drawer on its own (see Cart.astro).
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
