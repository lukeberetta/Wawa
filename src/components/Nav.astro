---
import { site } from '@/lib/site';
import { disciplines } from '@/lib/catalog';
export interface Props {
  current?: string;
}
const { current } = Astro.props;

const igSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
  <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
</svg>`;

---

<nav id="nav" class:list={{ 'over-hero': current === 'home' }}>
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo" aria-label="Wawa Surfboards home">
      <img src="/logotype.svg" alt="Wawa" width="92" height="24" />
    </a>

    <div class="nav-right">
    <ul class="nav-links">
      {
        site.nav.map((item) =>
          item.dropdown ? (
            <li class="has-dropdown">
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
                aria-haspopup="true"
              >
                {item.label} ({disciplines.length})
              </a>
              <ul class="dropdown">
                {disciplines.map((d) => (
                  <li>
                    <a href={`/products/${d.handle}`}>{d.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="nav-actions">
      {site.shopDomain && (
        <button class="nav-cart" data-cart-toggle aria-label="Open cart">
          Cart (<span data-cart-count>0</span>)
        </button>
      )}
      <a
        class="nav-link nav-ig"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Wawa on Instagram"
        set:html={igSvg}
      />
    </div>
    </div>
  </div>

  <!-- Persistent mobile menu row (replaces the burger drawer) -->
  <div class="nav-subnav" aria-label="Sections">
    <ul class="subnav-links wrap">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ active: current === item.label.toLowerCase() }}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    /* grow under the status bar in standalone (env is 0 in normal browsing) */
    height: calc(var(--nav-h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease),
      height 0.3s var(--ease);
  }
  nav.scrolled {
    background: var(--cream);
    border-color: var(--rule);
  }
  /* On the home hero the nav sits over a dark photo — flip text/logo to
     cream while at the top, then fall back to ink once scrolled. */
  nav.over-hero:not(.scrolled) .nav-link,
  nav.over-hero:not(.scrolled) .nav-cart {
    color: var(--cream);
  }
  nav.over-hero:not(.scrolled) .nav-logo img {
    filter: brightness(0) invert(1);
  }
  .nav-inner {
    height: var(--bar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo img {
    height: 22px;
    width: auto;
    display: block;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-cart {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-cart:hover {
    opacity: 1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  .nav-links li {
    display: flex;
  }
  .nav-link {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-link:hover,
  .nav-link.active {
    opacity: 1;
  }
  .nav-ig svg {
    display: block;
  }

  /* desktop dropdown */
  .has-dropdown {
    position: relative;
  }
  /* transparent bridge over the button→menu gap so the hover isn't lost
     while the cursor travels down to the menu */
  .has-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 14px;
  }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 168px;
    list-style: none;
    background: var(--cream);
    border: 1px solid var(--rule);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(2px);
  }
  .dropdown li {
    display: block;
  }
  .dropdown a {
    display: block;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.75;
    white-space: nowrap;
    transition: opacity 0.2s, background 0.2s;
  }
  .dropdown a:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }

  /* persistent mobile menu row — hidden on desktop, where .nav-links serve */
  .nav-subnav {
    display: none;
    height: var(--subnav-h);
    overflow: hidden;
    background: var(--cream);
    border-top: 1px solid var(--rule);
    transition: height 0.3s var(--ease), opacity 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  /* collapse the mobile menu row while scrolling down; reveal on scroll up */
  nav.subnav-hidden .nav-subnav {
    height: 0;
    opacity: 0;
    border-top-color: transparent;
  }
  .subnav-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav-links::-webkit-scrollbar {
    display: none;
  }
  .subnav-links li {
    display: flex;
  }
  .subnav-links a {
    white-space: nowrap;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    opacity: 0.7;
    transition: opacity 0.25s, color 0.25s;
  }
  .subnav-links a:hover {
    opacity: 1;
  }
  .subnav-links a.active {
    opacity: 1;
    color: var(--warm);
  }

  @media (max-width: 768px) {
    /* solid bar with persistent rules — no transparent-over-hero on mobile */
    nav,
    nav.over-hero {
      background: var(--cream);
      border-color: var(--rule);
    }
    nav.over-hero:not(.scrolled) .nav-cart,
    nav.over-hero:not(.scrolled) .nav-ig {
      color: var(--ink);
    }
    nav.over-hero:not(.scrolled) .nav-logo img {
      filter: none;
    }
    /* subnav collapsed — shrink the bar to match */
    nav.subnav-hidden {
      height: calc(var(--bar-h) + env(safe-area-inset-top));
    }
    .nav-links {
      display: none;
    }
    .nav-actions {
      gap: 1.25rem;
    }
    .nav-logo img {
      height: 18px;
    }
    .nav-cart {
      font-size: 0.8rem;
      letter-spacing: 0.03em;
    }
    .nav-subnav {
      display: flex;
      align-items: center;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  let lastY = window.scrollY;
  const onScroll = () => {
    // While the cart drawer holds the scroll lock the document is pinned to 0;
    // ignore the spurious scroll events so the nav keeps its state.
    if (document.documentElement.classList.contains('is-locked')) return;
    const y = window.scrollY;
    nav?.classList.toggle('scrolled', y > 24);
    // Hide the subnav while scrolling down (past the bar); reveal on scroll up
    // or back near the top.
    if (y > lastY && y > 64) {
      nav?.classList.add('subnav-hidden');
    } else if (y < lastY) {
      nav?.classList.remove('subnav-hidden');
    }
    lastY = y;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
