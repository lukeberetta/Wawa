---
import { site } from '@/lib/site';
import { disciplines } from '@/lib/catalog';
export interface Props {
  current?: string;
}
const { current } = Astro.props;

const igSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.6" />
  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
  <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
</svg>`;

const bagSvg = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" />
</svg>`;
---

<nav id="nav" class:list={{ 'over-hero': current === 'home' }}>
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo" aria-label="Wawa Surfboards home">
      <img src="/logotype.svg" alt="Wawa" width="92" height="24" />
    </a>

    <div class="nav-right">
    <ul class="nav-links">
      {
        site.nav.map((item) =>
          item.dropdown ? (
            <li class="has-dropdown">
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
                aria-haspopup="true"
              >
                {item.label}
                <span class="caret" aria-hidden="true">▾</span>
              </a>
              <ul class="dropdown">
                {disciplines.map((d) => (
                  <li>
                    <a href={`/products/${d.handle}`}>{d.title}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.label.toLowerCase() }]}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li>
        <a
          class="nav-link nav-ig"
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Wawa on Instagram"
          set:html={igSvg}
        />
      </li>
    </ul>

    <div class="nav-actions">
      {site.shopDomain && (
        <button class="nav-cart" data-cart-toggle aria-label="Open cart">
          <span set:html={bagSvg} />
          <span class="cart-count" data-cart-count hidden>0</span>
        </button>
      )}
      <button
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <span></span><span></span>
      </button>
    </div>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="nav-overlay" hidden></div>
<aside id="nav-drawer" class="nav-drawer" aria-label="Menu" aria-hidden="true">
  <ul class="drawer-links">
    {
      site.nav.map((item) => (
        <li class:list={['drawer-item', { 'has-sub': item.dropdown }]}>
          <div class="drawer-row">
            <a href={item.href} class:list={{ active: current === item.label.toLowerCase() }}>
              {item.label}
            </a>
            {item.dropdown && (
              <button
                class="drawer-sub-toggle"
                aria-expanded="false"
                aria-label={`Toggle ${item.label} submenu`}
              >
                <span class="caret" aria-hidden="true">▾</span>
              </button>
            )}
          </div>
          {item.dropdown && (
            <ul class="drawer-sub">
              {disciplines.map((d) => (
                <li>
                  <a href={`/products/${d.handle}`}>{d.title}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
    <li>
      <a
        class="drawer-ig"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span set:html={igSvg} /> Instagram
      </a>
    </li>
  </ul>
</aside>

<style>
  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  nav.scrolled {
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(8px);
    border-color: var(--rule);
  }
  /* On the home hero the nav sits over a dark photo — flip text/logo to
     cream while at the top, then fall back to ink once scrolled. */
  nav.over-hero:not(.scrolled) .nav-link,
  nav.over-hero:not(.scrolled) .nav-cart {
    color: var(--cream);
  }
  nav.over-hero:not(.scrolled) .nav-logo img {
    filter: brightness(0) invert(1);
  }
  nav.over-hero:not(.scrolled) .nav-toggle span {
    background: var(--cream);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo img {
    height: 22px;
    width: auto;
    display: block;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav-cart {
    position: relative;
    display: flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-cart:hover {
    opacity: 1;
  }
  .nav-cart span {
    display: flex;
  }
  .cart-count {
    position: absolute;
    top: -7px;
    right: -9px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    line-height: 1;
    border-radius: 8px;
    background: var(--warm);
    color: var(--cream);
  }
  .cart-count[hidden] {
    display: none;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  .nav-links li {
    display: flex;
  }
  .nav-link {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .nav-link:hover,
  .nav-link.active {
    opacity: 1;
  }
  .nav-ig svg {
    display: block;
  }

  /* desktop dropdown */
  .has-dropdown {
    position: relative;
  }
  .caret {
    font-size: 0.6rem;
    margin-left: 0.3rem;
  }
  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    min-width: 168px;
    list-style: none;
    background: var(--cream);
    border: 1px solid var(--rule);
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(2px);
  }
  .dropdown li {
    display: block;
  }
  .dropdown a {
    display: block;
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.75;
    white-space: nowrap;
    transition: opacity 0.2s, background 0.2s;
  }
  .dropdown a:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }

  /* hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 30px;
    height: 30px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
    z-index: 120;
  }
  .nav-toggle span {
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .nav-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* drawer + overlay */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 105;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .nav-overlay.open {
    opacity: 1;
  }
  .nav-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 110;
    width: min(78vw, 320px);
    height: 100dvh;
    background: var(--cream);
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease);
    padding: calc(var(--nav-h) + 1.5rem) 2rem 2rem;
    overflow-y: auto;
  }
  .nav-drawer.open {
    transform: translateX(0);
  }
  .drawer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .drawer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
  }
  .drawer-row a {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0;
    font-size: 1.4rem;
    color: var(--ink);
  }
  .drawer-row a.active {
    color: var(--warm);
  }
  .drawer-sub-toggle {
    flex: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    padding: 0;
  }
  .drawer-sub-toggle .caret {
    font-size: 0.8rem;
    transition: transform 0.3s var(--ease);
  }
  .drawer-sub-toggle[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }
  .drawer-sub {
    list-style: none;
    overflow: hidden;
    max-height: 0;
    padding-left: 0.9rem;
    transition: max-height 0.35s var(--ease);
  }
  .drawer-item.open .drawer-sub {
    /* generous cap; 6 items × ~2.4rem */
    max-height: 22rem;
  }
  .drawer-sub a {
    font-size: 1rem;
    padding: 0.5rem 0;
    color: var(--muted);
    border-bottom: 0;
  }
  .drawer-sub a:hover {
    color: var(--ink);
  }
  .drawer-ig {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 0;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .drawer-ig:hover {
    color: var(--ink);
  }
  .drawer-ig span {
    display: flex;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
  @media (min-width: 769px) {
    .nav-overlay,
    .nav-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .nav-overlay,
    .nav-toggle span {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ── Mobile drawer ──────────────────────────────
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  const overlay = document.querySelector<HTMLDivElement>('.nav-overlay');

  // Robust scroll lock: position:fixed preserves the scroll position on iOS,
  // where `overflow: hidden` on <body> is ignored.
  let lockedY = 0;
  function lockScroll(lock: boolean) {
    const b = document.body;
    if (lock) {
      lockedY = window.scrollY;
      b.style.position = 'fixed';
      b.style.top = `-${lockedY}px`;
      b.style.left = '0';
      b.style.right = '0';
    } else {
      b.style.position = '';
      b.style.top = '';
      b.style.left = '';
      b.style.right = '';
      window.scrollTo(0, lockedY);
    }
  }

  function setOpen(open: boolean) {
    if (!toggle || !drawer || !overlay) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    drawer.setAttribute('aria-hidden', String(!open));
    drawer.classList.toggle('open', open);
    overlay.classList.toggle('open', open);
    lockScroll(open);
    if (open) {
      overlay.hidden = false;
    } else {
      // collapse any open accordion sections
      drawer.querySelectorAll('.drawer-item.open').forEach((li) => {
        li.classList.remove('open');
        li.querySelector('.drawer-sub-toggle')?.setAttribute('aria-expanded', 'false');
      });
      // wait for the fade before removing from the a11y tree
      setTimeout(() => {
        if (toggle.getAttribute('aria-expanded') === 'false') overlay.hidden = true;
      }, 300);
    }
  }

  toggle?.addEventListener('click', () =>
    setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
  );
  overlay?.addEventListener('click', () => setOpen(false));

  // Accordion: chevron expands/collapses the submenu without closing the drawer.
  drawer?.querySelectorAll<HTMLButtonElement>('.drawer-sub-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const li = btn.closest('.drawer-item');
      const isOpen = li?.classList.toggle('open') ?? false;
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });

  // Only navigation links close the drawer (not the accordion toggle button).
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
