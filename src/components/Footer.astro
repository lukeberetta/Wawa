---
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site footer">
  <div class="footer-inner wrap">
    <p class="f-statement">Made by hand,<br />shaped by nature.</p>
    <p class="f-meta">© {year} {site.name} · Muizenberg, Cape Town</p>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--footer-h);
    z-index: 0;
    background: var(--ink) url('/img/surfers.jpg') center / cover no-repeat;
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 78%, transparent),
      color-mix(in srgb, var(--ink) 90%, transparent)
    );
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    text-align: center;
  }

  /* the brand statement — softened, not stark white */
  .f-statement {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
  }
  .f-meta {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--cream) 48%, transparent);
  }

  /* ── reveal motion (staggered rise as the curtain lifts) ──
     Only active once JS adds `.anim`; without JS the content is fully visible. */
  .site-footer.anim .footer-inner > * {
    opacity: 0;
    transform: translateY(38px);
    transition: opacity 0.7s var(--ease), transform 0.8s var(--ease);
  }
  .site-footer.anim.revealed .f-meta {
    transition-delay: 0.12s;
  }
  .site-footer.anim.revealed .footer-inner > * {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer.anim .footer-inner > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Reveal the footer content when the end-of-page sentinel scrolls into view.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const sentinel = document.getElementById('footer-sentinel');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer) {
    // enable the hidden→reveal transition (no-JS keeps content visible)
    footer.classList.add('anim');

    if (reduce || !sentinel || !('IntersectionObserver' in window)) {
      footer.classList.add('revealed');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => footer.classList.toggle('revealed', e.isIntersecting));
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0 },
      );
      io.observe(sentinel);
    }
  }
</script>
