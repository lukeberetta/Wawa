---
---

<footer class="site-footer grain" aria-label="Site footer">
  <!-- The footer is fixed behind the page and sits on all 41 routes, so it must
       never cost anything up front: no source elements (their presence starts
       a fetch whatever `preload` says) and the poster carries the panel until
       the script attaches a source as the footer nears the viewport. -->
  <video
    class="footer-video"
    muted
    loop
    playsinline
    webkit-playsinline
    preload="none"
    poster="/hero-poster.jpg"
    aria-hidden="true"
  >
  </video>
  <div class="footer-inner wrap">
    <p class="f-statement">Made slowly.<br />Ridden forever.</p>
    <a class="f-order" href="/products">
      Shop the workshop <span aria-hidden="true">→</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--footer-h);
    z-index: 0;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  /* Mobile: plain in-flow footer, no curtain reveal. iOS 26 Safari tints its
     bottom toolbar from any fixed element touching the viewport bottom, so a
     dark footer parked behind the page turns the bar into a solid dark band. */
  @media (max-width: 768px) {
    .site-footer {
      position: relative;
      /* paint 1px of ink past the bottom edge: a fractional page height left
         a hairline of the cream body showing under the footer */
      box-shadow: 0 1px 0 var(--ink);
    }
    /* iOS 26 Safari: at the end of the page the band under the floating
       toolbar is past the document, so no content can paint there — Safari
       fills it with the <body> background (wood on mobile, see global.css).
       Go ink while the footer is on screen so the band continues the
       video's faded-out bottom (below). */
    :global(html.footer-in body) {
      background: var(--ink);
    }
  }
  /* hero video as the footer backdrop, behind the darkening gradient — same
     treatment as #hero so the two video panels read identically */
  .footer-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* grade is baked into the video files — a CSS filter here makes Safari
       stutter on full-viewport video (see #hero) */
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2) */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.38),
      rgba(26, 20, 16, 0.56)
    );
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 38%, transparent),
      color-mix(in srgb, var(--ink) 56%, transparent)
    );
  }
  /* mobile: fade the bottom of the panel into solid ink so it runs on into
     the flat ink band Safari paints under its toolbar (see above) */
  @media (max-width: 768px) {
    .site-footer::before {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--ink) 38%, transparent),
        color-mix(in srgb, var(--ink) 56%, transparent) 55%,
        var(--ink) 100%
      );
    }
  }
  /* film grain over video + gradient, under the text — matches #hero */
  .site-footer.grain::after {
    z-index: 1;
    --grain-opacity: 0.2;
  }
  .footer-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* brand statement — same cream as the hero headline, a touch smaller */
  .f-statement {
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--cream);
  }
  .f-order {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* solid cream, not a translucent wash — the footer sits over video, and a
       filled button is the one thing on the panel that shouldn't shift with
       whatever frame is behind it */
    color: var(--ink);
    background: var(--cream);
    border: 0;
    padding: 0.85rem 1.6rem;
    /* on top of .footer-inner's gap — the one filled element on the panel
       needs air around it, not the same rhythm as two lines of text */
    margin-block: 0.5rem;
    text-decoration: none;
    transition: opacity 0.2s var(--ease), gap 0.3s var(--ease);
  }
  .f-order:hover {
    opacity: 0.85;
    gap: 0.9rem;
  }

  /* ── scroll-linked blur-in ──
     `--reveal` (0–1) is driven by JS from scroll position: the text sharpens
     and fades in as the footer is uncovered, and blurs back out on scroll up.
     No-JS / fallback keeps the content fully visible and sharp. */
  .footer-inner > :global(*) {
    opacity: var(--reveal, 1);
    filter: blur(calc((1 - var(--reveal, 1)) * 12px));
    will-change: opacity, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-inner > :global(*) {
      opacity: 1;
      filter: none;
    }
  }
</style>

<script>
  // Drive `--reveal` (0–1) from scroll position: the footer text sharpens and
  // fades in as the fixed footer is uncovered, and blurs back out on scroll up.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer && !reduce) {
    // Measure layout (forces reflow) only on resize/load — never per scroll.
    // Caching winH also stops the reveal wobbling as iOS shows/hides its
    // toolbar (which changes innerHeight mid-scroll).
    let fh = footer.offsetHeight;
    let docH = document.documentElement.scrollHeight;
    let winH = window.innerHeight;
    let ticking = false;

    const compute = () => {
      ticking = false;
      // scrollY is cheap and reflow-free — the only thing read while scrolling.
      const remaining = docH - winH - window.scrollY;
      // Finish the reveal over the first 60% of the footer uncovering, so the
      // text reaches full clarity before the absolute scroll bottom — on mobile
      // the last pixels are often unreachable (browser chrome / rubber-banding).
      const p = Math.min(Math.max(1 - remaining / (fh * 0.6), 0), 1);
      footer.style.setProperty('--reveal', p.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(compute);
      }
    };
    const remeasure = () => {
      fh = footer.offsetHeight;
      docH = document.documentElement.scrollHeight;
      winH = window.innerHeight;
      compute();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    // Filtering products changes the document height without firing `resize`,
    // which would leave docH stale and freeze the reveal. Watch body size so
    // any layout shift (filter, image load) re-measures.
    if ('ResizeObserver' in window) {
      new ResizeObserver(remeasure).observe(document.body);
    }
    remeasure();
  }
</script>

<script>
  import { ambientVideo } from '@/lib/ambientVideo';

  const v = document.querySelector<HTMLVideoElement>('.footer-video');
  // Footer sits behind the page on every route — only load as it comes up.
  // The footer itself is position:fixed and so always "intersects" the
  // viewport; the sentinel at the end of <main> is what actually approaches
  // as the user nears the bottom.
  if (v) ambientVideo(v, { name: 'hero', watch: document.getElementById('footer-sentinel') });

  // Flags the footer being on screen, for the iOS toolbar band (see the
  // `html.footer-in body` rule — mobile only, where the footer is in flow).
  const f = document.querySelector('.site-footer');
  if (f && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      document.documentElement.classList.toggle('footer-in', e.isIntersecting);
    }).observe(f);
  }
</script>
