---
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site footer">
  <!-- The footer is fixed behind the page and sits on all 41 routes, so it must
       never cost anything up front: no source elements (their presence starts
       a fetch whatever `preload` says) and the poster carries the panel until
       the script attaches a source as the footer nears the viewport. -->
  <video
    class="footer-video"
    muted
    loop
    playsinline
    webkit-playsinline
    preload="none"
    poster="/hero-poster.jpg"
    aria-hidden="true"
  >
  </video>
  <div class="footer-inner wrap">
    <p class="f-statement">Made slowly.<br />Ridden forever.</p>
    <button class="f-order" type="button" data-order>
      Order a board <span aria-hidden="true">→</span>
    </button>
    <p class="f-meta">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--footer-h);
    z-index: 0;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  /* hero video as the footer backdrop, behind the darkening gradient — same
     treatment as #hero so the two video panels read identically */
  .footer-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.74) contrast(1.55) saturate(1.25);
    /* promote to a GPU layer — iOS Safari otherwise freezes a CSS-filtered
       <video> on its first frame (see #hero) */
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* fallback for browsers without color-mix (Safari <16.2) */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.38),
      rgba(26, 20, 16, 0.56)
    );
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 38%, transparent),
      color-mix(in srgb, var(--ink) 56%, transparent)
    );
  }
  .footer-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* brand statement — same cream as the hero headline, a touch smaller */
  .f-statement {
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--cream);
  }
  .f-order {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: rgba(255, 255, 255, 0.12);
    border: 0;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.85rem 1.6rem;
    cursor: pointer;
    transition: background 0.2s var(--ease), gap 0.3s var(--ease);
  }
  .f-order:hover {
    background: rgba(255, 255, 255, 0.2);
    gap: 0.9rem;
  }
  .f-meta {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--cream) 48%, transparent);
  }

  /* ── scroll-linked blur-in ──
     `--reveal` (0–1) is driven by JS from scroll position: the text sharpens
     and fades in as the footer is uncovered, and blurs back out on scroll up.
     No-JS / fallback keeps the content fully visible and sharp. */
  .footer-inner > * {
    opacity: var(--reveal, 1);
    filter: blur(calc((1 - var(--reveal, 1)) * 12px));
    will-change: opacity, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-inner > * {
      opacity: 1;
      filter: none;
    }
  }
</style>

<script>
  // Drive `--reveal` (0–1) from scroll position: the footer text sharpens and
  // fades in as the fixed footer is uncovered, and blurs back out on scroll up.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer && !reduce) {
    // Measure layout (forces reflow) only on resize/load — never per scroll.
    // Caching winH also stops the reveal wobbling as iOS shows/hides its
    // toolbar (which changes innerHeight mid-scroll).
    let fh = footer.offsetHeight;
    let docH = document.documentElement.scrollHeight;
    let winH = window.innerHeight;
    let ticking = false;

    const compute = () => {
      ticking = false;
      // scrollY is cheap and reflow-free — the only thing read while scrolling.
      const remaining = docH - winH - window.scrollY;
      // Finish the reveal over the first 60% of the footer uncovering, so the
      // text reaches full clarity before the absolute scroll bottom — on mobile
      // the last pixels are often unreachable (browser chrome / rubber-banding).
      const p = Math.min(Math.max(1 - remaining / (fh * 0.6), 0), 1);
      footer.style.setProperty('--reveal', p.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(compute);
      }
    };
    const remeasure = () => {
      fh = footer.offsetHeight;
      docH = document.documentElement.scrollHeight;
      winH = window.innerHeight;
      compute();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    // Filtering products changes the document height without firing `resize`,
    // which would leave docH stale and freeze the reveal. Watch body size so
    // any layout shift (filter, image load) re-measures.
    if ('ResizeObserver' in window) {
      new ResizeObserver(remeasure).observe(document.body);
    }
    remeasure();
  }
</script>

<script>
  import { ambientVideo } from '@/lib/ambientVideo';

  const v = document.querySelector<HTMLVideoElement>('.footer-video');
  // Footer sits behind the page on every route — only load as it comes up.
  // The footer itself is position:fixed and so always "intersects" the
  // viewport; the sentinel at the end of <main> is what actually approaches
  // as the user nears the bottom.
  if (v) ambientVideo(v, { name: 'hero', watch: document.getElementById('footer-sentinel') });
</script>
