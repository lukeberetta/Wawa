---
import { site, whatsappLink } from '@/lib/site';
const year = new Date().getFullYear();
const wa = whatsappLink('Hi Wawa — I’d like to talk about a board.');
---

<footer class="site-footer" aria-label="Site footer">
  <div class="footer-inner wrap">
    <!-- top: columns -->
    <div class="footer-top">
      <div class="f-col f-lead">
        <p class="f-eyebrow">Wooden surfcraft</p>
        <p class="f-tagline">Made by hand,<br />shaped by nature.</p>
        <a class="f-cta" href={wa} target="_blank" rel="noopener noreferrer">Start a board <span class="arrow">→</span></a>
      </div>

      <nav class="f-col f-nav" aria-label="Footer">
        <p class="f-heading">Explore</p>
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="f-col f-connect">
        <p class="f-heading">Connect</p>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="mailto:hello@wawasurfboards.com">Email</a>
        <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </div>

    <!-- base -->
    <div class="footer-base">
      <div class="base-left">
        <a class="footer-logo" href="/" aria-label="Wawa Surfboards"></a>
        <p>© {year} {site.name}</p>
      </div>
      <p>Muizenberg · Cape Town · South Africa</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--footer-h);
    z-index: 0;
    background: var(--ink) url('/img/surfers.jpg') center / cover no-repeat;
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 78%, transparent),
      color-mix(in srgb, var(--ink) 90%, transparent)
    );
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }

  /* ── top columns ── */
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .f-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1rem;
  }
  .f-tagline {
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    margin-bottom: 1.5rem;
  }
  .f-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--cream);
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
    padding-bottom: 3px;
    transition: gap 0.3s var(--ease);
  }
  .f-cta:hover {
    gap: 0.85rem;
  }
  .f-heading {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--warm);
    margin-bottom: 1.1rem;
  }
  .f-nav,
  .f-connect {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .f-nav a,
  .f-connect a {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--cream) 78%, transparent);
    width: fit-content;
    transition: color 0.25s;
  }
  .f-nav a:hover,
  .f-connect a:hover {
    color: var(--cream);
  }

  /* ── logo (masked so it renders in cream on ink) ── */
  .footer-logo {
    display: block;
    width: 40px;
    height: 40px;
    flex: none;
    background: var(--cream);
    -webkit-mask: url('/logo.svg') center / contain no-repeat;
    mask: url('/logo.svg') center / contain no-repeat;
    transition: opacity 0.25s;
  }
  .footer-logo:hover {
    opacity: 0.85;
  }

  /* ── base line ── */
  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--cream) 14%, transparent);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--cream) 55%, transparent);
  }
  .base-left {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  /* ── reveal motion (staggered rise as the curtain lifts) ──
     Only active once JS adds `.anim`; without JS the content is fully visible. */
  .site-footer.anim .footer-inner > * {
    opacity: 0;
    transform: translateY(38px);
    transition: opacity 0.7s var(--ease), transform 0.8s var(--ease);
  }
  .site-footer.anim.revealed .footer-top {
    transition-delay: 0.05s;
  }
  .site-footer.anim.revealed .footer-base {
    transition-delay: 0.18s;
  }
  .site-footer.anim.revealed .footer-inner > * {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 768px) {
    /* Drop the fixed-height curtain: stacked columns exceed --footer-h and
       get clipped. Let the footer flow normally and size to its content. */
    .site-footer {
      position: static;
      height: auto;
    }
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
    }
    .f-lead {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer.anim .footer-inner > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Reveal the footer content when the end-of-page sentinel scrolls into view.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const sentinel = document.getElementById('footer-sentinel');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer) {
    // enable the hidden→reveal transition (no-JS keeps content visible)
    footer.classList.add('anim');

    if (reduce || !sentinel || !('IntersectionObserver' in window)) {
      footer.classList.add('revealed');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => footer.classList.toggle('revealed', e.isIntersecting));
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0 },
      );
      io.observe(sentinel);
    }
  }
</script>
