---
import { site } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site footer">
  <div class="footer-inner wrap">
    <p class="f-statement">Made by hand,<br />shaped by nature.</p>
    <p class="f-meta">© {year} {site.name} · Muizenberg, Cape Town</p>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: var(--footer-h);
    z-index: 0;
    background: var(--ink) url('/img/surfers.jpg') center / cover no-repeat;
    color: var(--cream);
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0;
    /* fallback for browsers without color-mix (Safari <16.2) */
    background: linear-gradient(
      180deg,
      rgba(26, 20, 16, 0.78),
      rgba(26, 20, 16, 0.9)
    );
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--ink) 78%, transparent),
      color-mix(in srgb, var(--ink) 90%, transparent)
    );
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    text-align: center;
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* the brand statement — softened, not stark white */
  .f-statement {
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
  }
  .f-meta {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--cream) 48%, transparent);
  }

  /* ── scroll-linked reveal ──
     `--reveal` (0–1) is driven by JS from scroll position: the text fades up
     into the photo as the footer is uncovered, and back out on scroll up.
     No-JS / fallback keeps the content fully visible. */
  .footer-inner > * {
    opacity: var(--reveal, 1);
    transform: translateY(calc((1 - var(--reveal, 1)) * 30px));
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-inner > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Drive `--reveal` (0–1) from scroll position: the footer text fades up into
  // the photo as the fixed footer is uncovered, and back out on scroll up.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (footer && !reduce) {
    // Measure layout (forces reflow) only on resize/load — never per scroll.
    // Caching winH also stops the reveal wobbling as iOS shows/hides its
    // toolbar (which changes innerHeight mid-scroll).
    let fh = footer.offsetHeight;
    let docH = document.documentElement.scrollHeight;
    let winH = window.innerHeight;
    let ticking = false;

    const compute = () => {
      ticking = false;
      // scrollY is cheap and reflow-free — the only thing read while scrolling.
      const remaining = docH - winH - window.scrollY;
      const p = Math.min(Math.max(1 - remaining / fh, 0), 1);
      footer.style.setProperty('--reveal', p.toFixed(3));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(compute);
      }
    };
    const remeasure = () => {
      fh = footer.offsetHeight;
      docH = document.documentElement.scrollHeight;
      winH = window.innerHeight;
      compute();
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', remeasure);
    window.addEventListener('load', remeasure);
    remeasure();
  }
</script>
