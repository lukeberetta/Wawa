---
import type { Product } from '@/lib/types';
import { formatPrice } from '@/lib/catalog';
import { site, whatsappLink } from '@/lib/site';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const price = formatPrice(product);
const front = product.images[0];
const back = product.images[1] ?? product.images[0];
const enquire = whatsappLink(`Hi Wawa, I'm interested in the ${product.title}.`);
// Buyable when in stock with a variant id and a configured shop domain;
// otherwise the card stays Enquire-only (boards, POA items).
const buyable = product.availableForSale && !!product.variantId && !!site.shopDomain;
// formatPrice returns 'Enquire' for POA items — skip the price box then so the
// overlay doesn't read "Enquire | Enquire".
const hasPrice = price !== 'Enquire';
---

<article class="card fade-in">
  <div class="card-media">
    <img class="face front" src={front.url} alt={front.altText} loading="lazy" />
    <img class="face back" src={back.url} alt={back.altText} loading="lazy" aria-hidden="true" />
    <div class="card-overlay">
      {hasPrice && <span class="overlay-price">{price}</span>}
      {buyable ? (
        <button
          class="overlay-action"
          data-add-to-cart
          data-variant-id={product.variantId}
          data-handle={product.handle}
          data-title={product.title}
          data-price={product.priceRange.minVariantPrice.amount}
          data-image={front.url}
          aria-label={`Add the ${product.title} to cart`}
        >
          Add to cart
        </button>
      ) : (
        <a
          class="overlay-action"
          href={enquire}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Enquire about the ${product.title}`}
        >
          Enquire
        </a>
      )}
    </div>
  </div>
  <div class="card-meta">
    <h3>{product.title}</h3>
  </div>
  <p class="card-cat">{product.tags[0] ?? product.productType}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .card-media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s var(--ease);
  }
  .back {
    opacity: 0;
  }
  .card-media:hover .back {
    opacity: 1;
  }
  .card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: stretch;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    pointer-events: none;
  }
  .card-media:hover .card-overlay,
  .card-media:focus-within .card-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .overlay-price {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--cream);
    white-space: nowrap;
  }
  .overlay-action {
    display: flex;
    align-items: center;
    padding: 0.85rem 1.4rem;
    font-family: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }
  .overlay-action:hover {
    opacity: 0.85;
  }
  /* POA cards have no price box — let the lone action fill the bar. */
  .overlay-action:only-child {
    flex: 1;
    justify-content: center;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0.85rem;
    gap: 1rem;
  }
  .card-meta h3 {
    font-size: 1.1rem;
  }
  .card-cat {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  /* Touch devices have no hover — keep actions visible. */
  @media (hover: none) {
    .card-overlay {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
</style>
