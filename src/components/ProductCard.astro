---
import type { Product } from '@/lib/types';
import { formatPrice, slug } from '@/lib/catalog';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const price = formatPrice(product);
const href = `/products/${slug(product.productType)}/${product.handle}`;
---

<article class="card fade-in">
  <div class="card-media">
    <img class="face" src="/img/fish-front.jpg" alt="" loading="lazy" />
    <img class="face back" src="/img/fish-back.jpg" alt="" loading="lazy" />
    <a class="card-link" href={href} aria-label={`View the ${product.title}`}></a>
  </div>
  <div class="card-meta">
    <h3><a href={href}>{product.title}</a></h3>
    <p class="card-cat">{product.tags[0] ?? product.productType}</p>
    <p class="card-price">{price}</p>
  </div>
</article>

<style>
  /* the card is one cell of the catalog grid: it draws its own right + bottom
     hairline (the grid container supplies the top + left), so the rules stay
     single and a ragged final row leaves clean empty space, never grey cells.
     borders live here, not on the page's `.product-grid > *`, because Astro
     scopes styles per file — a parent selector can't reach this child. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* min-width:0 stops the aspect-ratio media below from giving this grid cell
       an automatic minimum width — without it the `1fr` columns drift unequal
       and the media (and so the whole cell) ends up taller in one column */
    min-width: 0;
    background: var(--cream);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
  }
  .card-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s var(--ease);
  }
  /* front view at rest; the back view fades in on hover */
  .back {
    opacity: 0;
  }
  .card-media:hover .back {
    opacity: 1;
  }
  /* meta sits inside the cell, divided from the image by a single hairline —
     the grid lines continue straight through the row. one consistent column
     rhythm: title leads, category eyebrow, then price — same on every device. */
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.1rem 1.2rem;
    border-top: 1px solid var(--rule);
  }
  /* keep titles to a single line — a long name (e.g. "Model P Longboard")
     truncates rather than wrapping, so every cell's meta stays the same height
     and the row's hairlines line up */
  .card-meta h3 {
    font-size: 1.1rem;
    /* line-height gives descenders (g, p, y) room so overflow:hidden clips at
       the edges for the ellipsis without cropping the glyph tails */
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-meta h3 a {
    transition: color 0.2s var(--ease);
  }
  .card-meta h3 a:hover {
    color: var(--warm);
  }
  .card-cat {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-price {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--warm);
    white-space: nowrap;
  }
  /* mobile cards carry a big image — tighten the meta padding */
  @media (max-width: 520px) {
    .card-meta {
      gap: 0.15rem;
      padding: 0.85rem 0.9rem 1rem;
    }
    .card-meta h3 {
      font-size: 1.1rem;
    }
  }
</style>
