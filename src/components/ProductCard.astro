---
import type { Product } from '@/lib/types';
import { formatPrice, slug, isBuyable, isGoods } from '@/lib/catalog';
import { srcset } from '@/lib/img';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const price = formatPrice(product);
// Availability chip, so buy-now and made-to-order sit apart at a glance.
// Gift cards skip it (nothing to "make"); unreleased accessories already say
// "Coming soon" in the price line.
const buyable = isBuyable(product);
const status = product.customAmount
  ? null
  : buyable
    ? 'Buy online'
    : !isGoods(product)
      ? 'Made to order'
      : null;
const href = `/products/${slug(product.productType)}/${product.handle}`;
// Every product has a lead image — its own deck shot, or the empty-room plate.
const front = product.images[0];
// Hull shot cross-fades in on hover, so only products with a real pair get one.
// Decorative — the deck img already names the product, so it's aria-hidden.
const back = product.images[1];
const frontAlt = front?.altText ?? product.title;
// Widest slot a card takes: the home rail (66% → 40% → 22%) runs a little
// wider than the shop grid (50% → 33% → 25%), so one value covers both.
const sizes = '(min-width: 900px) 25vw, (min-width: 560px) 40vw, 66vw';
---

<article class="card">
  <div class:list={['card-media', { grain: front && !front.placeholder }]}>
    {/* wireframe placeholder — real deck/hull shots drop in here later */}
    {front && (
      <img
        class:list={['card-img', { 'is-placeholder': front.placeholder }]}
        src={front.url}
        srcset={srcset(front.url)}
        sizes={sizes}
        alt={frontAlt}
        loading="lazy"
        decoding="async"
        width="1600"
        height="2000"
      />
    )}
    {/* the price line already says it for unreleased accessories — don't say it twice */}
    {front?.placeholder && price !== 'Coming soon' && (
      <span class="soon-label" aria-hidden="true">Coming soon</span>
    )}
    {/* No src: the hull shot only ever shows on hover, so touch screens must
        not pay for it. A script in Motion.astro promotes data-src/data-srcset
        on hover-capable devices — see "Card back images" there. */}
    {back && (
      <img
        class="card-img card-img-back"
        data-src={back.url}
        data-srcset={srcset(back.url)}
        sizes={sizes}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        width="1600"
        height="2000"
      />
    )}
    {status && (
      <span class:list={['card-status', { 'is-live': buyable }]}>{status}</span>
    )}
    <a class="card-link" href={href} aria-label={`View the ${product.title}`}></a>
  </div>
  <div class="card-meta">
    <h3><a href={href}>{product.title}</a></h3>
    <p class="card-cat">{product.tags[0] ?? product.productType}</p>
    <p class="card-price">{price}</p>
  </div>
</article>

<style>
  /* the card is one cell of the catalog grid: it draws its own right + bottom
     hairline (the grid container supplies the top + left), so the rules stay
     single and a ragged final row leaves clean empty space, never grey cells.
     borders live here, not on the page's `.product-grid > *`, because Astro
     scopes styles per file — a parent selector can't reach this child. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* min-width:0 stops the aspect-ratio media below from giving this grid cell
       an automatic minimum width — without it the `1fr` columns drift unequal
       and the media (and so the whole cell) ends up taller in one column */
    min-width: 0;
    background: var(--cream);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    flex-shrink: 0;
    /* the placeholder tone itself, until photography lands */
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
  }
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* empty-room plate: soften it so it reads as "not shot yet", not as a photo.
     scaled up a touch so the blur doesn't bleed a pale halo in at the edges */
  .card-img.is-placeholder {
    filter: blur(6px) brightness(0.6);
    transform: scale(1.04);
  }
  .soon-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream);
    pointer-events: none;
  }
  /* deck → hull cross-fade. gated on `hover: hover` so touch devices never get
     stuck showing the hull after a tap, and driven by :focus-within too so a
     keyboard tab onto the card link reveals the same shot. */
  .card-img-back {
    opacity: 0;
  }
  @media (hover: hover) {
    .card-img-back {
      transition: opacity 0.45s var(--ease);
    }
    .card-media:hover .card-img-back,
    .card-media:focus-within .card-img-back {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-img-back {
      transition: none;
    }
  }
  /* availability chip, top-left over the image. Made to order is a quiet
     translucent wash; Buy online is solid ink, the one that should pop. */
  .card-status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    pointer-events: none;
    padding: 0.4rem 0.6rem;
    font-size: 0.6rem;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: color-mix(in srgb, var(--cream) 82%, transparent);
  }
  .card-status.is-live {
    color: var(--cream);
    background: var(--ink);
  }
  @media (max-width: 520px) {
    .card-status {
      top: 0.5rem;
      left: 0.5rem;
      padding: 0.35rem 0.5rem;
      font-size: 0.55rem;
    }
  }
  .card-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
  }

  /* meta sits inside the cell, divided from the image by a single hairline —
     the grid lines continue straight through the row. one consistent column
     rhythm: title leads, category eyebrow, then price — same on every device. */
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.1rem 1.2rem;
    border-top: 1px solid var(--rule);
  }
  /* keep titles to a single line — a long name (e.g. "Model P Longboard")
     truncates rather than wrapping, so every cell's meta stays the same height
     and the row's hairlines line up */
  .card-meta h3 {
    font-size: 1.1rem;
    /* line-height gives descenders (g, p, y) room so overflow:hidden clips at
       the edges for the ellipsis without cropping the glyph tails */
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-meta h3 a {
    transition: color 0.2s var(--ease);
  }
  .card-meta h3 a:hover {
    color: var(--warm);
  }
  .card-cat {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-price {
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
    color: var(--warm);
    white-space: nowrap;
  }
  /* mobile cards carry a big image — tighten the meta padding */
  @media (max-width: 520px) {
    .card-meta {
      gap: 0.15rem;
      padding: 0.85rem 0.9rem 1rem;
    }
  }
</style>
