---
import type { Product } from '@/lib/types';
import { formatPrice, slug } from '@/lib/catalog';
import { site, whatsappLink } from '@/lib/site';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const price = formatPrice(product);
const front = product.images[0];
const back = product.images[1] ?? product.images[0];
const href = `/products/${slug(product.productType)}/${product.handle}`;
const enquire = whatsappLink(`Hi Wawa, I'm interested in the ${product.title}.`);
// Buyable when in stock with a variant id and a configured shop domain;
// otherwise the card stays Enquire-only (boards, POA items).
const buyable = product.availableForSale && !!product.variantId && !!site.shopDomain;
// formatPrice returns 'Enquire' for POA items — skip the price box then so the
// overlay doesn't read "Enquire | Enquire".
const hasPrice = price !== 'Enquire';
---

<article class="card fade-in">
  <div class="card-media">
    <a class="card-link" href={href} aria-label={`View the ${product.title}`}>
      <img class="face front" src={front.url} alt={front.altText} loading="lazy" />
      <img class="face back" src={back.url} alt={back.altText} loading="lazy" aria-hidden="true" />
    </a>
    <div class="card-overlay">
      {hasPrice && <span class="overlay-price">{price}</span>}
      {buyable ? (
        <button
          class="overlay-action"
          data-add-to-cart
          data-variant-id={product.variantId}
          data-handle={product.handle}
          data-title={product.title}
          data-price={product.priceRange.minVariantPrice.amount}
          data-image={front.url}
          aria-label={`Add the ${product.title} to cart`}
        >
          Add to cart
        </button>
      ) : (
        <a
          class="overlay-action"
          href={enquire}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Enquire about the ${product.title}`}
        >
          Enquire
        </a>
      )}
    </div>
  </div>
  <div class="card-meta">
    <h3><a href={href}>{product.title}</a></h3>
    <p class="card-cat">{product.tags[0] ?? product.productType}</p>
    <p class="card-price">{price}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .card-media {
    position: relative;
    aspect-ratio: 3 / 4;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  .card-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
  }
  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s var(--ease), filter 0.5s var(--ease);
  }
  .back {
    opacity: 0;
  }
  .card-media:hover .back {
    opacity: 1;
  }
  /* desaturate at rest, restore colour on hover — only where hover exists, so
     touch devices (which never hover) keep the images in full colour */
  @media (hover: hover) {
    .face {
      /* grayscale, then a dark-wood wash — sepia warmed, hue pulled off yellow
         toward red-brown to echo the footer's deep ink tone */
      filter: grayscale(1) sepia(0.85) hue-rotate(-18deg) saturate(0.3)
        brightness(0.66) contrast(1.08);
    }
    .card-media:hover .face {
      filter: grayscale(0) sepia(0);
    }
  }
  .card-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: stretch;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    pointer-events: none;
  }
  .card-media:hover .card-overlay,
  .card-media:focus-within .card-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .overlay-price {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0.85rem 1.1rem;
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid var(--rule);
    white-space: nowrap;
  }
  .overlay-action {
    display: flex;
    align-items: center;
    padding: 0.85rem 1.4rem;
    font-family: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s var(--ease);
  }
  .overlay-action:hover {
    opacity: 0.85;
  }
  /* POA cards have no price box — let the lone action fill the bar. */
  .overlay-action:only-child {
    flex: 1;
    justify-content: center;
  }
  /* one consistent column rhythm — title leads, category sits as a quiet
     eyebrow beneath it (single gap, not two stray margins) */
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.6rem;
  }
  .card-meta h3 {
    font-size: 1.1rem;
    line-height: 1.1;
  }
  .card-meta h3 a {
    transition: color 0.2s var(--ease);
  }
  .card-meta h3 a:hover {
    color: var(--warm);
  }
  .card-cat {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* hidden on desktop — the hover overlay carries the price there; shown only
     where the overlay is suppressed (touch / narrow), see the media query */
  .card-price {
    display: none;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--warm);
    white-space: nowrap;
  }
  /* mobile cards carry a big image — give the title matching presence */
  @media (max-width: 520px) {
    .card-meta {
      gap: 0.15rem;
      margin-top: 0.7rem;
    }
    .card-meta h3 {
      font-size: 1.1rem;
    }
  }
  /* No hover (touch) or a narrow viewport — hide the action overlay; the whole
     card links to the PDP where add-to-cart / enquire live. */
  @media (hover: none), (max-width: 768px) {
    .card-overlay {
      display: none;
    }
    .card-price {
      display: block;
    }
  }
</style>
