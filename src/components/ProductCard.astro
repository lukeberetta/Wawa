---
import type { Product } from '@/lib/types';
import { formatPrice, slug } from '@/lib/catalog';
import { site } from '@/lib/site';

export interface Props {
  product: Product;
}
const { product } = Astro.props;
const price = formatPrice(product);
const href = `/products/${slug(product.productType)}/${product.handle}`;
// Buyable only with stock + a variant id + a configured shop — mirrors the PDP.
// These get a quick-add straight from the card; everything else links to the PDP.
const buyable = product.availableForSale && !!product.variantId && !!site.shopDomain;
const lead = product.images[0]?.url ?? '';
---

<article class="card fade-in">
  <div class="card-media">
    <!-- wireframe placeholder — real deck/hull shots drop in here later -->
    <a class="card-link" href={href} aria-label={`View the ${product.title}`}></a>
    {
      buyable && (
        <button
          class="card-add"
          data-add-to-cart
          data-variant-id={product.variantId}
          data-handle={product.handle}
          data-title={product.title}
          data-price={product.priceRange.minVariantPrice.amount}
          data-image={lead}
          aria-label={`Add ${product.title} to cart`}
        >
          Add to cart
        </button>
      )
    }
  </div>
  <div class="card-meta">
    <h3><a href={href}>{product.title}</a></h3>
    <p class="card-cat">{product.tags[0] ?? product.productType}</p>
    <p class="card-price">{price}</p>
  </div>
</article>

<style>
  /* the card is one cell of the catalog grid: it draws its own right + bottom
     hairline (the grid container supplies the top + left), so the rules stay
     single and a ragged final row leaves clean empty space, never grey cells.
     borders live here, not on the page's `.product-grid > *`, because Astro
     scopes styles per file — a parent selector can't reach this child. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* min-width:0 stops the aspect-ratio media below from giving this grid cell
       an automatic minimum width — without it the `1fr` columns drift unequal
       and the media (and so the whole cell) ends up taller in one column */
    min-width: 0;
    background: var(--cream);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    flex-shrink: 0;
    /* the placeholder tone itself, until photography lands */
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
    overflow: hidden;
  }
  .card-link {
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
  }

  /* ── Quick add ──
     A thumb-friendly button that lets buyable items go straight to the cart
     without a PDP visit. On pointer devices it rests hidden and rises on hover;
     on touch (no hover) it stays visible so it's always tappable. Sits above
     the full-card link (z-index) so the tap lands on the button, not the link. */
  .card-add {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 2;
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    padding: 0.7rem;
    cursor: pointer;
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease),
      background 0.2s var(--ease);
  }
  .card-add:hover {
    background: color-mix(in srgb, var(--ink) 85%, var(--warm));
  }
  /* pointer devices: tuck it away until the card is hovered/focused */
  @media (hover: hover) {
    .card-add {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    .card-media:hover .card-add,
    .card-add:focus-visible {
      opacity: 1;
      transform: none;
    }
  }

  /* meta sits inside the cell, divided from the image by a single hairline —
     the grid lines continue straight through the row. one consistent column
     rhythm: title leads, category eyebrow, then price — same on every device. */
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.1rem 1.2rem;
    border-top: 1px solid var(--rule);
  }
  /* keep titles to a single line — a long name (e.g. "Model P Longboard")
     truncates rather than wrapping, so every cell's meta stays the same height
     and the row's hairlines line up */
  .card-meta h3 {
    font-size: 1.1rem;
    /* line-height gives descenders (g, p, y) room so overflow:hidden clips at
       the edges for the ellipsis without cropping the glyph tails */
    line-height: 1.3;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-meta h3 a {
    transition: color 0.2s var(--ease);
  }
  .card-meta h3 a:hover {
    color: var(--warm);
  }
  .card-cat {
    margin-top: 0.15rem;
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-price {
    font-size: var(--fs-caption);
    letter-spacing: 0.02em;
    color: var(--warm);
    white-space: nowrap;
  }
  /* mobile cards carry a big image — tighten the meta padding */
  @media (max-width: 520px) {
    .card-meta {
      gap: 0.15rem;
      padding: 0.85rem 0.9rem 1rem;
    }
  }
</style>
