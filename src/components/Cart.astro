---
/**
 * Global cart drawer. Renders nothing meaningful until a shop domain is set
 * (site.shopDomain) — that single switch turns commerce on across the site.
 * Items are added via delegated clicks on [data-add-to-cart] buttons
 * (ProductCard), held in localStorage, and checked out through one Shopify
 * cart permalink (Yoco runs on the hosted checkout).
 */
import { site } from '@/lib/site';
const enabled = !!site.shopDomain;
---

{
  enabled && (
    <>
      <div class="cart-overlay" hidden />
      <aside id="cart-drawer" class="cart-drawer" aria-label="Cart" aria-hidden="true">
        <header class="cart-head">
          <h2>Cart <span class="cart-head-count">(<span data-cart-count>0</span>)</span></h2>
          <button class="cart-close" aria-label="Close cart">&times;</button>
        </header>
        <div class="cart-lines" data-cart-lines data-lenis-prevent />
        <div class="cart-empty" data-cart-empty>
          <p class="cart-empty-line">Your cart is empty.</p>
          <a class="cart-empty-link" href="/products">
            Browse the range <span aria-hidden="true">→</span>
          </a>
        </div>
        <footer class="cart-foot" data-cart-foot hidden>
          <div class="cart-subtotal">
            <span>Subtotal</span>
            <span data-cart-subtotal />
          </div>
          <p class="cart-note">Shipping &amp; taxes calculated at checkout.</p>
          <a class="cart-checkout" data-cart-checkout href="#">Checkout</a>
        </footer>
      </aside>
    </>
  )
}

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 125;
    background: color-mix(in srgb, var(--ink) 48%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .cart-overlay.open {
    opacity: 1;
  }
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 126;
    width: min(90vw, 408px);
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    /* clear the status bar in standalone (env is 0 in normal browsing) */
    padding-top: env(safe-area-inset-top);
    background: var(--cream);
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease);
  }
  .cart-drawer.open {
    transform: translateX(0);
  }
  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--bar-h);
    padding: 0 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  /* match the nav link type */
  .cart-head h2 {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    font-weight: var(--fw-light);
  }
  .cart-head-count {
    color: var(--muted);
  }
  .cart-close {
    background: none;
    border: 0;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    padding: 0 0.1rem;
    transition: color 0.2s var(--ease);
  }
  .cart-close:hover {
    color: var(--ink);
  }
  .cart-lines {
    flex: 1;
    /* without this a flex item won't shrink below its content height, so
       overflow-y never kicks in and the list pushes the footer off-screen */
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 1.75rem 1rem;
  }
  .cart-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    text-align: center;
  }
  .cart-empty-line {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .cart-empty-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: gap 0.3s var(--ease);
  }
  .cart-empty-link:hover {
    gap: 0.85rem;
  }
  /* `display: flex` above would otherwise beat the [hidden] UA rule */
  .cart-empty[hidden] {
    display: none;
  }
  /*
   * Cart lines are injected via innerHTML at runtime, so they never receive
   * Astro's scoped-style hash attribute. Target them through :global() (kept
   * under the static .cart-lines parent so the rules don't leak site-wide).
   */
  .cart-lines :global(.cart-line) {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  /* removing: slide the row aside and fade before it's dropped from the list */
  .cart-lines :global(.cart-line-out) {
    opacity: 0;
    transform: translateX(14px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cart-lines :global(.cart-line) {
      transition: none;
    }
  }
  .cart-lines :global(.cart-line:last-child) {
    border-bottom: none;
  }
  .cart-lines :global(.cart-line-img) {
    flex: none;
    width: 52px;
    height: 64px;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }
  .cart-lines :global(.cart-line-title) {
    font-size: 0.9rem;
    line-height: 1.25;
    padding-right: 0.5rem;
  }
  .cart-lines :global(.cart-line-price) {
    font-size: 0.78rem;
    color: var(--warm);
    margin-top: 0.2rem;
  }
  .cart-lines :global(.cart-qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    margin-top: 0.55rem;
  }
  .cart-lines :global(.cart-qty button) {
    width: 26px;
    height: 26px;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    transition: background 0.2s var(--ease);
  }
  .cart-lines :global(.cart-qty button:hover) {
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }
  .cart-lines :global(.cart-qty span) {
    min-width: 28px;
    text-align: center;
    font-size: 0.82rem;
    border-inline: 1px solid var(--rule);
    align-self: stretch;
    display: grid;
    place-items: center;
  }
  .cart-lines :global(.cart-remove) {
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
    padding: 0;
    align-self: center;
    transition: color 0.2s var(--ease);
  }
  .cart-lines :global(.cart-remove:hover) {
    color: var(--ink);
  }
  .cart-foot {
    padding: 1.25rem 1.75rem calc(1.75rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule);
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cart-note {
    font-size: 0.72rem;
    color: var(--muted);
    margin: 0.4rem 0 1rem;
  }
  .cart-checkout {
    display: block;
    text-align: center;
    padding: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    transition: opacity 0.2s var(--ease);
  }
  .cart-checkout:hover {
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer,
    .cart-overlay {
      transition: none;
    }
  }
</style>

{
  enabled && (
    <script>
      import {
        getLines,
        add,
        setQty,
        subtotal,
        count,
        onChange,
        buildCheckoutUrl,
        formatZAR,
        type CartLine,
      } from '@/lib/cart';
      import { lockScroll } from '@/lib/scrollLock';
      import { trapFocus } from '@/lib/focusTrap';

      const drawer = document.getElementById('cart-drawer');
      const overlay = document.querySelector<HTMLDivElement>('.cart-overlay');
      const linesEl = document.querySelector<HTMLDivElement>('[data-cart-lines]');
      const emptyEl = document.querySelector<HTMLParagraphElement>('[data-cart-empty]');
      const footEl = document.querySelector<HTMLElement>('[data-cart-foot]');
      const subEl = document.querySelector<HTMLSpanElement>('[data-cart-subtotal]');
      const checkoutEl = document.querySelector<HTMLAnchorElement>('[data-cart-checkout]');

      const closeBtn = document.querySelector<HTMLButtonElement>('.cart-close');
      let releaseTrap: (() => void) | null = null;

      function setOpen(open: boolean) {
        if (!drawer || !overlay) return;
        drawer.setAttribute('aria-hidden', String(!open));
        drawer.classList.toggle('open', open);
        overlay.classList.toggle('open', open);
        lockScroll(open);
        if (open) {
          overlay.hidden = false;
          releaseTrap = trapFocus(drawer, closeBtn);
        } else {
          releaseTrap?.();
          releaseTrap = null;
          setTimeout(() => { if (!drawer.classList.contains('open')) overlay.hidden = true; }, 300);
        }
      }

      let prevCount = count();
      function render(lines: CartLine[]) {
        // count badges (Nav + drawer header) — bump them when the total rises
        const c = count();
        const grew = c > prevCount;
        prevCount = c;
        document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
          el.textContent = String(c);
          if (grew) {
            el.classList.remove('cart-bump');
            // reflow so the animation can retrigger on a repeat add
            void el.offsetWidth;
            el.classList.add('cart-bump');
          }
        });
        const has = lines.length > 0;
        if (emptyEl) emptyEl.hidden = has;
        if (footEl) footEl.hidden = !has;
        if (subEl) subEl.textContent = formatZAR(subtotal());
        if (checkoutEl) checkoutEl.href = buildCheckoutUrl(lines) || '#';
        if (!linesEl) return;
        linesEl.innerHTML = lines
          .map(
            (l) => `
            <div class="cart-line" data-line="${l.variantId}">
              <span class="cart-line-img wf-ph"></span>
              <div>
                <div class="cart-line-title">${l.title}</div>
                <div class="cart-line-price">${formatZAR(l.price)}</div>
                <div class="cart-qty">
                  <button data-dec aria-label="Decrease quantity">&minus;</button>
                  <span>${l.qty}</span>
                  <button data-inc aria-label="Increase quantity">+</button>
                </div>
              </div>
              <button class="cart-remove" data-rm aria-label="Remove item">&times;</button>
            </div>`,
          )
          .join('');
      }

      // ── Add to cart (delegated; ProductCard buttons) ──
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-add-to-cart]');
        if (!btn) return;
        e.preventDefault();
        const d = btn.dataset;
        add({
          variantId: d.variantId || '',
          handle: d.handle || '',
          title: d.title || '',
          price: Number(d.price || 0),
          image: d.image || '',
        });
        setOpen(true);
      });

      // ── Open / close ──
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cart-toggle]')) setOpen(true);
      });
      document.querySelector('.cart-close')?.addEventListener('click', () => setOpen(false));
      overlay?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

      // ── Line controls (delegated) ──
      linesEl?.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest<HTMLElement>('[data-line]');
        if (!row || row.classList.contains('cart-line-out')) return;
        const id = row.dataset.line!;
        const cur = getLines().find((l) => l.variantId === id)?.qty ?? 0;
        const t = e.target as HTMLElement;
        if (t.closest('[data-inc]')) setQty(id, cur + 1);
        else if (t.closest('[data-dec]')) setQty(id, cur - 1);
        else if (t.closest('[data-rm]')) {
          // ease the row out, then drop it — the re-render leaves it gone
          let removed = false;
          const done = () => {
            if (removed) return;
            removed = true;
            setQty(id, 0);
          };
          row.classList.add('cart-line-out');
          row.addEventListener('transitionend', done, { once: true });
          // fallback if transitionend is missed (e.g. reduced motion)
          setTimeout(done, 320);
        }
      });

      onChange(render);
      render(getLines());
    </script>
  )
}
