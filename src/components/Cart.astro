---
/**
 * Global cart drawer. Renders nothing meaningful until a shop domain is set
 * (site.shopDomain) — that single switch turns commerce on across the site.
 * Items are added via delegated clicks on [data-add-to-cart] buttons
 * (ProductCard), held in localStorage, and checked out through one Shopify
 * cart permalink (Yoco runs on the hosted checkout).
 */
import { site } from '@/lib/site';
const enabled = !!site.shopDomain;
---

{
  enabled && (
    <>
      <div class="cart-overlay" hidden />
      <aside id="cart-drawer" class="cart-drawer" aria-label="Cart" aria-hidden="true">
        <header class="cart-head">
          <h2>Cart</h2>
          <button class="cart-close" aria-label="Close cart">&times;</button>
        </header>
        <div class="cart-lines" data-cart-lines />
        <p class="cart-empty" data-cart-empty>Your cart is empty.</p>
        <footer class="cart-foot" data-cart-foot hidden>
          <div class="cart-subtotal">
            <span>Subtotal</span>
            <span data-cart-subtotal />
          </div>
          <p class="cart-note">Shipping &amp; taxes calculated at checkout.</p>
          <a class="cart-checkout" data-cart-checkout href="#">Checkout</a>
        </footer>
      </aside>
    </>
  )
}

<style>
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 115;
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .cart-overlay.open {
    opacity: 1;
  }
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 116;
    width: min(88vw, 380px);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border-left: 1px solid var(--rule);
    transform: translateX(100%);
    transition: transform 0.4s var(--ease);
  }
  .cart-drawer.open {
    transform: translateX(0);
  }
  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.75rem 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .cart-head h2 {
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cart-close {
    background: none;
    border: 0;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--ink);
    cursor: pointer;
    padding: 0 0.25rem;
  }
  .cart-lines {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 1.75rem;
  }
  .cart-empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 0.9rem;
  }
  /* `display: flex` above would otherwise beat the [hidden] UA rule */
  .cart-empty[hidden] {
    display: none;
  }
  .cart-line {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cart-line img {
    width: 56px;
    height: 72px;
    object-fit: cover;
    background: color-mix(in srgb, var(--warm) 8%, var(--cream));
  }
  .cart-line-title {
    font-size: 0.95rem;
  }
  .cart-line-price {
    font-size: 0.8rem;
    color: var(--warm);
    margin-top: 0.2rem;
  }
  .cart-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule);
    margin-top: 0.5rem;
  }
  .cart-qty button {
    width: 28px;
    height: 28px;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
  }
  .cart-qty span {
    min-width: 28px;
    text-align: center;
    font-size: 0.85rem;
  }
  .cart-remove {
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    align-self: start;
  }
  .cart-remove:hover {
    color: var(--ink);
  }
  .cart-foot {
    padding: 1.25rem 1.75rem 1.75rem;
    border-top: 1px solid var(--rule);
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cart-note {
    font-size: 0.72rem;
    color: var(--muted);
    margin: 0.4rem 0 1rem;
  }
  .cart-checkout {
    display: block;
    text-align: center;
    padding: 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--ink);
    border: 1px solid var(--ink);
    transition: opacity 0.2s var(--ease);
  }
  .cart-checkout:hover {
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer,
    .cart-overlay {
      transition: none;
    }
  }
</style>

{
  enabled && (
    <script>
      import {
        getLines,
        add,
        setQty,
        subtotal,
        count,
        onChange,
        buildCheckoutUrl,
        formatZAR,
        type CartLine,
      } from '@/lib/cart';

      const drawer = document.getElementById('cart-drawer');
      const overlay = document.querySelector<HTMLDivElement>('.cart-overlay');
      const linesEl = document.querySelector<HTMLDivElement>('[data-cart-lines]');
      const emptyEl = document.querySelector<HTMLParagraphElement>('[data-cart-empty]');
      const footEl = document.querySelector<HTMLElement>('[data-cart-foot]');
      const subEl = document.querySelector<HTMLSpanElement>('[data-cart-subtotal]');
      const checkoutEl = document.querySelector<HTMLAnchorElement>('[data-cart-checkout]');

      // ── Scroll lock (iOS-safe; mirrors Nav) ──
      let lockedY = 0;
      function lockScroll(lock: boolean) {
        const b = document.body;
        if (lock) {
          lockedY = window.scrollY;
          b.style.position = 'fixed';
          b.style.top = `-${lockedY}px`;
          b.style.left = '0';
          b.style.right = '0';
        } else {
          b.style.position = '';
          b.style.top = '';
          b.style.left = '';
          b.style.right = '';
          window.scrollTo(0, lockedY);
        }
      }

      function setOpen(open: boolean) {
        if (!drawer || !overlay) return;
        // close the nav menu first so the two drawers never fight over scroll lock
        if (open) {
          const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
          if (navToggle?.getAttribute('aria-expanded') === 'true') navToggle.click();
        }
        drawer.setAttribute('aria-hidden', String(!open));
        drawer.classList.toggle('open', open);
        overlay.classList.toggle('open', open);
        lockScroll(open);
        if (open) overlay.hidden = false;
        else setTimeout(() => { if (!drawer.classList.contains('open')) overlay.hidden = true; }, 300);
      }

      function render(lines: CartLine[]) {
        // count badges (Nav)
        document.querySelectorAll('[data-cart-count]').forEach((el) => {
          el.textContent = String(count());
        });
        const has = lines.length > 0;
        if (emptyEl) emptyEl.hidden = has;
        if (footEl) footEl.hidden = !has;
        if (subEl) subEl.textContent = formatZAR(subtotal());
        if (checkoutEl) checkoutEl.href = buildCheckoutUrl(lines) || '#';
        if (!linesEl) return;
        linesEl.innerHTML = lines
          .map(
            (l) => `
            <div class="cart-line" data-line="${l.variantId}">
              <img src="${l.image}" alt="" loading="lazy" />
              <div>
                <div class="cart-line-title">${l.title}</div>
                <div class="cart-line-price">${formatZAR(l.price)}</div>
                <div class="cart-qty">
                  <button data-dec aria-label="Decrease quantity">&minus;</button>
                  <span>${l.qty}</span>
                  <button data-inc aria-label="Increase quantity">+</button>
                </div>
              </div>
              <button class="cart-remove" data-rm>Remove</button>
            </div>`,
          )
          .join('');
      }

      // ── Add to cart (delegated; ProductCard buttons) ──
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-add-to-cart]');
        if (!btn) return;
        e.preventDefault();
        const d = btn.dataset;
        add({
          variantId: d.variantId || '',
          handle: d.handle || '',
          title: d.title || '',
          price: Number(d.price || 0),
          image: d.image || '',
        });
        setOpen(true);
      });

      // ── Open / close ──
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cart-toggle]')) setOpen(true);
      });
      document.querySelector('.cart-close')?.addEventListener('click', () => setOpen(false));
      overlay?.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

      // ── Line controls (delegated) ──
      linesEl?.addEventListener('click', (e) => {
        const row = (e.target as HTMLElement).closest<HTMLElement>('[data-line]');
        if (!row) return;
        const id = row.dataset.line!;
        const cur = getLines().find((l) => l.variantId === id)?.qty ?? 0;
        const t = e.target as HTMLElement;
        if (t.closest('[data-inc]')) setQty(id, cur + 1);
        else if (t.closest('[data-dec]')) setQty(id, cur - 1);
        else if (t.closest('[data-rm]')) setQty(id, 0);
      });

      onChange(render);
      render(getLines());
    </script>
  )
}
