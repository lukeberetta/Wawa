---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import FooterNav from '@/components/FooterNav.astro';
import Footer from '@/components/Footer.astro';
import Motion from '@/components/Motion.astro';
import Cart from '@/components/Cart.astro';
import OrderModal from '@/components/OrderModal.astro';
import { site } from '@/lib/site';
import { organization, website } from '@/lib/schema';

export interface Props {
  title?: string;
  description?: string;
  current?: string;
  overlay?: boolean;
  /** Extra JSON-LD nodes (Product, Article, BreadcrumbList) merged into the
   *  page's `@graph` alongside the always-present Organization + WebSite. */
  schema?: Record<string, unknown>[];
}

const {
  title = `${site.name} · ${site.location}`,
  description = site.description,
  current,
  overlay = false,
  schema = [],
} = Astro.props;

// Share card: an 1800s engraving of Hawaiian surfers — the alaia/paipo lineage
// the catalog copy draws on. Absolute URL; scrapers won't resolve a relative one.
const ogImage = new URL('/og-image.jpg', site.url).href;
const ogImageAlt = 'Engraving of Hawaiian surfers riding a wave on wooden boards';
// Per-page, so a shared product link doesn't preview as the homepage.
const canonical = new URL(Astro.url.pathname, site.url).href;

// One `@graph` per page. Organization carries the SERP logo and the shop's
// address/hours; WebSite is what lets Google print "Wawa Surfboards" as the
// site name instead of the bare domain.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization(), website(), ...schema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1410" />

    <!-- Flag JS early (before paint) so the .fade-in reveal only arms when it
         can actually be driven — no-JS keeps all content visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- iOS / Android standalone: Add to Home Screen launches chrome-free -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Wawa" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons. Google renders a result favicon at 48px and only considers
         icons that are square and a multiple of 48 — the old set topped out at
         32px, which is why the SERP fell back to a generic globe. 16/32 are the
         single-W monogram (browser tabs), 48+ the full wordmark tile. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preload the one brand face so text settles on PolySans without a
         flash of the system fallback; @font-face in global.css picks it up. -->
    <link
      rel="preload"
      href="/fonts/PolySans-Neutral.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav current={current} overlay={overlay} />
    <main id="main">
      <slot />
      <FooterNav />
      <div id="footer-sentinel" aria-hidden="true"></div>
    </main>
    <Footer />
    <Cart />
    <OrderModal />
    <Motion />
  </body>
</html>
