---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import FooterNav from '@/components/FooterNav.astro';
import Footer from '@/components/Footer.astro';
import Motion from '@/components/Motion.astro';
import Cart from '@/components/Cart.astro';
import { site } from '@/lib/site';

export interface Props {
  title?: string;
  description?: string;
  current?: string;
  overlay?: boolean;
}

const {
  title = `${site.name} · ${site.location}`,
  description = site.description,
  current,
  overlay = false,
} = Astro.props;

const ogImage = `${site.url}/og-image.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1410" />

    <!-- Flag JS early (before paint) so the .fade-in reveal only arms when it
         can actually be driven — no-JS keeps all content visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- iOS / Android standalone: Add to Home Screen launches chrome-free -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Wawa" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preload the one brand face so text settles on PolySans without a
         flash of the system fallback; @font-face in global.css picks it up. -->
    <link
      rel="preload"
      href="/fonts/PolySans-Neutral.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav current={current} overlay={overlay} />
    <main id="main">
      <slot />
      <FooterNav />
      <div id="footer-sentinel" aria-hidden="true"></div>
    </main>
    <Footer />
    <Cart />
    <Motion />
  </body>
</html>
